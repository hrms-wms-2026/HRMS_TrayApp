{
  "Agent": {
    "HeartbeatIntervalSeconds": 30,
    "PolicyRefreshIntervalSeconds": 3600,
    "IngestIntervalSeconds": 150,
    "QueueCapacityMb": 100,
    "HttpTimeoutSeconds": 30,
    "MaxReconnectAttempts": 5,
    "ApiBaseUrl": "https://localhost:7229",
    "PortalRootDomain": "localhost",
    "PortalProductionPort": 443,
    "PortalDevelopmentPorts": [4200],
    "PortalDevelopmentOrigins": ["https://localhost:4200", "https://acme.localhost:4200"],
    "ForceMonitoringActive": false
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  }
}
