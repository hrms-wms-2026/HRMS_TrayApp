<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <!--
    The MAUI TrayApp cannot be referenced from a test project, so its UI-free sources
    (IPC client, collectors, interop, privacy helpers) are compiled in directly.
  -->
  <ItemGroup>
    <Compile Include="..\..\ONEVO.Agent.TrayApp\GlobalUsings.cs" Link="TrayApp\GlobalUsings.cs" />
    <Compile Include="..\..\ONEVO.Agent.TrayApp\Services\NamedPipeClient.cs" Link="TrayApp\Services\NamedPipeClient.cs" />
    <Compile Include="..\..\ONEVO.Agent.TrayApp\Collectors\*.cs" Link="TrayApp\Collectors\%(Filename)%(Extension)" />
    <Compile Include="..\..\ONEVO.Agent.TrayApp\Interop\*.cs" Link="TrayApp\Interop\%(Filename)%(Extension)" />
    <Compile Include="..\..\ONEVO.Agent.TrayApp\Security\*.cs" Link="TrayApp\Security\%(Filename)%(Extension)" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers</IncludeAssets>
    </PackageReference>
    <PackageReference Include="coverlet.collector">
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\ONEVO.Agent.Shared\ONEVO.Agent.Shared.csproj" />
  </ItemGroup>
</Project>
