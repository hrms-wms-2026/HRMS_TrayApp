<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ONEVO.Agent.TrayApp.Controls.PopupInfoRow"
             x:Name="Root">
  <VerticalStackLayout Spacing="0">
    <Grid ColumnDefinitions="32,*" ColumnSpacing="10" Padding="0,11">
      <Image Source="{Binding Source={x:Reference Root}, Path=IconImage}"
             WidthRequest="28" HeightRequest="28"
             HorizontalOptions="Center"
             VerticalOptions="Center"
             Aspect="AspectFit"
             IsVisible="{Binding Source={x:Reference Root}, Path=IconImage, Converter={StaticResource IsNotNullConverter}}" />
      <Label Text="{Binding Source={x:Reference Root}, Path=Icon}"
             FontFamily="Segoe MDL2 Assets"
             FontSize="16"
             TextColor="{StaticResource Primary}"
             HorizontalOptions="Center"
             VerticalOptions="Center"
             IsVisible="{Binding Source={x:Reference Root}, Path=HasIconImage, Converter={StaticResource InvertBoolConverter}}" />
      <Label x:Name="TextLabel"
             Grid.Column="1"
             Style="{StaticResource ListItem}"
             LineBreakMode="WordWrap"
             MaxLines="2"
             VerticalOptions="Center" />
    </Grid>
    <BoxView HeightRequest="1"
             Color="{StaticResource Separator}"
             Opacity="0.85"
             IsVisible="{Binding Source={x:Reference Root}, Path=ShowDivider}" />
  </VerticalStackLayout>
</ContentView>
