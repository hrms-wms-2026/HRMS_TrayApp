<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ONEVO.Agent.TrayApp.Controls.ReviewDetailRow"
             x:Name="Root">
  <VerticalStackLayout Spacing="0">
    <Grid ColumnDefinitions="32,Auto,*" ColumnSpacing="12" Padding="4,14">
      <Border Style="{StaticResource IconTile}"
              StrokeShape="RoundRectangle 16"
              WidthRequest="32"
              HeightRequest="32"
              VerticalOptions="Center">
        <Label Text="{Binding Source={x:Reference Root}, Path=Icon}"
               FontFamily="Segoe MDL2 Assets"
               FontSize="14"
               TextColor="{StaticResource BrandTitle}"
               HorizontalOptions="Center"
               VerticalOptions="Center" />
      </Border>
      <Label Grid.Column="1"
             Text="{Binding Source={x:Reference Root}, Path=LabelText}"
             Style="{StaticResource FieldLabel}"
             VerticalOptions="Center"
             LineBreakMode="NoWrap"
             MaxLines="1" />
      <Label Grid.Column="2"
             Text="{Binding Source={x:Reference Root}, Path=Value}"
             Style="{StaticResource FieldValue}"
             HorizontalOptions="Fill"
             HorizontalTextAlignment="End"
             VerticalOptions="Center"
             LineBreakMode="TailTruncation"
             MaxLines="1" />
    </Grid>
    <BoxView HeightRequest="1"
             Color="{StaticResource Separator}"
             IsVisible="{Binding Source={x:Reference Root}, Path=ShowDivider}" />
  </VerticalStackLayout>
</ContentView>
