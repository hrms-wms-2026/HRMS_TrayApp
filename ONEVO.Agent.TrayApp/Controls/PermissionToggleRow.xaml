<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ONEVO.Agent.TrayApp.Controls.PermissionToggleRow"
             x:Name="Root">
  <VerticalStackLayout Spacing="0">
    <Grid ColumnDefinitions="40,*,Auto" ColumnSpacing="14" Padding="2,14">
      <Border Style="{StaticResource IconTile}"
              StrokeShape="RoundRectangle 12"
              WidthRequest="40"
              HeightRequest="40"
              BackgroundColor="{StaticResource PrimarySoft}"
              VerticalOptions="Center">
        <Image Source="{Binding Source={x:Reference Root}, Path=IconSource}"
               WidthRequest="18"
               HeightRequest="18"
               HorizontalOptions="Center"
               VerticalOptions="Center" />
      </Border>
      <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
        <Label Text="{Binding Source={x:Reference Root}, Path=Title}"
               FontAttributes="Bold"
               FontSize="15"
               TextColor="{StaticResource TextPrimary}"
               LineBreakMode="NoWrap"
               MaxLines="1" />
        <Label Text="{Binding Source={x:Reference Root}, Path=Description}"
               FontSize="13"
               TextColor="{StaticResource TextSecondary}"
               LineBreakMode="TailTruncation"
               MaxLines="1" />
      </VerticalStackLayout>
      <Switch Grid.Column="2"
              IsToggled="{Binding Source={x:Reference Root}, Path=IsToggled}"
              OnColor="{StaticResource Primary}"
              ThumbColor="White"
              VerticalOptions="Center" />
    </Grid>
    <BoxView HeightRequest="1"
             Color="{StaticResource Separator}"
             IsVisible="{Binding Source={x:Reference Root}, Path=ShowDivider}" />
  </VerticalStackLayout>
</ContentView>
