<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ONEVO.Agent.TrayApp.Controls.SetupProgressRing"
             x:Name="Root">
  <Grid>
    <GraphicsView x:Name="Canvas" InputTransparent="True" />

    <VerticalStackLayout HorizontalOptions="Center" VerticalOptions="Center" Spacing="2">
      <Label Text="{Binding Source={x:Reference Root}, Path=Progress, StringFormat='{0:0}%'}"
             FontSize="28"
             FontAttributes="Bold"
             TextColor="{StaticResource TextPrimary}"
             HorizontalOptions="Center"
             IsVisible="{Binding Source={x:Reference Root}, Path=ShowPercentLabel}" />

      <Label Text="{StaticResource IconCheck}"
             FontFamily="Segoe MDL2 Assets"
             FontSize="32"
             TextColor="{StaticResource StatusGreen}"
             HorizontalOptions="Center"
             IsVisible="{Binding Source={x:Reference Root}, Path=ShowCheck}" />

      <HorizontalStackLayout Spacing="6"
                             HorizontalOptions="Center"
                             IsVisible="{Binding Source={x:Reference Root}, Path=ShowCompletedCaption}">
        <Label Text="{StaticResource IconCheck}"
               FontFamily="Segoe MDL2 Assets"
               FontSize="12"
               TextColor="{StaticResource StatusGreen}"
               VerticalOptions="Center" />
        <Label Text="Completed"
               FontSize="11"
               TextColor="{StaticResource StatusGreen}"
               VerticalOptions="Center" />
      </HorizontalStackLayout>
    </VerticalStackLayout>
  </Grid>
</ContentView>
