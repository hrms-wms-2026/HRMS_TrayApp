<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ONEVO.Agent.TrayApp.Controls.FooterStatusBar"
             x:Name="Root">
  <Grid ColumnDefinitions="Auto,*,Auto" Padding="0,4,0,0">
    <HorizontalStackLayout Grid.Column="0" Spacing="6" VerticalOptions="Center">
      <Label Text="{StaticResource IconInfo}" FontFamily="Segoe MDL2 Assets"
             FontSize="13" TextColor="{StaticResource TextMuted}" VerticalOptions="Center" />
      <Label Text="{Binding Source={x:Reference Root}, Path=VersionText}"
             Style="{StaticResource FooterLabel}"
             LineBreakMode="TailTruncation" MaxLines="1" />
      <Label Text="Sign out"
             FontSize="13"
             TextDecorations="Underline"
             TextColor="{StaticResource Primary}"
             VerticalOptions="Center"
             IsVisible="{Binding Source={x:Reference Root}, Path=ShowSignOut}">
        <Label.GestureRecognizers>
          <TapGestureRecognizer Command="{Binding Source={x:Reference Root}, Path=SignOutCommand}" />
        </Label.GestureRecognizers>
      </Label>
    </HorizontalStackLayout>

    <HorizontalStackLayout Grid.Column="2" Spacing="6" VerticalOptions="Center">
      <Ellipse WidthRequest="8" HeightRequest="8" VerticalOptions="Center">
        <Ellipse.Fill>
          <SolidColorBrush Color="{StaticResource StatusGreen}" />
        </Ellipse.Fill>
        <Ellipse.Triggers>
          <DataTrigger TargetType="Ellipse"
                       Binding="{Binding Source={x:Reference Root}, Path=IsConnected}"
                       Value="False">
            <Setter Property="Fill" Value="{StaticResource StatusRed}" />
          </DataTrigger>
        </Ellipse.Triggers>
      </Ellipse>
      <Label Text="{Binding Source={x:Reference Root}, Path=ConnectionLabel}"
             FontSize="13"
             TextColor="{StaticResource TextSecondary}"
             VerticalOptions="Center"
             LineBreakMode="TailTruncation" MaxLines="1" />
    </HorizontalStackLayout>
  </Grid>
</ContentView>
