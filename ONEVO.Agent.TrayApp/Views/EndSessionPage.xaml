<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:ONEVO.Agent.TrayApp.ViewModels"
             x:Class="ONEVO.Agent.TrayApp.Views.EndSessionPage"
             x:DataType="vm:EndSessionViewModel"
             BackgroundColor="{StaticResource Background}">

  <ScrollView>
    <Grid RowDefinitions="Auto,*,Auto" Padding="24,16">

      <!-- Header -->
      <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto" Margin="0,0,0,16">
        <HorizontalStackLayout Grid.Column="0" Spacing="10">
          <Border WidthRequest="32" HeightRequest="32"
                  StrokeShape="RoundRectangle 8" StrokeThickness="0">
            <Border.Background>
              <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="{StaticResource PrimaryGradientStart}" Offset="0" />
                <GradientStop Color="{StaticResource PrimaryGradientEnd}" Offset="1" />
              </LinearGradientBrush>
            </Border.Background>
            <Label Text="OV" FontSize="12" FontAttributes="Bold" TextColor="White"
                   HorizontalOptions="Center" VerticalOptions="Center" />
          </Border>
          <VerticalStackLayout VerticalOptions="Center">
            <Label Text="OneVo Workspace" FontSize="13" FontAttributes="Bold"
                   TextColor="{StaticResource TextPrimary}" />
            <Label Text="Your Workplace. Simplified."
                   FontSize="10" TextColor="{StaticResource TextSecondary}" />
          </VerticalStackLayout>
        </HorizontalStackLayout>
      </Grid>

      <VerticalStackLayout Grid.Row="1" Spacing="16">

        <Label Text="Workday Completed 🎉"
               FontSize="24" FontAttributes="Bold"
               TextColor="{StaticResource TextPrimary}"
               HorizontalOptions="Center" />
        <Label Text="{Binding Message}"
               FontSize="13" TextColor="{StaticResource TextSecondary}"
               HorizontalOptions="Center"
               HorizontalTextAlignment="Center" />

        <!-- Top status cards -->
        <Grid ColumnDefinitions="*,*,*" ColumnSpacing="10">
          <Border Grid.Column="0" Style="{StaticResource Card}" Padding="12">
            <VerticalStackLayout Spacing="4" HorizontalOptions="Center">
              <Label Text="Status" FontSize="10" TextColor="{StaticResource TextSecondary}"
                     HorizontalOptions="Center" />
              <Label Text="{Binding StatusText}" FontSize="14" FontAttributes="Bold"
                     TextColor="{StaticResource Primary}" HorizontalOptions="Center" />
            </VerticalStackLayout>
          </Border>
          <Border Grid.Column="1" Style="{StaticResource Card}" Padding="12">
            <VerticalStackLayout Spacing="4" HorizontalOptions="Center">
              <Label Text="Clock Out Time" FontSize="10" TextColor="{StaticResource TextSecondary}"
                     HorizontalOptions="Center" />
              <Label Text="{Binding ClockOutDisplay}" FontSize="14" FontAttributes="Bold"
                     TextColor="{StaticResource TextPrimary}" HorizontalOptions="Center" />
            </VerticalStackLayout>
          </Border>
          <Border Grid.Column="2" Style="{StaticResource Card}" Padding="12">
            <VerticalStackLayout Spacing="4" HorizontalOptions="Center">
              <Label Text="Total Shift" FontSize="10" TextColor="{StaticResource TextSecondary}"
                     HorizontalOptions="Center" />
              <Label Text="{Binding TotalShiftDisplay}" FontSize="14" FontAttributes="Bold"
                     TextColor="{StaticResource TextPrimary}" HorizontalOptions="Center" />
            </VerticalStackLayout>
          </Border>
        </Grid>

        <!-- Detail metrics -->
        <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="8">
          <Border Grid.Column="0" Style="{StaticResource Card}" Padding="10">
            <VerticalStackLayout Spacing="2">
              <Label Text="Clock In" FontSize="10" TextColor="{StaticResource TextSecondary}" />
              <Label Text="{Binding ClockInDisplay}" FontSize="13" FontAttributes="Bold"
                     TextColor="{StaticResource TextPrimary}" />
            </VerticalStackLayout>
          </Border>
          <Border Grid.Column="1" Style="{StaticResource Card}" Padding="10">
            <VerticalStackLayout Spacing="2">
              <Label Text="Clock Out" FontSize="10" TextColor="{StaticResource TextSecondary}" />
              <Label Text="{Binding ClockOutDisplay}" FontSize="13" FontAttributes="Bold"
                     TextColor="{StaticResource TextPrimary}" />
            </VerticalStackLayout>
          </Border>
          <Border Grid.Column="2" Style="{StaticResource Card}" Padding="10">
            <VerticalStackLayout Spacing="2">
              <Label Text="Work Duration" FontSize="10" TextColor="{StaticResource TextSecondary}" />
              <Label Text="{Binding WorkingTimeDisplay}" FontSize="13" FontAttributes="Bold"
                     TextColor="{StaticResource StatusGreen}" />
            </VerticalStackLayout>
          </Border>
          <Border Grid.Column="3" Style="{StaticResource Card}" Padding="10">
            <VerticalStackLayout Spacing="2">
              <Label Text="Break Time" FontSize="10" TextColor="{StaticResource TextSecondary}" />
              <Label Text="{Binding BreakTimeDisplay}" FontSize="13" FontAttributes="Bold"
                     TextColor="{StaticResource StatusOrange}" />
            </VerticalStackLayout>
          </Border>
        </Grid>

        <!-- Secondary metrics -->
        <Grid ColumnDefinitions="*,*,*" ColumnSpacing="8">
          <Border Grid.Column="0" Style="{StaticResource Card}" Padding="12">
            <VerticalStackLayout Spacing="2" HorizontalOptions="Center">
              <Label Text="Productive Time" FontSize="10" TextColor="{StaticResource TextSecondary}"
                     HorizontalOptions="Center" />
              <Label Text="{Binding ProductiveTimeDisplay}" FontSize="16" FontAttributes="Bold"
                     TextColor="{StaticResource Primary}" HorizontalOptions="Center" />
            </VerticalStackLayout>
          </Border>
          <Border Grid.Column="1" Style="{StaticResource Card}" Padding="12">
            <VerticalStackLayout Spacing="2" HorizontalOptions="Center">
              <Label Text="Idle Time" FontSize="10" TextColor="{StaticResource TextSecondary}"
                     HorizontalOptions="Center" />
              <Label Text="{Binding IdleTimeDisplay}" FontSize="16" FontAttributes="Bold"
                     TextColor="{StaticResource TextPrimary}" HorizontalOptions="Center" />
            </VerticalStackLayout>
          </Border>
          <Border Grid.Column="2" Style="{StaticResource Card}" Padding="12">
            <VerticalStackLayout Spacing="2" HorizontalOptions="Center">
              <Label Text="Break Sessions" FontSize="10" TextColor="{StaticResource TextSecondary}"
                     HorizontalOptions="Center" />
              <Label Text="{Binding BreakSessionsDisplay}" FontSize="16" FontAttributes="Bold"
                     TextColor="{StaticResource StatusOrange}" HorizontalOptions="Center" />
            </VerticalStackLayout>
          </Border>
        </Grid>

        <Border Style="{StaticResource Card}" Padding="14">
          <VerticalStackLayout Spacing="6">
            <Label Text="Top Applications Used Today" FontSize="12" FontAttributes="Bold"
                   TextColor="{StaticResource TextPrimary}" />
            <Label Text="No application usage data available yet for this session."
                   FontSize="11" TextColor="{StaticResource TextSecondary}" />
          </VerticalStackLayout>
        </Border>

        <Label Text="{Binding ErrorMessage}" TextColor="{StaticResource StatusRed}"
               FontSize="12"
               IsVisible="{Binding ErrorMessage, Converter={StaticResource IsNotNullConverter}}" />

        <!-- Actions -->
        <Grid ColumnDefinitions="*,*,*" ColumnSpacing="10" Margin="0,4,0,0">
          <Button Grid.Column="0" Text="📊  View Dashboard"
                  Command="{Binding OpenDashboardCommand}"
                  Style="{StaticResource OutlineButton}"
                  HeightRequest="48" FontSize="13" />
          <Button Grid.Column="1" Text="⬇  Download Summary"
                  Command="{Binding DownloadSummaryCommand}"
                  BackgroundColor="{StaticResource StatusOrange}"
                  TextColor="White" FontAttributes="Bold"
                  CornerRadius="24" HeightRequest="48" FontSize="13" />
          <Button Grid.Column="2" Text="Close App"
                  Command="{Binding CloseAppCommand}"
                  BackgroundColor="{StaticResource StatusRed}"
                  TextColor="White" FontAttributes="Bold"
                  CornerRadius="24" HeightRequest="48" FontSize="13" />
        </Grid>
      </VerticalStackLayout>

      <!-- Footer -->
      <Grid Grid.Row="2" ColumnDefinitions="Auto,*,Auto" Padding="0,16,0,0">
        <Label Grid.Column="0" Text="Settings" FontSize="11"
               TextColor="{StaticResource TextMuted}" />
        <Label Grid.Column="1" Text="Version 1.0.0" FontSize="11"
               TextColor="{StaticResource TextMuted}" HorizontalOptions="Center" />
        <HorizontalStackLayout Grid.Column="2" Spacing="6">
          <Ellipse WidthRequest="8" HeightRequest="8"
                   Fill="{StaticResource StatusGreen}" VerticalOptions="Center" />
          <Label Text="Connected to OneVo Server" FontSize="11"
                 TextColor="{StaticResource TextSecondary}" />
        </HorizontalStackLayout>
      </Grid>
    </Grid>
  </ScrollView>
</ContentPage>
