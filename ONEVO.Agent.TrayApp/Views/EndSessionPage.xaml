<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:ONEVO.Agent.TrayApp.ViewModels"
             xmlns:controls="clr-namespace:ONEVO.Agent.TrayApp.Controls"
             x:Class="ONEVO.Agent.TrayApp.Views.EndSessionPage"
             x:DataType="vm:EndSessionViewModel"
             Shell.NavBarIsVisible="False"
             Title="OneXso WorkPulse">

  <Grid RowDefinitions="*,Auto" Padding="28,16,28,12">
    <Grid.Background>
      <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="{StaticResource BackgroundWashStart}" Offset="0" />
        <GradientStop Color="{StaticResource BackgroundWashMid}" Offset="0.45" />
        <GradientStop Color="{StaticResource BackgroundWashEnd}" Offset="1" />
      </LinearGradientBrush>
    </Grid.Background>

    <Grid x:Name="PaneGrid" Grid.Row="0" ColumnDefinitions="0.95*,1.05*" ColumnSpacing="24">
      <Border x:Name="LeftPane" Grid.Column="0"
              StrokeShape="RoundRectangle 24" StrokeThickness="0"
              VerticalOptions="Fill" HorizontalOptions="Fill">
        <Image Source="end_session_hero.png"
               Aspect="AspectFit"
               HorizontalOptions="Fill"
               VerticalOptions="Fill"
               Margin="4,8" />
      </Border>

      <VerticalStackLayout x:Name="RightPane" Grid.Column="1" VerticalOptions="Center" Spacing="10">
        <Label>
          <Label.FormattedText>
            <FormattedString>
              <Span Text="Workday " FontSize="26" FontAttributes="Bold" TextColor="{StaticResource TextPrimary}" />
              <Span Text="Completed" FontSize="26" FontAttributes="Bold" TextColor="{StaticResource BrandTitle}" />
            </FormattedString>
          </Label.FormattedText>
        </Label>
        <Label Text="{Binding GreetingMessage}" Style="{StaticResource PageSubtitle}" HorizontalTextAlignment="Start" />

        <Border Style="{StaticResource TrayCompactGlassCard}" Padding="16,12">
          <VerticalStackLayout Spacing="12">
            <Grid ColumnDefinitions="36,*" ColumnSpacing="10">
              <Border Style="{StaticResource IconTileCircle}" BackgroundColor="#DCFCE7">
                <Label Text="{StaticResource IconCheck}" FontFamily="Segoe MDL2 Assets" FontSize="14" TextColor="{StaticResource StatusGreen}" HorizontalOptions="Center" VerticalOptions="Center" />
              </Border>
              <VerticalStackLayout Grid.Column="1">
                <Label Text="You've Clocked Out Successfully" FontAttributes="Bold" FontSize="14" TextColor="{StaticResource TextPrimary}" />
                <Label Text="{Binding SessionEndedCaption}" FontSize="14" TextColor="{StaticResource TextSecondary}" />
              </VerticalStackLayout>
            </Grid>
            <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="4">
              <Grid Grid.Column="0" RowDefinitions="Auto,32,Auto,Auto" RowSpacing="2">
                <Border Style="{StaticResource IconTileCircle}" HorizontalOptions="Center">
                  <Label Text="{StaticResource IconClock}" FontFamily="Segoe MDL2 Assets" FontSize="14" TextColor="{StaticResource Primary}" HorizontalOptions="Center" VerticalOptions="Center" />
                </Border>
                <Label Grid.Row="1" Text="Total Shift" Style="{StaticResource EndSessionMetricLabel}" />
                <Label Grid.Row="2" Text="{Binding TotalShiftDisplay}" Style="{StaticResource EndSessionMetricValue}" />
                <Label Grid.Row="3" Text="Hrs" Style="{StaticResource DeltaNeutral}" HorizontalOptions="Center" HorizontalTextAlignment="Center" />
              </Grid>
              <Grid Grid.Column="1" RowDefinitions="Auto,32,Auto,Auto" RowSpacing="2">
                <Border Style="{StaticResource IconTileCircle}" BackgroundColor="#DCFCE7" HorizontalOptions="Center">
                  <Label Text="{StaticResource IconWork}" FontFamily="Segoe MDL2 Assets" FontSize="14" TextColor="{StaticResource StatusGreen}" HorizontalOptions="Center" VerticalOptions="Center" />
                </Border>
                <Label Grid.Row="1" Text="Total Work Duration" Style="{StaticResource EndSessionMetricLabel}" />
                <Label Grid.Row="2" Text="{Binding WorkingTimeDisplay}" Style="{StaticResource EndSessionMetricValue}" />
                <Label Grid.Row="3" Text="Hrs" Style="{StaticResource DeltaNeutral}" HorizontalOptions="Center" HorizontalTextAlignment="Center" />
              </Grid>
              <Grid Grid.Column="2" RowDefinitions="Auto,32,Auto,Auto" RowSpacing="2">
                <Border Style="{StaticResource IconTileCircle}" BackgroundColor="{StaticResource AccentSoft}" HorizontalOptions="Center">
                  <Label Text="{StaticResource IconCafe}" FontFamily="Segoe MDL2 Assets" FontSize="14" TextColor="{StaticResource BrandTitle}" HorizontalOptions="Center" VerticalOptions="Center" />
                </Border>
                <Label Grid.Row="1" Text="Total Break Time" Style="{StaticResource EndSessionMetricLabel}" />
                <Label Grid.Row="2" Text="{Binding BreakTimeDisplay}" Style="{StaticResource EndSessionMetricValue}" />
                <Label Grid.Row="3" Text="Hrs" Style="{StaticResource DeltaNeutral}" HorizontalOptions="Center" HorizontalTextAlignment="Center" />
              </Grid>
              <Grid Grid.Column="3" RowDefinitions="Auto,32,Auto,Auto" RowSpacing="2">
                <Border Style="{StaticResource IconTileCircle}" HorizontalOptions="Center">
                  <Label Text="{StaticResource IconChart}" FontFamily="Segoe MDL2 Assets" FontSize="14" TextColor="{StaticResource Primary}" HorizontalOptions="Center" VerticalOptions="Center" />
                </Border>
                <Label Grid.Row="1" Text="Productive Time" Style="{StaticResource EndSessionMetricLabel}" />
                <Label Grid.Row="2" Text="{Binding ProductiveTimeDisplay}" Style="{StaticResource EndSessionMetricValue}" />
                <Label Grid.Row="3" Text="Hrs" Style="{StaticResource DeltaNeutral}" HorizontalOptions="Center" HorizontalTextAlignment="Center" />
              </Grid>
            </Grid>
          </VerticalStackLayout>
        </Border>

        <Border Style="{StaticResource TrayCompactGlassCard}" Padding="14,10">
          <Grid ColumnDefinitions="36,*,Auto" ColumnSpacing="10">
            <Border Style="{StaticResource IconTileCircle}" BackgroundColor="#DCFCE7">
              <Label Text="{StaticResource IconCheck}" FontFamily="Segoe MDL2 Assets" FontSize="14" TextColor="{StaticResource StatusGreen}" HorizontalOptions="Center" VerticalOptions="Center" />
            </Border>
            <VerticalStackLayout Grid.Column="1">
              <Label Text="Your work data has been securely saved." FontAttributes="Bold" FontSize="13" TextColor="{StaticResource TextPrimary}" />
              <Label Text="All logs, activity, and timesheets are recorded." FontSize="14" TextColor="{StaticResource TextSecondary}" />
            </VerticalStackLayout>
            <Label Grid.Column="2" Text="{Binding SavedAtDisplay}" FontSize="13" TextColor="{StaticResource TextMuted}" VerticalOptions="Center" />
          </Grid>
        </Border>

        <Border Style="{StaticResource TrayCompactGlassCard}" Padding="14,10">
          <Grid ColumnDefinitions="36,*,Auto" ColumnSpacing="10">
            <Border Style="{StaticResource IconTileCircle}" BackgroundColor="{StaticResource PrimarySoft}">
              <Label Text="{StaticResource IconCloud}" FontFamily="Segoe MDL2 Assets" FontSize="14" TextColor="{StaticResource Primary}" HorizontalOptions="Center" VerticalOptions="Center" />
            </Border>
            <VerticalStackLayout Grid.Column="1">
              <Label Text="Synced to OneXso Cloud" FontAttributes="Bold" FontSize="13" TextColor="{StaticResource TextPrimary}" />
              <Label Text="Your data is backed up and available across your devices." FontSize="14" TextColor="{StaticResource TextSecondary}" />
            </VerticalStackLayout>
            <Label Grid.Column="2" Text="{Binding SavedAtDisplay}" FontSize="13" TextColor="{StaticResource TextMuted}" VerticalOptions="Center" />
          </Grid>
        </Border>

        <Border Style="{StaticResource TrayCompactGlassCard}" Padding="14,10">
          <Grid ColumnDefinitions="36,*" ColumnSpacing="10">
            <Border Style="{StaticResource IconTileCircle}" BackgroundColor="{StaticResource AccentSoft}">
              <Label Text="{StaticResource IconShield}" FontFamily="Segoe MDL2 Assets" FontSize="14" TextColor="{StaticResource BrandTitle}" HorizontalOptions="Center" VerticalOptions="Center" />
            </Border>
            <VerticalStackLayout Grid.Column="1">
              <Label Text="Thank you for your focus and commitment today." FontAttributes="Bold" FontSize="13" TextColor="{StaticResource TextPrimary}" />
              <Label Text="Consistency builds success. See you tomorrow!" FontSize="14" TextColor="{StaticResource TextSecondary}" />
            </VerticalStackLayout>
          </Grid>
        </Border>

        <Grid ColumnDefinitions="*,*,*" ColumnSpacing="8">
          <Border Grid.Column="0" Style="{StaticResource TrayPrimaryActionBorder}" StrokeShape="RoundRectangle 16" HeightRequest="44">
            <Grid>
              <Button Command="{Binding OpenDashboardCommand}" Style="{StaticResource TrayPrimaryActionOverlay}" HeightRequest="44" Text="" SemanticProperties.Description="View Dashboard" />
              <HorizontalStackLayout InputTransparent="True" HorizontalOptions="Center" VerticalOptions="Center" Spacing="6">
                <Label Text="{StaticResource IconGlobe}" FontFamily="Segoe MDL2 Assets" FontSize="13" TextColor="White" VerticalOptions="Center" />
                <Label Text="View Dashboard" FontSize="13" FontAttributes="Bold" TextColor="White" LineBreakMode="NoWrap" MaxLines="1" />
              </HorizontalStackLayout>
            </Grid>
          </Border>
          <Border Grid.Column="1" Style="{StaticResource TraySecondaryActionBorder}" StrokeShape="RoundRectangle 16" HeightRequest="44">
            <Grid>
              <Button Command="{Binding ViewSummaryCommand}" Style="{StaticResource TrayPrimaryActionOverlay}" HeightRequest="44" Text="" SemanticProperties.Description="View Summary" />
              <HorizontalStackLayout InputTransparent="True" HorizontalOptions="Center" VerticalOptions="Center" Spacing="6">
                <Label Text="{StaticResource IconChart}" FontFamily="Segoe MDL2 Assets" FontSize="13" TextColor="{StaticResource Primary}" VerticalOptions="Center" />
                <Label Text="View Summary" FontSize="13" FontAttributes="Bold" TextColor="{StaticResource Primary}" LineBreakMode="NoWrap" MaxLines="1" />
              </HorizontalStackLayout>
            </Grid>
          </Border>
          <Border Grid.Column="2" Style="{StaticResource TraySecondaryActionBorder}" StrokeShape="RoundRectangle 16" HeightRequest="44">
            <Grid>
              <Button Command="{Binding BackCommand}" Style="{StaticResource TrayPrimaryActionOverlay}" HeightRequest="44" Text="" SemanticProperties.Description="Back" />
              <Label InputTransparent="True" Text="Back" FontSize="13" FontAttributes="Bold"
                     TextColor="{StaticResource Primary}" HorizontalOptions="Center" VerticalOptions="Center"
                     LineBreakMode="NoWrap" MaxLines="1" />
            </Grid>
          </Border>
        </Grid>

        <Label Text="{Binding Message}" FontSize="14" TextColor="{StaticResource StatusGreen}"
               IsVisible="{Binding Message, Converter={StaticResource IsNotNullConverter}}" />
        <Label Text="{Binding ErrorMessage}" TextColor="{StaticResource StatusRed}" FontSize="14"
               IsVisible="{Binding ErrorMessage, Converter={StaticResource IsNotNullConverter}}" />
      </VerticalStackLayout>
    </Grid>

    <controls:FooterStatusBar Grid.Row="1" VersionText="Version 1.0.0" ConnectionLabel="Connected" IsConnected="True" />
  </Grid>
</ContentPage>
