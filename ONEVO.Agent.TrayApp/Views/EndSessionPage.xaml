<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:ONEVO.Agent.TrayApp.ViewModels"
             xmlns:controls="clr-namespace:ONEVO.Agent.TrayApp.Controls"
             x:Class="ONEVO.Agent.TrayApp.Views.EndSessionPage"
             x:DataType="vm:EndSessionViewModel"
             BackgroundColor="{StaticResource Background}">

  <Grid RowDefinitions="Auto,*,Auto" Padding="24,16">
    <controls:AppHeaderBar Grid.Row="0" />

    <ScrollView Grid.Row="1">
      <VerticalStackLayout Spacing="14">

        <Grid x:Name="PaneGrid" ColumnDefinitions="0.9*,1.1*" ColumnSpacing="20">
          <Border x:Name="LeftPane" Grid.Column="0" Style="{StaticResource GlassCard}" Padding="16"
                  BackgroundColor="{StaticResource IllustrationTint}" StrokeThickness="0"
                  MinimumWidthRequest="0">
            <VerticalStackLayout VerticalOptions="Center" Spacing="10">
              <Label Text="💻" FontSize="72" HorizontalOptions="Center" />
              <Border WidthRequest="40" HeightRequest="40" StrokeShape="RoundRectangle 20"
                      StrokeThickness="0" BackgroundColor="{StaticResource StatusGreen}"
                      HorizontalOptions="Center">
                <Label Text="{StaticResource IconCheck}" FontFamily="Segoe MDL2 Assets"
                       FontSize="18" TextColor="White"
                       HorizontalOptions="Center" VerticalOptions="Center" />
              </Border>
              <Label Text="Onexso Workspace" FontSize="12" FontAttributes="Bold"
                     TextColor="{StaticResource Primary}" HorizontalOptions="Center" />
            </VerticalStackLayout>
          </Border>

          <VerticalStackLayout x:Name="RightPane" Grid.Column="1" Spacing="12">
            <HorizontalStackLayout Spacing="4">
              <Label Text="Workday " Style="{StaticResource PageTitle}" FontSize="24" />
              <Label Text="Completed" Style="{StaticResource PageTitleAccent}" FontSize="24" />
              <Label Text=" 🎉" FontSize="22" VerticalOptions="Center" />
            </HorizontalStackLayout>
            <Label Text="{Binding Message}"
                   FontSize="13" TextColor="{StaticResource TextSecondary}" />

            <!-- Top: Status | Total Shift | Break Sessions (no duplicate Clock Out) -->
            <Grid ColumnDefinitions="*,*,*" ColumnSpacing="10">
              <Border Grid.Column="0" Style="{StaticResource GlassCard}" Padding="12">
                <VerticalStackLayout Spacing="4">
                  <Label Text="Status" FontSize="10" TextColor="{StaticResource TextSecondary}" />
                  <Label Text="{Binding StatusText}" FontSize="14" FontAttributes="Bold"
                         TextColor="{StaticResource Primary}" />
                </VerticalStackLayout>
              </Border>
              <Border Grid.Column="1" Style="{StaticResource GlassCard}" Padding="12">
                <VerticalStackLayout Spacing="4">
                  <Label Text="Total Shift" FontSize="10" TextColor="{StaticResource TextSecondary}" />
                  <Label Text="{Binding TotalShiftDisplay}" FontSize="14" FontAttributes="Bold"
                         TextColor="{StaticResource TextPrimary}" />
                </VerticalStackLayout>
              </Border>
              <Border Grid.Column="2" Style="{StaticResource GlassCard}" Padding="12">
                <VerticalStackLayout Spacing="4">
                  <Label Text="Break Sessions" FontSize="10" TextColor="{StaticResource TextSecondary}" />
                  <Label Text="{Binding BreakSessionsDisplay}" FontSize="14" FontAttributes="Bold"
                         TextColor="{StaticResource StatusOrange}" />
                </VerticalStackLayout>
              </Border>
            </Grid>

            <!-- Detail times once each -->
            <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="8">
              <Border Grid.Column="0" Style="{StaticResource GlassCard}" Padding="10">
                <VerticalStackLayout Spacing="2">
                  <Label Text="Clock In Time" FontSize="10" TextColor="{StaticResource TextSecondary}" />
                  <Label Text="{Binding ClockInDisplay}" FontSize="13" FontAttributes="Bold"
                         TextColor="{StaticResource StatusBlue}" />
                </VerticalStackLayout>
              </Border>
              <Border Grid.Column="1" Style="{StaticResource GlassCard}" Padding="10">
                <VerticalStackLayout Spacing="2">
                  <Label Text="Clock Out Time" FontSize="10" TextColor="{StaticResource TextSecondary}" />
                  <Label Text="{Binding ClockOutDisplay}" FontSize="13" FontAttributes="Bold"
                         TextColor="{StaticResource StatusBlue}" />
                </VerticalStackLayout>
              </Border>
              <Border Grid.Column="2" Style="{StaticResource GlassCard}" Padding="10">
                <VerticalStackLayout Spacing="2">
                  <Label Text="Total Work Duration" FontSize="10" TextColor="{StaticResource TextSecondary}" />
                  <Label Text="{Binding WorkingTimeDisplay}" FontSize="13" FontAttributes="Bold"
                         TextColor="{StaticResource StatusGreen}" />
                </VerticalStackLayout>
              </Border>
              <Border Grid.Column="3" Style="{StaticResource GlassCard}" Padding="10">
                <VerticalStackLayout Spacing="2">
                  <Label Text="Total Break Time" FontSize="10" TextColor="{StaticResource TextSecondary}" />
                  <Label Text="{Binding BreakTimeDisplay}" FontSize="13" FontAttributes="Bold"
                         TextColor="{StaticResource StatusOrange}" />
                </VerticalStackLayout>
              </Border>
            </Grid>

            <Grid ColumnDefinitions="*,*,*" ColumnSpacing="10">
              <Button Grid.Column="0" Text="📊  View Dashboard"
                      Command="{Binding OpenDashboardCommand}"
                      Style="{StaticResource OutlineButton}"
                      HeightRequest="48" FontSize="13" />
              <Button Grid.Column="1" Text="⬇  Download Summary"
                      Command="{Binding DownloadSummaryCommand}"
                      Style="{StaticResource OrangePillButton}" />
              <Button Grid.Column="2" Text="Close App"
                      Command="{Binding CloseAppCommand}"
                      Style="{StaticResource RedPillButton}" />
            </Grid>
          </VerticalStackLayout>
        </Grid>

        <!-- Productive + Idle only (Break Sessions already in top row) -->
        <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
          <Border Grid.Column="0" Style="{StaticResource GlassCard}" Padding="12">
            <VerticalStackLayout Spacing="2" HorizontalOptions="Center">
              <Label Text="Productive Time" FontSize="10" TextColor="{StaticResource TextSecondary}"
                     HorizontalOptions="Center" />
              <Label Text="{Binding ProductiveTimeDisplay}" FontSize="16" FontAttributes="Bold"
                     TextColor="{StaticResource StatusBlue}" HorizontalOptions="Center" />
            </VerticalStackLayout>
          </Border>
          <Border Grid.Column="1" Style="{StaticResource GlassCard}" Padding="12">
            <VerticalStackLayout Spacing="2" HorizontalOptions="Center">
              <Label Text="Idle Time" FontSize="10" TextColor="{StaticResource TextSecondary}"
                     HorizontalOptions="Center" />
              <Label Text="{Binding IdleTimeDisplay}" FontSize="16" FontAttributes="Bold"
                     TextColor="{StaticResource TextPrimary}" HorizontalOptions="Center" />
            </VerticalStackLayout>
          </Border>
        </Grid>

        <Border Style="{StaticResource GlassCard}" Padding="14">
          <VerticalStackLayout Spacing="10">
            <Label Text="Top Applications Used Today" FontSize="12" FontAttributes="Bold"
                   TextColor="{StaticResource TextPrimary}" />
            <CollectionView ItemsSource="{Binding TopApps}"
                            ItemsLayout="HorizontalList"
                            HeightRequest="72">
              <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="vm:TopAppItem">
                  <Border Style="{StaticResource Card}" Margin="0,0,8,0" Padding="12,10" WidthRequest="120">
                    <VerticalStackLayout Spacing="4" HorizontalOptions="Center">
                      <Label Text="{Binding Name}" FontSize="11" FontAttributes="Bold"
                             TextColor="{StaticResource TextPrimary}"
                             HorizontalOptions="Center" LineBreakMode="TailTruncation" />
                      <Label Text="{Binding Duration}" FontSize="12" FontAttributes="Bold"
                             TextColor="{StaticResource Primary}"
                             HorizontalOptions="Center" />
                    </VerticalStackLayout>
                  </Border>
                </DataTemplate>
              </CollectionView.ItemTemplate>
            </CollectionView>
          </VerticalStackLayout>
        </Border>

        <Label Text="{Binding ErrorMessage}" TextColor="{StaticResource StatusRed}"
               FontSize="12"
               IsVisible="{Binding ErrorMessage, Converter={StaticResource IsNotNullConverter}}" />
      </VerticalStackLayout>
    </ScrollView>

    <Grid Grid.Row="2" ColumnDefinitions="Auto,*" Padding="0,8,0,0">
      <HorizontalStackLayout Grid.Column="0" Spacing="6" VerticalOptions="Center">
        <Label Text="{StaticResource IconSettings}" FontFamily="Segoe MDL2 Assets"
               FontSize="12" TextColor="{StaticResource TextMuted}" VerticalOptions="Center" />
        <Label Text="Settings" Style="{StaticResource FooterLabel}" />
      </HorizontalStackLayout>
      <controls:FooterStatusBar Grid.Column="1"
                                ConnectionLabel="Connected to Onexso Server" />
    </Grid>
  </Grid>
</ContentPage>
