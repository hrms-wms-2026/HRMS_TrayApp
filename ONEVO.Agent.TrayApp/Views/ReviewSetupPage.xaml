<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:ONEVO.Agent.TrayApp.ViewModels"
             xmlns:controls="clr-namespace:ONEVO.Agent.TrayApp.Controls"
             x:Class="ONEVO.Agent.TrayApp.Views.ReviewSetupPage"
             x:DataType="vm:ReviewSetupViewModel"
             Shell.NavBarIsVisible="False"
             Title="OneXso WorkPulse">

  <Grid RowDefinitions="*,Auto" Padding="40,20,40,12">
    <Grid.Background>
      <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="{StaticResource BackgroundWashStart}" Offset="0" />
        <GradientStop Color="#EEF2FF" Offset="0.45" />
        <GradientStop Color="{StaticResource BackgroundWashEnd}" Offset="1" />
      </LinearGradientBrush>
    </Grid.Background>

    <VerticalStackLayout Grid.Row="0" Spacing="0" VerticalOptions="Center"
                         MaximumWidthRequest="640" HorizontalOptions="Center">
      <Label HorizontalOptions="Center" Margin="0,0,0,6">
        <Label.FormattedText>
          <FormattedString>
            <Span Text="Confirm Your " FontSize="26" FontAttributes="Bold" TextColor="{StaticResource TextPrimary}" />
            <Span Text="Details" FontSize="26" FontAttributes="Bold" TextColor="{StaticResource BrandTitle}" />
          </FormattedString>
        </Label.FormattedText>
      </Label>
      <Label Text="Please review your information before continuing."
             Style="{StaticResource PageSubtitle}" Margin="0,0,0,18" />

      <Border Style="{StaticResource TrayCompactGlassCard}" Padding="18,8" Margin="0,0,0,18">
        <VerticalStackLayout Spacing="0">
          <Grid ColumnDefinitions="40,*,Auto" Padding="0,10" ColumnSpacing="12">
            <Border Grid.Column="0" Style="{StaticResource IconTile}" StrokeShape="RoundRectangle 18" WidthRequest="32" HeightRequest="32">
              <Label Text="{StaticResource IconPerson}" FontFamily="Segoe MDL2 Assets" FontSize="14" TextColor="{StaticResource BrandTitle}" HorizontalOptions="Center" VerticalOptions="Center" />
            </Border>
            <Label Grid.Column="1" Text="Full Name" Style="{StaticResource FieldLabel}" />
            <Label Grid.Column="2" Text="{Binding FullName}" Style="{StaticResource FieldValue}" />
          </Grid>
          <BoxView HeightRequest="1" BackgroundColor="{StaticResource Separator}" />
          <Grid ColumnDefinitions="40,*,Auto" Padding="0,10" ColumnSpacing="12">
            <Border Grid.Column="0" Style="{StaticResource IconTile}" StrokeShape="RoundRectangle 18" WidthRequest="32" HeightRequest="32">
              <Label Text="{StaticResource IconMail}" FontFamily="Segoe MDL2 Assets" FontSize="14" TextColor="{StaticResource BrandTitle}" HorizontalOptions="Center" VerticalOptions="Center" />
            </Border>
            <Label Grid.Column="1" Text="Email" Style="{StaticResource FieldLabel}" />
            <Label Grid.Column="2" Text="{Binding WorkEmail}" Style="{StaticResource FieldValue}" />
          </Grid>
          <BoxView HeightRequest="1" BackgroundColor="{StaticResource Separator}" />
          <Grid ColumnDefinitions="40,*,Auto" Padding="0,10" ColumnSpacing="12">
            <Border Grid.Column="0" Style="{StaticResource IconTile}" StrokeShape="RoundRectangle 18" WidthRequest="32" HeightRequest="32">
              <Label Text="{StaticResource IconBadge}" FontFamily="Segoe MDL2 Assets" FontSize="14" TextColor="{StaticResource BrandTitle}" HorizontalOptions="Center" VerticalOptions="Center" />
            </Border>
            <Label Grid.Column="1" Text="Employee ID" Style="{StaticResource FieldLabel}" />
            <Label Grid.Column="2" Text="{Binding EmployeeId}" Style="{StaticResource FieldValue}" />
          </Grid>
          <BoxView HeightRequest="1" BackgroundColor="{StaticResource Separator}" />
          <Grid ColumnDefinitions="40,*,Auto" Padding="0,10" ColumnSpacing="12">
            <Border Grid.Column="0" Style="{StaticResource IconTile}" StrokeShape="RoundRectangle 18" WidthRequest="32" HeightRequest="32">
              <Label Text="{StaticResource IconWork}" FontFamily="Segoe MDL2 Assets" FontSize="14" TextColor="{StaticResource BrandTitle}" HorizontalOptions="Center" VerticalOptions="Center" />
            </Border>
            <Label Grid.Column="1" Text="Department" Style="{StaticResource FieldLabel}" />
            <Label Grid.Column="2" Text="{Binding Department}" Style="{StaticResource FieldValue}" />
          </Grid>
          <BoxView HeightRequest="1" BackgroundColor="{StaticResource Separator}" />
          <Grid ColumnDefinitions="40,*,Auto" Padding="0,10" ColumnSpacing="12">
            <Border Grid.Column="0" Style="{StaticResource IconTile}" StrokeShape="RoundRectangle 18" WidthRequest="32" HeightRequest="32">
              <Label Text="{StaticResource IconLocation}" FontFamily="Segoe MDL2 Assets" FontSize="14" TextColor="{StaticResource BrandTitle}" HorizontalOptions="Center" VerticalOptions="Center" />
            </Border>
            <Label Grid.Column="1" Text="Registered Office" Style="{StaticResource FieldLabel}" />
            <Label Grid.Column="2" Text="{Binding RegisteredOffice}" Style="{StaticResource FieldValue}" />
          </Grid>
          <BoxView HeightRequest="1" BackgroundColor="{StaticResource Separator}" />
          <Grid ColumnDefinitions="40,*,Auto" Padding="0,10" ColumnSpacing="12">
            <Border Grid.Column="0" Style="{StaticResource IconTile}" StrokeShape="RoundRectangle 18" WidthRequest="32" HeightRequest="32">
              <Label Text="{StaticResource IconMonitor}" FontFamily="Segoe MDL2 Assets" FontSize="14" TextColor="{StaticResource BrandTitle}" HorizontalOptions="Center" VerticalOptions="Center" />
            </Border>
            <Label Grid.Column="1" Text="Work Mode" Style="{StaticResource FieldLabel}" />
            <Label Grid.Column="2" Text="{Binding WorkMode}" Style="{StaticResource FieldValue}" />
          </Grid>
          <BoxView HeightRequest="1" BackgroundColor="{StaticResource Separator}" />
          <Grid ColumnDefinitions="40,*,Auto" Padding="0,10" ColumnSpacing="12">
            <Border Grid.Column="0" Style="{StaticResource IconTile}" StrokeShape="RoundRectangle 18" WidthRequest="32" HeightRequest="32">
              <Label Text="{StaticResource IconCamera}" FontFamily="Segoe MDL2 Assets" FontSize="14" TextColor="{StaticResource BrandTitle}" HorizontalOptions="Center" VerticalOptions="Center" />
            </Border>
            <Label Grid.Column="1" Text="Face Verification" Style="{StaticResource FieldLabel}" />
            <Label Grid.Column="2" Text="{Binding FaceVerificationStatusText}" Style="{StaticResource FieldValue}" />
          </Grid>
          <BoxView HeightRequest="1" BackgroundColor="{StaticResource Separator}" />
          <Grid ColumnDefinitions="40,*,Auto" Padding="0,10" ColumnSpacing="12">
            <Border Grid.Column="0" Style="{StaticResource IconTile}" StrokeShape="RoundRectangle 18" WidthRequest="32" HeightRequest="32">
              <Label Text="{StaticResource IconApps}" FontFamily="Segoe MDL2 Assets" FontSize="14" TextColor="{StaticResource BrandTitle}" HorizontalOptions="Center" VerticalOptions="Center" />
            </Border>
            <Label Grid.Column="1" Text="This Device" Style="{StaticResource FieldLabel}" />
            <Label Grid.Column="2" Text="{Binding ThisDevice}" Style="{StaticResource FieldValue}" />
          </Grid>
        </VerticalStackLayout>
      </Border>

      <Border Style="{StaticResource TrayPrimaryActionBorder}" Margin="0,0,0,8">
        <Border.Background>
          <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
            <GradientStop Color="{StaticResource ConnectButtonStart}" Offset="0" />
            <GradientStop Color="{StaticResource ConnectButtonMid}" Offset="0.55" />
            <GradientStop Color="{StaticResource ConnectButtonEnd}" Offset="1" />
          </LinearGradientBrush>
        </Border.Background>
        <Grid>
          <Button Command="{Binding ConfirmAndContinueCommand}" Style="{StaticResource TrayPrimaryActionOverlay}" Text="" SemanticProperties.Description="Confirm and Continue" />
          <HorizontalStackLayout InputTransparent="True" HorizontalOptions="Center" VerticalOptions="Center" Spacing="8">
            <Label Text="{StaticResource IconShield}" FontFamily="Segoe MDL2 Assets" FontSize="16" TextColor="White" VerticalOptions="Center" />
            <Label Text="Confirm &amp; Continue" FontSize="15" FontAttributes="Bold" TextColor="White" VerticalOptions="Center" />
          </HorizontalStackLayout>
        </Grid>
      </Border>
      <Button Text="←  Back" Command="{Binding BackCommand}" BackgroundColor="Transparent" TextColor="{StaticResource Primary}" FontSize="14" HorizontalOptions="Center" />
    </VerticalStackLayout>

    <controls:FooterStatusBar Grid.Row="1" VersionText="Version 1.0.0" ConnectionLabel="Connected" IsConnected="True" />
  </Grid>
</ContentPage>
