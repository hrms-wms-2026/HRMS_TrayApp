<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:ONEVO.Agent.TrayApp.ViewModels"
             xmlns:controls="clr-namespace:ONEVO.Agent.TrayApp.Controls"
             x:Class="ONEVO.Agent.TrayApp.Views.ReviewSetupPage"
             x:DataType="vm:ReviewSetupViewModel"
             Shell.NavBarIsVisible="False"
             Title="OneXso WorkPulse">

  <Grid RowDefinitions="*,Auto" Padding="40,20,40,12">
    <Grid.Background>
      <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="{StaticResource BackgroundWashStart}" Offset="0" />
        <GradientStop Color="{StaticResource BackgroundWashMid}" Offset="0.45" />
        <GradientStop Color="{StaticResource BackgroundWashEnd}" Offset="1" />
      </LinearGradientBrush>
    </Grid.Background>

    <VerticalStackLayout Grid.Row="0" Spacing="0" VerticalOptions="Center"
                         MaximumWidthRequest="680" HorizontalOptions="Center">
      <Label HorizontalOptions="Center" Margin="0,0,0,6">
        <Label.FormattedText>
          <FormattedString>
            <Span Text="Confirm Your " FontSize="26" FontAttributes="Bold" TextColor="{StaticResource TextPrimary}" />
            <Span Text="Details" FontSize="26" FontAttributes="Bold" TextColor="{StaticResource BrandTitle}" />
          </FormattedString>
        </Label.FormattedText>
      </Label>
      <Label Text="Please review your information before continuing."
             Style="{StaticResource PageSubtitle}" Margin="0,0,0,18" />

      <Border Style="{StaticResource SetupResultCard}" Padding="20,4" Margin="0,0,0,18">
        <VerticalStackLayout Spacing="0">
          <controls:ReviewDetailRow Icon="{StaticResource IconPerson}"
                                    LabelText="Full Name"
                                    Value="{Binding FullName}" />
          <controls:ReviewDetailRow Icon="{StaticResource IconMail}"
                                    LabelText="Email"
                                    Value="{Binding WorkEmail}" />
          <controls:ReviewDetailRow Icon="{StaticResource IconBadge}"
                                    LabelText="Employee ID"
                                    Value="{Binding EmployeeId}" />
          <controls:ReviewDetailRow Icon="{StaticResource IconWork}"
                                    LabelText="Department"
                                    Value="{Binding Department}" />
          <controls:ReviewDetailRow Icon="{StaticResource IconLocation}"
                                    LabelText="Registered Office"
                                    Value="{Binding RegisteredOffice}" />
          <controls:ReviewDetailRow Icon="{StaticResource IconMonitor}"
                                    LabelText="Work Mode"
                                    Value="{Binding WorkMode}" />
          <controls:ReviewDetailRow Icon="{StaticResource IconShield}"
                                    LabelText="Face Verification"
                                    Value="{Binding FaceVerificationStatusText}" />
          <controls:ReviewDetailRow Icon="{StaticResource IconLaptop}"
                                    LabelText="This Device"
                                    Value="{Binding ThisDevice}"
                                    ShowDivider="False" />
        </VerticalStackLayout>
      </Border>

      <Border Style="{StaticResource TrayPrimaryActionBorder}" Margin="0,0,0,8">
        <Border.Background>
          <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
            <GradientStop Color="{StaticResource ConnectButtonStart}" Offset="0" />
            <GradientStop Color="{StaticResource ConnectButtonMid}" Offset="0.55" />
            <GradientStop Color="{StaticResource ConnectButtonEnd}" Offset="1" />
          </LinearGradientBrush>
        </Border.Background>
        <Grid>
          <Button Command="{Binding ConfirmAndContinueCommand}" Style="{StaticResource TrayPrimaryActionOverlay}" Text="" SemanticProperties.Description="Confirm and Continue" />
          <HorizontalStackLayout InputTransparent="True" HorizontalOptions="Center" VerticalOptions="Center" Spacing="8">
            <Label Text="{StaticResource IconShield}" FontFamily="Segoe MDL2 Assets" FontSize="16" TextColor="White" VerticalOptions="Center" />
            <Label Text="Confirm &amp; Continue" Style="{StaticResource ButtonLabel}" />
          </HorizontalStackLayout>
        </Grid>
      </Border>
      <Button Text="←  Back" Command="{Binding BackCommand}" BackgroundColor="Transparent" TextColor="{StaticResource Primary}" FontSize="14" HorizontalOptions="Center" />
    </VerticalStackLayout>

    <controls:FooterStatusBar Grid.Row="1" VersionText="Version 1.0.0" ConnectionLabel="Connected" IsConnected="True" />
  </Grid>
</ContentPage>
