<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:ONEVO.Agent.TrayApp.ViewModels"
             x:Class="ONEVO.Agent.TrayApp.Views.PrepareWorkspacePage"
             x:DataType="vm:PrepareWorkspaceViewModel"
             BackgroundColor="{StaticResource Background}"
             Title="Setting Up Your Workspace">
  <ScrollView>
    <VerticalStackLayout Padding="48,36" Spacing="0"
                         HorizontalOptions="Center" MaximumWidthRequest="640">

      <!-- Header -->
      <HorizontalStackLayout HorizontalOptions="Center" Spacing="6">
        <Label Text="Setting up" Style="{StaticResource PageTitle}" />
        <Label Text="your workspace" Style="{StaticResource PageTitleAccent}" />
      </HorizontalStackLayout>
      <Label Text="We are securely fetching your account details and preparing your profile."
             Style="{StaticResource PageSubtitle}" Margin="0,8,0,28" />

      <!-- Progress ring + steps row -->
      <Grid ColumnDefinitions="Auto,*" ColumnSpacing="28" Margin="0,0,0,24">

        <!-- Circular ring with spinner -->
        <Border Grid.Column="0"
                WidthRequest="110" HeightRequest="110"
                StrokeShape="RoundRectangle 55"
                Stroke="{StaticResource Separator}" StrokeThickness="6"
                BackgroundColor="{StaticResource CardBackground}"
                VerticalOptions="Center">
          <Border WidthRequest="98" HeightRequest="98"
                  StrokeShape="RoundRectangle 49" StrokeThickness="0"
                  BackgroundColor="Transparent"
                  HorizontalOptions="Center" VerticalOptions="Center">
            <Border.Background>
              <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="{StaticResource PrimaryGradientStart}" Offset="0" />
                <GradientStop Color="{StaticResource PrimaryGradientEnd}" Offset="1" />
              </LinearGradientBrush>
            </Border.Background>
            <ActivityIndicator IsRunning="{Binding IsLoading}"
                               Color="White"
                               WidthRequest="48" HeightRequest="48"
                               HorizontalOptions="Center" VerticalOptions="Center" />
          </Border>
        </Border>

        <!-- Step list -->
        <VerticalStackLayout Grid.Column="1" Spacing="18" VerticalOptions="Center">

          <!-- Step 1: Verifying activation -->
          <HorizontalStackLayout Spacing="14">
            <Border WidthRequest="30" HeightRequest="30"
                    StrokeShape="RoundRectangle 15" StrokeThickness="0"
                    BackgroundColor="{StaticResource Primary}">
              <Label Text="✓" TextColor="White" FontSize="14" FontAttributes="Bold"
                     HorizontalOptions="Center" VerticalOptions="Center" />
            </Border>
            <VerticalStackLayout VerticalOptions="Center">
              <Label Text="Verifying activation"
                     FontAttributes="Bold" TextColor="{StaticResource TextPrimary}" FontSize="13" />
              <Label Text="Completed" TextColor="{StaticResource TextSecondary}" FontSize="11" />
            </VerticalStackLayout>
          </HorizontalStackLayout>

          <!-- Step 2: Fetching user details -->
          <HorizontalStackLayout Spacing="14">
            <Border WidthRequest="30" HeightRequest="30"
                    StrokeShape="RoundRectangle 15" StrokeThickness="2"
                    Stroke="{StaticResource Primary}"
                    BackgroundColor="{StaticResource CardBackground}">
              <ActivityIndicator IsRunning="{Binding IsLoading}"
                                 IsVisible="{Binding UserDetailsFetched, Converter={StaticResource InvertBoolConverter}}"
                                 Color="{StaticResource Primary}"
                                 WidthRequest="16" HeightRequest="16"
                                 HorizontalOptions="Center" VerticalOptions="Center" />
              <Label Text="✓" TextColor="{StaticResource Primary}" FontSize="14" FontAttributes="Bold"
                     IsVisible="{Binding UserDetailsFetched}"
                     HorizontalOptions="Center" VerticalOptions="Center" />
            </Border>
            <VerticalStackLayout VerticalOptions="Center">
              <Label Text="Fetching user details"
                     FontAttributes="Bold" TextColor="{StaticResource Primary}" FontSize="13" />
              <Label Text="In progress" TextColor="{StaticResource Primary}" FontSize="11" />
            </VerticalStackLayout>
          </HorizontalStackLayout>

          <!-- Step 3: Preparing workspace -->
          <HorizontalStackLayout Spacing="14">
            <Border WidthRequest="30" HeightRequest="30"
                    StrokeShape="RoundRectangle 15" StrokeThickness="2"
                    Stroke="{StaticResource Separator}"
                    BackgroundColor="Transparent">
              <Label Text="" WidthRequest="16" HeightRequest="16" />
            </Border>
            <VerticalStackLayout VerticalOptions="Center">
              <Label Text="Preparing your workspace"
                     TextColor="{StaticResource TextSecondary}" FontSize="13" />
              <Label Text="Pending" TextColor="{StaticResource TextMuted}" FontSize="11" />
            </VerticalStackLayout>
          </HorizontalStackLayout>

        </VerticalStackLayout>
      </Grid>

      <!-- Your Information card -->
      <Border Style="{StaticResource Card}" Margin="0,0,0,10">
        <VerticalStackLayout Spacing="0">
          <Label Text="Your Information"
                 FontAttributes="Bold" TextColor="{StaticResource TextPrimary}" FontSize="14"
                 Margin="0,0,0,12" />

          <!-- Full Name -->
          <BoxView HeightRequest="1" BackgroundColor="{StaticResource Separator}" />
          <Grid ColumnDefinitions="32,*,Auto" Padding="4,10" ColumnSpacing="10">
            <Label Grid.Column="0" Text="👤" FontSize="17" HorizontalOptions="Center" VerticalOptions="Center" />
            <Label Grid.Column="1" Text="Full Name" Style="{StaticResource FieldLabel}" />
            <Label Grid.Column="2" Text="{Binding EmployeeFullName}" Style="{StaticResource FieldValue}" />
          </Grid>

          <!-- Email -->
          <BoxView HeightRequest="1" BackgroundColor="{StaticResource Separator}" />
          <Grid ColumnDefinitions="32,*,Auto" Padding="4,10" ColumnSpacing="10">
            <Label Grid.Column="0" Text="✉" FontSize="17" HorizontalOptions="Center" VerticalOptions="Center" />
            <Label Grid.Column="1" Text="Email" Style="{StaticResource FieldLabel}" />
            <Label Grid.Column="2" Text="{Binding EmployeeEmail}" Style="{StaticResource FieldValue}" />
          </Grid>

          <!-- Employee ID -->
          <BoxView HeightRequest="1" BackgroundColor="{StaticResource Separator}" />
          <Grid ColumnDefinitions="32,*,Auto" Padding="4,10" ColumnSpacing="10">
            <Label Grid.Column="0" Text="🪪" FontSize="17" HorizontalOptions="Center" VerticalOptions="Center" />
            <Label Grid.Column="1" Text="Employee ID" Style="{StaticResource FieldLabel}" />
            <Label Grid.Column="2" Text="{Binding EmployeeId}" Style="{StaticResource FieldValue}" />
          </Grid>
        </VerticalStackLayout>
      </Border>

      <!-- Location action row -->
      <Border Style="{StaticResource Card}" Margin="0,0,0,8" Padding="12,14">
        <Border.GestureRecognizers>
          <TapGestureRecognizer Command="{Binding NavigateToLocationCommand}" />
        </Border.GestureRecognizers>
        <Grid ColumnDefinitions="32,*,Auto" ColumnSpacing="10">
          <Label Grid.Column="0" Text="&#xE81D;" FontFamily="Segoe MDL2 Assets" FontSize="18"
                 TextColor="{StaticResource Primary}"
                 HorizontalOptions="Center" VerticalOptions="Center" />
          <VerticalStackLayout Grid.Column="1" VerticalOptions="Center">
            <Label Text="Location" FontAttributes="Bold"
                   TextColor="{StaticResource TextPrimary}" FontSize="13" />
            <Label Text="Select your work location"
                   TextColor="{StaticResource TextSecondary}" FontSize="11" />
          </VerticalStackLayout>
          <Label Grid.Column="2" Text="›" FontSize="22"
                 TextColor="{StaticResource TextMuted}" VerticalOptions="Center" />
        </Grid>
      </Border>

      <!-- Profile Picture action row -->
      <Border Style="{StaticResource Card}" Margin="0,0,0,28" Padding="12,14">
        <Border.GestureRecognizers>
          <TapGestureRecognizer Command="{Binding NavigateToPhotoCommand}" />
        </Border.GestureRecognizers>
        <Grid ColumnDefinitions="32,*,Auto" ColumnSpacing="10">
          <Label Grid.Column="0" Text="&#xE722;" FontFamily="Segoe MDL2 Assets" FontSize="18"
                 TextColor="{StaticResource Primary}"
                 HorizontalOptions="Center" VerticalOptions="Center" />
          <VerticalStackLayout Grid.Column="1" VerticalOptions="Center">
            <Label Text="Profile Picture" FontAttributes="Bold"
                   TextColor="{StaticResource TextPrimary}" FontSize="13" />
            <Label Text="Capture your face"
                   TextColor="{StaticResource TextSecondary}" FontSize="11" />
          </VerticalStackLayout>
          <Label Grid.Column="2" Text="›" FontSize="22"
                 TextColor="{StaticResource TextMuted}" VerticalOptions="Center" />
        </Grid>
      </Border>

      <!-- Continue button -->
      <Border Style="{StaticResource GradientButtonBorder}">
        <Button Text="Continue"
                Command="{Binding ContinueSetupCommand}"
                Style="{StaticResource GradientButtonOverlay}" />
      </Border>

    </VerticalStackLayout>
  </ScrollView>
</ContentPage>
