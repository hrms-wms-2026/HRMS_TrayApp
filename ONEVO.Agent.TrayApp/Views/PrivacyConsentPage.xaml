<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:ONEVO.Agent.TrayApp.ViewModels"
             xmlns:controls="clr-namespace:ONEVO.Agent.TrayApp.Controls"
             x:Class="ONEVO.Agent.TrayApp.Views.PrivacyConsentPage"
             x:DataType="vm:PrivacyConsentViewModel"
             Title="Allow Required Policies">

  <Grid RowDefinitions="Auto,Auto,*,Auto,Auto" Padding="28,16,28,12">
    <Grid.Background>
      <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="{StaticResource BackgroundWashStart}" Offset="0" />
        <GradientStop Color="#EEF2FF" Offset="0.5" />
        <GradientStop Color="{StaticResource BackgroundWashEnd}" Offset="1" />
      </LinearGradientBrush>
    </Grid.Background>

    <Ellipse Grid.RowSpan="5" WidthRequest="480" HeightRequest="480"
             HorizontalOptions="Start" VerticalOptions="Start" Margin="-180,-140,0,0"
             Opacity="0.8" InputTransparent="True">
      <Ellipse.Fill>
        <RadialGradientBrush Center="0.5,0.5" Radius="0.5">
          <GradientStop Color="{StaticResource GlassGlowPrimary}" Offset="0" />
          <GradientStop Color="#00175CFF" Offset="1" />
        </RadialGradientBrush>
      </Ellipse.Fill>
    </Ellipse>
    <Ellipse Grid.RowSpan="5" WidthRequest="400" HeightRequest="400"
             HorizontalOptions="End" VerticalOptions="End" Margin="0,0,-140,-80"
             Opacity="0.75" InputTransparent="True">
      <Ellipse.Fill>
        <RadialGradientBrush Center="0.5,0.5" Radius="0.5">
          <GradientStop Color="{StaticResource GlassGlowAccent}" Offset="0" />
          <GradientStop Color="#006D28D9" Offset="1" />
        </RadialGradientBrush>
      </Ellipse.Fill>
    </Ellipse>

    <controls:AppHeaderBar Grid.Row="0" ShowSubtitle="False" />

    <VerticalStackLayout Grid.Row="1" HorizontalOptions="Center" Margin="0,2,0,8">
      <HorizontalStackLayout HorizontalOptions="Center" Spacing="6">
        <Label Text="Allow " Style="{StaticResource PageTitle}" />
        <Label Text="Required Policies" Style="{StaticResource PageTitleBrand}" />
      </HorizontalStackLayout>
      <Label Text="To provide the best experience, please allow the required permissions."
             Style="{StaticResource PageSubtitle}" Margin="0,6,0,0" />
    </VerticalStackLayout>

    <Border Grid.Row="2" Style="{StaticResource TrayCompactGlassCard}" Padding="16,4"
            HorizontalOptions="Center" MaximumWidthRequest="640"
            VerticalOptions="Fill">
        <VerticalStackLayout Spacing="0" VerticalOptions="Center">

          <Grid ColumnDefinitions="44,*,Auto" Padding="2,8" ColumnSpacing="12">
            <Border Grid.Column="0" Style="{StaticResource IconTile}"
                    StrokeShape="RoundRectangle 12" WidthRequest="38" HeightRequest="38">
              <Label Text="{StaticResource IconMonitor}" FontFamily="Segoe MDL2 Assets"
                     FontSize="17" TextColor="{StaticResource Primary}"
                     HorizontalOptions="Center" VerticalOptions="Center" />
            </Border>
            <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="1">
              <Label Text="Screen Monitoring" FontAttributes="Bold"
                     TextColor="{StaticResource TextPrimary}" FontSize="13" />
              <Label Text="Allows capturing your screen activity for productivity insights."
                     TextColor="{StaticResource TextSecondary}" FontSize="11" />
            </VerticalStackLayout>
            <Switch Grid.Column="2" IsToggled="{Binding ScreenMonitoringEnabled}"
                    IsEnabled="False" VerticalOptions="Center" />
          </Grid>
          <BoxView HeightRequest="1" BackgroundColor="{StaticResource Separator}" />

          <Grid ColumnDefinitions="44,*,Auto" Padding="2,8" ColumnSpacing="12">
            <Border Grid.Column="0" Style="{StaticResource IconTile}"
                    StrokeShape="RoundRectangle 12" WidthRequest="38" HeightRequest="38">
              <Label Text="{StaticResource IconApps}" FontFamily="Segoe MDL2 Assets"
                     FontSize="17" TextColor="{StaticResource Primary}"
                     HorizontalOptions="Center" VerticalOptions="Center" />
            </Border>
            <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="1">
              <Label Text="Application Tracking" FontAttributes="Bold"
                     TextColor="{StaticResource TextPrimary}" FontSize="13" />
              <Label Text="Tracks application usage to help improve your workflow."
                     TextColor="{StaticResource TextSecondary}" FontSize="11" />
            </VerticalStackLayout>
            <Switch Grid.Column="2" IsToggled="{Binding AppTrackingEnabled}"
                    VerticalOptions="Center" />
          </Grid>
          <BoxView HeightRequest="1" BackgroundColor="{StaticResource Separator}" />

          <Grid ColumnDefinitions="44,*,Auto" Padding="2,8" ColumnSpacing="12">
            <Border Grid.Column="0" Style="{StaticResource IconTile}"
                    StrokeShape="RoundRectangle 12" WidthRequest="38" HeightRequest="38">
              <Label Text="{StaticResource IconLocation}" FontFamily="Segoe MDL2 Assets"
                     FontSize="17" TextColor="{StaticResource Primary}"
                     HorizontalOptions="Center" VerticalOptions="Center" />
            </Border>
            <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="1">
              <Label Text="Location Access" FontAttributes="Bold"
                     TextColor="{StaticResource TextPrimary}" FontSize="13" />
              <Label Text="Helps contextualize your work environment."
                     TextColor="{StaticResource TextSecondary}" FontSize="11" />
            </VerticalStackLayout>
            <Switch Grid.Column="2" IsToggled="{Binding LocationAccessEnabled}"
                    VerticalOptions="Center" />
          </Grid>
          <BoxView HeightRequest="1" BackgroundColor="{StaticResource Separator}" />

          <Grid ColumnDefinitions="44,*,Auto" Padding="2,8" ColumnSpacing="12">
            <Border Grid.Column="0" Style="{StaticResource IconTile}"
                    StrokeShape="RoundRectangle 12" WidthRequest="38" HeightRequest="38">
              <Label Text="{StaticResource IconCamera}" FontFamily="Segoe MDL2 Assets"
                     FontSize="17" TextColor="{StaticResource Primary}"
                     HorizontalOptions="Center" VerticalOptions="Center" />
            </Border>
            <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="1">
              <Label Text="Camera Access" FontAttributes="Bold"
                     TextColor="{StaticResource TextPrimary}" FontSize="13" />
              <Label Text="Enables video meetings and identity verification."
                     TextColor="{StaticResource TextSecondary}" FontSize="11" />
            </VerticalStackLayout>
            <Switch Grid.Column="2" IsToggled="{Binding CameraAccessEnabled}"
                    VerticalOptions="Center" />
          </Grid>
          <BoxView HeightRequest="1" BackgroundColor="{StaticResource Separator}" />

          <Grid ColumnDefinitions="44,*,Auto" Padding="2,8" ColumnSpacing="12">
            <Border Grid.Column="0" Style="{StaticResource IconTile}"
                    StrokeShape="RoundRectangle 12" WidthRequest="38" HeightRequest="38">
              <Label Text="{StaticResource IconBell}" FontFamily="Segoe MDL2 Assets"
                     FontSize="17" TextColor="{StaticResource Primary}"
                     HorizontalOptions="Center" VerticalOptions="Center" />
            </Border>
            <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="1">
              <Label Text="System Notifications" FontAttributes="Bold"
                     TextColor="{StaticResource TextPrimary}" FontSize="13" />
              <Label Text="Keeps you informed with important updates and alerts."
                     TextColor="{StaticResource TextSecondary}" FontSize="11" />
            </VerticalStackLayout>
            <Switch Grid.Column="2" IsToggled="{Binding NotificationsEnabled}"
                    VerticalOptions="Center" />
          </Grid>
          <BoxView HeightRequest="1" BackgroundColor="{StaticResource Separator}" />

          <Grid ColumnDefinitions="44,*,Auto" Padding="2,8" ColumnSpacing="12">
            <Border Grid.Column="0" Style="{StaticResource IconTile}"
                    StrokeShape="RoundRectangle 12" WidthRequest="38" HeightRequest="38">
              <Label Text="{StaticResource IconKeyboard}" FontFamily="Segoe MDL2 Assets"
                     FontSize="17" TextColor="{StaticResource Primary}"
                     HorizontalOptions="Center" VerticalOptions="Center" />
            </Border>
            <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="1">
              <Label Text="Keyboard &amp; Mouse Activity" FontAttributes="Bold"
                     TextColor="{StaticResource TextPrimary}" FontSize="13" />
              <Label Text="Helps analyze work patterns to enhance productivity."
                     TextColor="{StaticResource TextSecondary}" FontSize="11" />
            </VerticalStackLayout>
            <Switch Grid.Column="2" IsToggled="{Binding KeyboardMouseEnabled}"
                    IsEnabled="False" VerticalOptions="Center" />
          </Grid>

          <BoxView HeightRequest="1" BackgroundColor="{StaticResource Separator}" />
          <HorizontalStackLayout Spacing="8" Padding="4,8" HorizontalOptions="Center">
            <Border Style="{StaticResource IconTile}"
                    WidthRequest="24" HeightRequest="24" StrokeShape="RoundRectangle 12">
              <Label Text="{StaticResource IconShield}" FontFamily="Segoe MDL2 Assets"
                     FontSize="11" TextColor="{StaticResource BrandTitle}"
                     HorizontalOptions="Center" VerticalOptions="Center" />
            </Border>
            <Label Text="Permissions are managed according to your company policy."
                   FontSize="11" TextColor="{StaticResource TextSecondary}"
                   VerticalOptions="Center" />
          </HorizontalStackLayout>
        </VerticalStackLayout>
    </Border>

    <Border Grid.Row="3" Style="{StaticResource TrayPrimaryActionBorder}"
            HorizontalOptions="Center" WidthRequest="420" Margin="0,10,0,0">
      <Border.Background>
        <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
          <GradientStop Color="{StaticResource ConnectButtonStart}" Offset="0" />
          <GradientStop Color="{StaticResource ConnectButtonMid}" Offset="0.55" />
          <GradientStop Color="{StaticResource ConnectButtonEnd}" Offset="1" />
        </LinearGradientBrush>
      </Border.Background>
      <Grid>
        <Button Command="{Binding AllowAndContinueCommand}"
                Style="{StaticResource TrayPrimaryActionOverlay}"
                Text=""
                SemanticProperties.Description="Allow and Continue" />
        <HorizontalStackLayout InputTransparent="True"
                               HorizontalOptions="Center" VerticalOptions="Center" Spacing="8">
          <Label Text="{StaticResource IconShield}" FontFamily="Segoe MDL2 Assets"
                 FontSize="16" TextColor="White" VerticalOptions="Center" />
          <Label Text="Allow &amp; Continue" FontSize="15" FontAttributes="Bold"
                 TextColor="White" VerticalOptions="Center" />
        </HorizontalStackLayout>
      </Grid>
    </Border>

    <controls:FooterStatusBar Grid.Row="4"
                              VersionText="Version 1.0.0"
                              ConnectionLabel="Connected"
                              IsConnected="True" />
  </Grid>
</ContentPage>
