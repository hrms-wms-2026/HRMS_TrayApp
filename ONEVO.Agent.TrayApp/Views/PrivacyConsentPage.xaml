<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:ONEVO.Agent.TrayApp.ViewModels"
             xmlns:controls="clr-namespace:ONEVO.Agent.TrayApp.Controls"
             x:Class="ONEVO.Agent.TrayApp.Views.PrivacyConsentPage"
             x:DataType="vm:PrivacyConsentViewModel"
             Shell.NavBarIsVisible="False"
             Title="OneXso WorkPulse">

  <Grid RowDefinitions="*,Auto" Padding="32,20,32,12">
    <Grid.Background>
      <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="{StaticResource BackgroundWashStart}" Offset="0" />
        <GradientStop Color="{StaticResource BackgroundWashMid}" Offset="0.5" />
        <GradientStop Color="{StaticResource BackgroundWashEnd}" Offset="1" />
      </LinearGradientBrush>
    </Grid.Background>

    <Grid x:Name="PaneGrid" Grid.Row="0" ColumnDefinitions="0.92*,1.18*" ColumnSpacing="32">
      <Border x:Name="LeftPane"
              Grid.Column="0"
              StrokeShape="RoundRectangle 28"
              StrokeThickness="0"
              BackgroundColor="Transparent"
              VerticalOptions="Center"
              HorizontalOptions="Fill">
        <Image Source="workspace_permissions.png" Aspect="AspectFit" />
      </Border>

      <VerticalStackLayout x:Name="RightPane" Grid.Column="1" VerticalOptions="Center" Spacing="0">
        <Label Margin="0,0,0,6">
          <Label.FormattedText>
            <FormattedString>
              <Span Text="Allow " FontSize="28" FontAttributes="Bold" TextColor="{StaticResource TextPrimary}" />
              <Span Text="Required Permissions" FontSize="28" FontAttributes="Bold" TextColor="{StaticResource BrandTitle}" />
            </FormattedString>
          </Label.FormattedText>
        </Label>
        <Label Text="Grant permissions needed for a secure and productive experience."
               Style="{StaticResource PageSubtitle}"
               HorizontalTextAlignment="Start"
               Margin="0,0,0,18" />

        <Border Style="{StaticResource SetupResultCard}"
                Padding="18,6"
                StrokeShape="RoundRectangle 24"
                Margin="0,0,0,16"
                HorizontalOptions="Fill">
          <VerticalStackLayout Spacing="0">
            <controls:PermissionToggleRow IconSource="icon_perm_chart.png"
                                          Title="Work Activity Monitoring"
                                          Description="Tracks active and idle work periods."
                                          IsToggled="{Binding ScreenMonitoringEnabled}" />
            <controls:PermissionToggleRow IconSource="icon_perm_apps.png"
                                          Title="Application Usage"
                                          Description="Records applications used and time spent."
                                          IsToggled="{Binding AppTrackingEnabled}" />
            <controls:PermissionToggleRow IconSource="icon_perm_location.png"
                                          Title="Location Access"
                                          Description="Used to verify your work location."
                                          IsToggled="{Binding LocationAccessEnabled}" />
            <controls:PermissionToggleRow IconSource="icon_perm_camera.png"
                                          Title="Camera Access"
                                          Description="Used for identity verification as per company policy."
                                          IsToggled="{Binding CameraAccessEnabled}" />
            <controls:PermissionToggleRow IconSource="icon_perm_bell.png"
                                          Title="System Notifications"
                                          Description="Keeps you informed about important updates."
                                          IsToggled="{Binding NotificationsEnabled}"
                                          ShowDivider="False" />
          </VerticalStackLayout>
        </Border>

        <Border Style="{StaticResource TrayPrimaryActionBorder}"
                HorizontalOptions="Fill"
                HeightRequest="48"
                Margin="0,0,0,8">
          <Border.Background>
            <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
              <GradientStop Color="{StaticResource ConnectButtonStart}" Offset="0" />
              <GradientStop Color="{StaticResource ConnectButtonMid}" Offset="0.55" />
              <GradientStop Color="{StaticResource ConnectButtonEnd}" Offset="1" />
            </LinearGradientBrush>
          </Border.Background>
          <Grid>
            <Button Command="{Binding AllowAndContinueCommand}"
                    Style="{StaticResource TrayPrimaryActionOverlay}"
                    HeightRequest="48"
                    Text=""
                    SemanticProperties.Description="Allow and Continue" />
            <Label InputTransparent="True"
                   Text="Allow &amp; Continue"
                   FontSize="15"
                   FontAttributes="Bold"
                   TextColor="White"
                   HorizontalOptions="Center"
                   VerticalOptions="Center" />
          </Grid>
        </Border>

        <Grid HorizontalOptions="Center" HeightRequest="36">
          <Button Command="{Binding WhyNeededCommand}"
                  BackgroundColor="Transparent"
                  BorderWidth="0"
                  SemanticProperties.Description="Why are these needed?" />
          <HorizontalStackLayout InputTransparent="True"
                                 Spacing="6"
                                 HorizontalOptions="Center"
                                 VerticalOptions="Center">
            <Label Text="{StaticResource IconHelp}"
                   FontFamily="Segoe MDL2 Assets"
                   FontSize="16"
                   TextColor="{StaticResource Primary}"
                   VerticalOptions="Center" />
            <Label Text="Why are these needed?"
                   FontSize="15"
                   TextColor="{StaticResource Primary}"
                   VerticalOptions="Center" />
          </HorizontalStackLayout>
        </Grid>
      </VerticalStackLayout>
    </Grid>

    <controls:FooterStatusBar Grid.Row="1"
                              VersionText="Version 1.0.0"
                              ConnectionLabel="Connected"
                              IsConnected="True" />
  </Grid>
</ContentPage>
