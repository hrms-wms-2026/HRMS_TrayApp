<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:ONEVO.Agent.TrayApp.ViewModels"
             xmlns:controls="clr-namespace:ONEVO.Agent.TrayApp.Controls"
             x:Class="ONEVO.Agent.TrayApp.Views.PrivacyConsentPage"
             x:DataType="vm:PrivacyConsentViewModel"
             Shell.NavBarIsVisible="False"
             Title="OneXso WorkPulse">

  <Grid RowDefinitions="*,Auto" Padding="28,16,28,12">
    <Grid.Background>
      <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="{StaticResource BackgroundWashStart}" Offset="0" />
        <GradientStop Color="{StaticResource BackgroundWashMid}" Offset="0.5" />
        <GradientStop Color="{StaticResource BackgroundWashEnd}" Offset="1" />
      </LinearGradientBrush>
    </Grid.Background>

    <Grid x:Name="PaneGrid" Grid.Row="0" ColumnDefinitions="*,*" ColumnSpacing="28">
      <Image x:Name="LeftPane" Grid.Column="0" Source="workspace_permissions.png"
             Aspect="AspectFit" VerticalOptions="Center" />

      <VerticalStackLayout x:Name="RightPane" Grid.Column="1" VerticalOptions="Center" Spacing="0">
        <Label Margin="0,0,0,6">
          <Label.FormattedText>
            <FormattedString>
              <Span Text="Allow " FontSize="26" FontAttributes="Bold" TextColor="{StaticResource TextPrimary}" />
              <Span Text="Required Permissions" FontSize="26" FontAttributes="Bold" TextColor="{StaticResource BrandTitle}" />
            </FormattedString>
          </Label.FormattedText>
        </Label>
        <Label Text="Grant permissions needed for a secure and productive experience."
               Style="{StaticResource PageSubtitle}" HorizontalTextAlignment="Start" Margin="0,0,0,16" />

        <Border Style="{StaticResource TrayCompactGlassCard}" Padding="18,10" StrokeShape="RoundRectangle 20" Margin="0,0,0,14">
          <VerticalStackLayout Spacing="0">

            <Grid ColumnDefinitions="40,*,Auto" Padding="2,12" ColumnSpacing="12">
              <Border Grid.Column="0" Style="{StaticResource IconTile}" BackgroundColor="{StaticResource AccentSoft}">
                <Image Source="icon_perm_chart.png" WidthRequest="18" HeightRequest="18"
                       HorizontalOptions="Center" VerticalOptions="Center" />
              </Border>
              <VerticalStackLayout Grid.Column="1" Spacing="1" VerticalOptions="Center">
                <Label Text="Work Activity Monitoring" FontAttributes="Bold" FontSize="15" TextColor="{StaticResource TextPrimary}" />
                <Label Text="Tracks active and idle work periods." FontSize="14" TextColor="{StaticResource TextSecondary}" />
              </VerticalStackLayout>
              <Switch Grid.Column="2" IsToggled="{Binding ScreenMonitoringEnabled}"
                      OnColor="{StaticResource StatusBlue}" VerticalOptions="Center" />
            </Grid>
            <BoxView HeightRequest="1" BackgroundColor="{StaticResource Separator}" />

            <Grid ColumnDefinitions="40,*,Auto" Padding="2,12" ColumnSpacing="12">
              <Border Grid.Column="0" Style="{StaticResource IconTile}" BackgroundColor="{StaticResource AccentSoft}">
                <Image Source="icon_perm_apps.png" WidthRequest="18" HeightRequest="18"
                       HorizontalOptions="Center" VerticalOptions="Center" />
              </Border>
              <VerticalStackLayout Grid.Column="1" Spacing="1" VerticalOptions="Center">
                <Label Text="Application Usage" FontAttributes="Bold" FontSize="15" TextColor="{StaticResource TextPrimary}" />
                <Label Text="Records applications used and time spent." FontSize="14" TextColor="{StaticResource TextSecondary}" />
              </VerticalStackLayout>
              <Switch Grid.Column="2" IsToggled="{Binding AppTrackingEnabled}"
                      OnColor="{StaticResource StatusBlue}" VerticalOptions="Center" />
            </Grid>
            <BoxView HeightRequest="1" BackgroundColor="{StaticResource Separator}" />

            <Grid ColumnDefinitions="40,*,Auto" Padding="2,12" ColumnSpacing="12">
              <Border Grid.Column="0" Style="{StaticResource IconTile}" BackgroundColor="{StaticResource AccentSoft}">
                <Image Source="icon_perm_location.png" WidthRequest="18" HeightRequest="18"
                       HorizontalOptions="Center" VerticalOptions="Center" />
              </Border>
              <VerticalStackLayout Grid.Column="1" Spacing="1" VerticalOptions="Center">
                <Label Text="Location Access" FontAttributes="Bold" FontSize="15" TextColor="{StaticResource TextPrimary}" />
                <Label Text="Used to verify your work location." FontSize="14" TextColor="{StaticResource TextSecondary}" />
              </VerticalStackLayout>
              <Switch Grid.Column="2" IsToggled="{Binding LocationAccessEnabled}"
                      OnColor="{StaticResource StatusBlue}" VerticalOptions="Center" />
            </Grid>
            <BoxView HeightRequest="1" BackgroundColor="{StaticResource Separator}" />

            <Grid ColumnDefinitions="40,*,Auto" Padding="2,12" ColumnSpacing="12">
              <Border Grid.Column="0" Style="{StaticResource IconTile}" BackgroundColor="{StaticResource AccentSoft}">
                <Image Source="icon_perm_camera.png" WidthRequest="18" HeightRequest="18"
                       HorizontalOptions="Center" VerticalOptions="Center" />
              </Border>
              <VerticalStackLayout Grid.Column="1" Spacing="1" VerticalOptions="Center">
                <Label Text="Camera Access" FontAttributes="Bold" FontSize="15" TextColor="{StaticResource TextPrimary}" />
                <Label Text="Used for identity verification as per company policy." FontSize="14" TextColor="{StaticResource TextSecondary}" />
              </VerticalStackLayout>
              <Switch Grid.Column="2" IsToggled="{Binding CameraAccessEnabled}"
                      OnColor="{StaticResource StatusBlue}" VerticalOptions="Center" />
            </Grid>
            <BoxView HeightRequest="1" BackgroundColor="{StaticResource Separator}" />

            <Grid ColumnDefinitions="40,*,Auto" Padding="2,12" ColumnSpacing="12">
              <Border Grid.Column="0" Style="{StaticResource IconTile}" BackgroundColor="{StaticResource AccentSoft}">
                <Image Source="icon_perm_bell.png" WidthRequest="18" HeightRequest="18"
                       HorizontalOptions="Center" VerticalOptions="Center" />
              </Border>
              <VerticalStackLayout Grid.Column="1" Spacing="1" VerticalOptions="Center">
                <Label Text="System Notifications" FontAttributes="Bold" FontSize="15" TextColor="{StaticResource TextPrimary}" />
                <Label Text="Keeps you informed about important updates." FontSize="14" TextColor="{StaticResource TextSecondary}" />
              </VerticalStackLayout>
              <Switch Grid.Column="2" IsToggled="{Binding NotificationsEnabled}"
                      OnColor="{StaticResource StatusBlue}" VerticalOptions="Center" />
            </Grid>
          </VerticalStackLayout>
        </Border>

        <Border Style="{StaticResource TrayPrimaryActionBorder}" Margin="0,0,0,10">
          <Border.Background>
            <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
              <GradientStop Color="{StaticResource ConnectButtonStart}" Offset="0" />
              <GradientStop Color="{StaticResource ConnectButtonMid}" Offset="0.55" />
              <GradientStop Color="{StaticResource ConnectButtonEnd}" Offset="1" />
            </LinearGradientBrush>
          </Border.Background>
          <Grid>
            <Button Command="{Binding AllowAndContinueCommand}" Style="{StaticResource TrayPrimaryActionOverlay}" Text="" SemanticProperties.Description="Allow and Continue" />
            <Label InputTransparent="True" Text="Allow &amp; Continue" FontSize="15" FontAttributes="Bold" TextColor="White" HorizontalOptions="Center" VerticalOptions="Center" />
          </Grid>
        </Border>

        <Grid HorizontalOptions="Center" HeightRequest="36">
          <Button Command="{Binding WhyNeededCommand}"
                  BackgroundColor="Transparent"
                  BorderWidth="0"
                  SemanticProperties.Description="Why are these needed?" />
          <HorizontalStackLayout InputTransparent="True" Spacing="6"
                                 HorizontalOptions="Center" VerticalOptions="Center">
            <Label Text="{StaticResource IconHelp}" FontFamily="Segoe MDL2 Assets"
                   FontSize="16" TextColor="{StaticResource Primary}" VerticalOptions="Center" />
            <Label Text="Why are these needed?" FontSize="15" TextColor="{StaticResource Primary}" VerticalOptions="Center" />
          </HorizontalStackLayout>
        </Grid>
      </VerticalStackLayout>
    </Grid>

    <controls:FooterStatusBar Grid.Row="1" VersionText="Version 1.0.0" ConnectionLabel="Connected" IsConnected="True" />
  </Grid>
</ContentPage>
