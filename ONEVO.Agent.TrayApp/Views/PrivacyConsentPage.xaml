<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:ONEVO.Agent.TrayApp.ViewModels"
             xmlns:controls="clr-namespace:ONEVO.Agent.TrayApp.Controls"
             x:Class="ONEVO.Agent.TrayApp.Views.PrivacyConsentPage"
             x:DataType="vm:PrivacyConsentViewModel"
             Shell.NavBarIsVisible="False"
             Title="OneXso WorkPulse">

  <Grid RowDefinitions="*,Auto" Padding="28,16,28,12">
    <Grid.Background>
      <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="{StaticResource BackgroundWashStart}" Offset="0" />
        <GradientStop Color="#EEF2FF" Offset="0.5" />
        <GradientStop Color="{StaticResource BackgroundWashEnd}" Offset="1" />
      </LinearGradientBrush>
    </Grid.Background>

    <Grid x:Name="PaneGrid" Grid.Row="0" ColumnDefinitions="*,*" ColumnSpacing="28">
      <Image x:Name="LeftPane" Grid.Column="0" Source="workspace_connect.png"
             Aspect="AspectFit" VerticalOptions="Center" />

      <VerticalStackLayout x:Name="RightPane" Grid.Column="1" VerticalOptions="Center" Spacing="0">
        <Label Margin="0,0,0,6">
          <Label.FormattedText>
            <FormattedString>
              <Span Text="Allow " FontSize="26" FontAttributes="Bold" TextColor="{StaticResource TextPrimary}" />
              <Span Text="Required Permissions" FontSize="26" FontAttributes="Bold" TextColor="{StaticResource BrandTitle}" />
            </FormattedString>
          </Label.FormattedText>
        </Label>
        <Label Text="Grant permissions needed for a secure and productive experience."
               Style="{StaticResource PageSubtitle}" HorizontalTextAlignment="Start" Margin="0,0,0,14" />

        <Border Style="{StaticResource TrayCompactGlassCard}" Padding="14,8" Margin="0,0,0,12">
          <VerticalStackLayout Spacing="0">
            <Grid ColumnDefinitions="40,*,Auto" Padding="2,10" ColumnSpacing="10">
              <Border Grid.Column="0" Style="{StaticResource IconTile}" WidthRequest="32" HeightRequest="32">
                <Label Text="{StaticResource IconChart}" FontFamily="Segoe MDL2 Assets" FontSize="14" TextColor="{StaticResource Primary}" HorizontalOptions="Center" VerticalOptions="Center" />
              </Border>
              <VerticalStackLayout Grid.Column="1" Spacing="1">
                <Label Text="Work Activity Monitoring" FontAttributes="Bold" FontSize="13" TextColor="{StaticResource TextPrimary}" />
                <Label Text="Tracks active and idle work periods." FontSize="11" TextColor="{StaticResource TextSecondary}" />
              </VerticalStackLayout>
              <Switch Grid.Column="2" IsToggled="{Binding ScreenMonitoringEnabled}" IsEnabled="False" VerticalOptions="Center" />
            </Grid>
            <BoxView HeightRequest="1" BackgroundColor="{StaticResource Separator}" />
            <Grid ColumnDefinitions="40,*,Auto" Padding="2,10" ColumnSpacing="10">
              <Border Grid.Column="0" Style="{StaticResource IconTile}" WidthRequest="32" HeightRequest="32">
                <Label Text="{StaticResource IconApps}" FontFamily="Segoe MDL2 Assets" FontSize="14" TextColor="{StaticResource Primary}" HorizontalOptions="Center" VerticalOptions="Center" />
              </Border>
              <VerticalStackLayout Grid.Column="1" Spacing="1">
                <Label Text="Application Usage" FontAttributes="Bold" FontSize="13" TextColor="{StaticResource TextPrimary}" />
                <Label Text="Records applications used and time spent." FontSize="11" TextColor="{StaticResource TextSecondary}" />
              </VerticalStackLayout>
              <Switch Grid.Column="2" IsToggled="{Binding AppTrackingEnabled}" VerticalOptions="Center" />
            </Grid>
            <BoxView HeightRequest="1" BackgroundColor="{StaticResource Separator}" />
            <Grid ColumnDefinitions="40,*,Auto" Padding="2,10" ColumnSpacing="10">
              <Border Grid.Column="0" Style="{StaticResource IconTile}" WidthRequest="32" HeightRequest="32">
                <Label Text="{StaticResource IconLocation}" FontFamily="Segoe MDL2 Assets" FontSize="14" TextColor="{StaticResource Primary}" HorizontalOptions="Center" VerticalOptions="Center" />
              </Border>
              <VerticalStackLayout Grid.Column="1" Spacing="1">
                <Label Text="Location Access" FontAttributes="Bold" FontSize="13" TextColor="{StaticResource TextPrimary}" />
                <Label Text="Used to verify your work location." FontSize="11" TextColor="{StaticResource TextSecondary}" />
              </VerticalStackLayout>
              <Switch Grid.Column="2" IsToggled="{Binding LocationAccessEnabled}" VerticalOptions="Center" />
            </Grid>
            <BoxView HeightRequest="1" BackgroundColor="{StaticResource Separator}" />
            <Grid ColumnDefinitions="40,*,Auto" Padding="2,10" ColumnSpacing="10">
              <Border Grid.Column="0" Style="{StaticResource IconTile}" WidthRequest="32" HeightRequest="32">
                <Label Text="{StaticResource IconCamera}" FontFamily="Segoe MDL2 Assets" FontSize="14" TextColor="{StaticResource Primary}" HorizontalOptions="Center" VerticalOptions="Center" />
              </Border>
              <VerticalStackLayout Grid.Column="1" Spacing="1">
                <Label Text="Camera Access" FontAttributes="Bold" FontSize="13" TextColor="{StaticResource TextPrimary}" />
                <Label Text="Used for identity verification as per company policy." FontSize="11" TextColor="{StaticResource TextSecondary}" />
              </VerticalStackLayout>
              <Switch Grid.Column="2" IsToggled="{Binding CameraAccessEnabled}" VerticalOptions="Center" />
            </Grid>
            <BoxView HeightRequest="1" BackgroundColor="{StaticResource Separator}" />
            <Grid ColumnDefinitions="40,*,Auto" Padding="2,10" ColumnSpacing="10">
              <Border Grid.Column="0" Style="{StaticResource IconTile}" WidthRequest="32" HeightRequest="32">
                <Label Text="{StaticResource IconBell}" FontFamily="Segoe MDL2 Assets" FontSize="14" TextColor="{StaticResource Primary}" HorizontalOptions="Center" VerticalOptions="Center" />
              </Border>
              <VerticalStackLayout Grid.Column="1" Spacing="1">
                <Label Text="System Notifications" FontAttributes="Bold" FontSize="13" TextColor="{StaticResource TextPrimary}" />
                <Label Text="Keeps you informed about important updates." FontSize="11" TextColor="{StaticResource TextSecondary}" />
              </VerticalStackLayout>
              <Switch Grid.Column="2" IsToggled="{Binding NotificationsEnabled}" VerticalOptions="Center" />
            </Grid>
          </VerticalStackLayout>
        </Border>

        <Border Style="{StaticResource TrayPrimaryActionBorder}" Margin="0,0,0,8">
          <Border.Background>
            <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
              <GradientStop Color="{StaticResource ConnectButtonStart}" Offset="0" />
              <GradientStop Color="{StaticResource ConnectButtonMid}" Offset="0.55" />
              <GradientStop Color="{StaticResource ConnectButtonEnd}" Offset="1" />
            </LinearGradientBrush>
          </Border.Background>
          <Grid>
            <Button Command="{Binding AllowAndContinueCommand}" Style="{StaticResource TrayPrimaryActionOverlay}" Text="" SemanticProperties.Description="Allow and Continue" />
            <Label InputTransparent="True" Text="Allow &amp; Continue" FontSize="15" FontAttributes="Bold" TextColor="White" HorizontalOptions="Center" VerticalOptions="Center" />
          </Grid>
        </Border>
        <Button Text="Why are these needed?" Command="{Binding WhyNeededCommand}" BackgroundColor="Transparent" TextColor="{StaticResource Primary}" FontSize="13" HorizontalOptions="Center" />
      </VerticalStackLayout>
    </Grid>

    <controls:FooterStatusBar Grid.Row="1" VersionText="Version 1.0.0" ConnectionLabel="Connected" IsConnected="True" />
  </Grid>
</ContentPage>
