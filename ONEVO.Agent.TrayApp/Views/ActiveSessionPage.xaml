<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:ONEVO.Agent.TrayApp.ViewModels"
             x:Class="ONEVO.Agent.TrayApp.Views.ActiveSessionPage"
             x:DataType="vm:ActiveSessionViewModel"
             BackgroundColor="{StaticResource Background}">

  <Grid>
    <Grid RowDefinitions="Auto,*,Auto,Auto" Padding="{StaticResource TrayDensePagePadding}">

        <!-- Header -->
        <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto" Margin="0,0,0,12">
          <HorizontalStackLayout Grid.Column="0" Spacing="10">
            <Border WidthRequest="36" HeightRequest="36"
                    StrokeShape="RoundRectangle 10" StrokeThickness="0"
                    BackgroundColor="Transparent">
              <Image Source="onexso_logo_mark.svg"
                     Aspect="AspectFit"
                     WidthRequest="36" HeightRequest="36"
                     HorizontalOptions="Center" VerticalOptions="Center" />
            </Border>
            <VerticalStackLayout VerticalOptions="Center">
              <Label Text="OneXso Workspace" FontSize="13" FontAttributes="Bold"
                     TextColor="{StaticResource TextPrimary}" />
              <Label Text="Your Workplace. Simplified."
                     FontSize="10" TextColor="{StaticResource TextSecondary}" />
            </VerticalStackLayout>
          </HorizontalStackLayout>
          <Image Grid.Column="2" Source="icon_ellipsis.svg" WidthRequest="17" HeightRequest="17"
                 VerticalOptions="Center" />
        </Grid>

        <!-- Main body -->
        <Grid x:Name="PaneGrid" Grid.Row="1" ColumnDefinitions="0.9*,1.1*" ColumnSpacing="20">

          <!-- Left illustration sits on the page wash — no glass card -->
          <Grid x:Name="LeftPane" Grid.Column="0" MinimumWidthRequest="0">
              <Image Source="workspace_active.png"
                     Aspect="AspectFit"
                     HorizontalOptions="Fill" VerticalOptions="Fill">
                <Image.Triggers>
                  <DataTrigger TargetType="Image" Binding="{Binding IsOnBreak}" Value="True">
                    <Setter Property="Source" Value="break_hero.png" />
                  </DataTrigger>
                </Image.Triggers>
              </Image>

              <!-- Working-state check badge only — on-break hero already has the coffee bubble -->
              <Border WidthRequest="34" HeightRequest="34" StrokeShape="RoundRectangle 17"
                      StrokeThickness="0" HorizontalOptions="End" VerticalOptions="Start"
                      Margin="0,10,10,0"
                      BackgroundColor="{StaticResource StatusGreen}"
                      IsVisible="{Binding IsOnBreak, Converter={StaticResource InvertBoolConverter}}">
                <Label Text="{StaticResource IconCheck}" FontFamily="Segoe MDL2 Assets"
                       FontSize="15" TextColor="White"
                       HorizontalOptions="Center" VerticalOptions="Center" />
              </Border>
          </Grid>

          <!-- Right status + actions -->
          <VerticalStackLayout x:Name="RightPane" Grid.Column="1" Spacing="8">

            <Label Text="{Binding HeaderTitle}"
                   FontSize="24" FontAttributes="Bold"
                   TextColor="{StaticResource TextPrimary}" />
            <Label Text="{Binding HeaderSubtitle}"
                   FontSize="13" TextColor="{StaticResource TextSecondary}" />

            <!-- Status + Primary timer -->
            <Border Style="{StaticResource TrayCompactGlassCard}" Padding="16,14">
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                <VerticalStackLayout Grid.Column="0" Spacing="4" VerticalOptions="Center">
                  <Label Text="Status" FontSize="11" TextColor="{StaticResource TextSecondary}" />
                  <HorizontalStackLayout Spacing="8">
                    <Ellipse x:Name="StatusDot" WidthRequest="10" HeightRequest="10"
                             Fill="{StaticResource StatusGreen}"
                             VerticalOptions="Center">
                      <Ellipse.Triggers>
                        <DataTrigger TargetType="Ellipse" Binding="{Binding IsOnBreak}" Value="True">
                          <Setter Property="Fill" Value="{StaticResource BreakAccent}" />
                          <Setter Property="WidthRequest" Value="14" />
                          <Setter Property="HeightRequest" Value="14" />
                        </DataTrigger>
                        <DataTrigger TargetType="Ellipse" Binding="{Binding IsOnBreak}" Value="False">
                          <Setter Property="Fill" Value="{StaticResource StatusGreen}" />
                        </DataTrigger>
                      </Ellipse.Triggers>
                    </Ellipse>
                    <Label Text="{Binding StatusText}" FontSize="16" FontAttributes="Bold"
                           TextColor="{StaticResource TextPrimary}" />
                  </HorizontalStackLayout>
                </VerticalStackLayout>

                <!-- Working: plain live-shift timer -->
                <VerticalStackLayout Grid.Column="1" Spacing="4" VerticalOptions="Center"
                                     IsVisible="{Binding IsOnBreak, Converter={StaticResource InvertBoolConverter}}">
                  <Label Text="{Binding PrimaryTimerLabel}"
                         FontSize="11" TextColor="{StaticResource TextSecondary}"
                         HorizontalOptions="End" />
                  <Label Text="{Binding PrimaryTimer}"
                         FontSize="22" FontAttributes="Bold"
                         TextColor="{StaticResource TextPrimary}"
                         HorizontalOptions="End" />
                </VerticalStackLayout>

                <!-- On break: cream timer pill with coffee glyph -->
                <VerticalStackLayout Grid.Column="1" Spacing="4" VerticalOptions="Center"
                                     IsVisible="{Binding IsOnBreak}">
                  <Label Text="{Binding PrimaryTimerLabel}"
                         FontSize="11" TextColor="{StaticResource TextSecondary}"
                         HorizontalOptions="End" />
                  <Border Style="{StaticResource BreakTimerPill}">
                    <HorizontalStackLayout Spacing="8" VerticalOptions="Center">
                      <Border WidthRequest="28" HeightRequest="28"
                              StrokeShape="RoundRectangle 14" StrokeThickness="0"
                              BackgroundColor="{StaticResource BreakAccent}"
                              VerticalOptions="Center">
                        <Image Source="icon_coffee_white.png" WidthRequest="16" HeightRequest="16"
                               HorizontalOptions="Center" VerticalOptions="Center" />
                      </Border>
                      <Label Text="{Binding PrimaryTimer}"
                             FontSize="20" FontAttributes="Bold"
                             TextColor="{StaticResource TextPrimary}"
                             VerticalOptions="Center" />
                    </HorizontalStackLayout>
                  </Border>
                </VerticalStackLayout>
              </Grid>
            </Border>

            <!-- Start time + schedule -->
            <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
              <Border Grid.Column="0" Style="{StaticResource TrayCompactGlassCard}" Padding="14,12">
                <HorizontalStackLayout Spacing="10">
                  <Border WidthRequest="36" HeightRequest="36"
                          StrokeShape="RoundRectangle 10" StrokeThickness="0"
                          BackgroundColor="#EEF4FF" VerticalOptions="Center">
                    <Image Source="icon_break_clock.png" WidthRequest="24" HeightRequest="24"
                           HorizontalOptions="Center" VerticalOptions="Center" />
                  </Border>
                  <VerticalStackLayout Spacing="2" VerticalOptions="Center">
                    <Label Text="Start Time" FontSize="10" TextColor="{StaticResource TextSecondary}" />
                    <Label Text="{Binding StartTimeDisplay}" FontSize="14" FontAttributes="Bold"
                           TextColor="{StaticResource Primary}" />
                  </VerticalStackLayout>
                </HorizontalStackLayout>
              </Border>
              <Border Grid.Column="1" Style="{StaticResource TrayCompactGlassCard}" Padding="14,12">
                <HorizontalStackLayout Spacing="10">
                  <Border WidthRequest="36" HeightRequest="36"
                          StrokeShape="RoundRectangle 10" StrokeThickness="0"
                          BackgroundColor="#EEF4FF" VerticalOptions="Center">
                    <Image Source="icon_break_calendar.png" WidthRequest="24" HeightRequest="24"
                           HorizontalOptions="Center" VerticalOptions="Center" />
                  </Border>
                  <VerticalStackLayout Spacing="2" VerticalOptions="Center">
                    <Label Text="Today's Schedule" FontSize="10" TextColor="{StaticResource TextSecondary}" />
                    <Label Text="{Binding ScheduleDisplay}" FontSize="12" FontAttributes="Bold"
                           TextColor="{StaticResource TextPrimary}" LineBreakMode="WordWrap" />
                  </VerticalStackLayout>
                </HorizontalStackLayout>
              </Border>
            </Grid>

            <!-- Action buttons -->
            <Grid ColumnDefinitions="*,*,*" ColumnSpacing="8" Margin="0,4,0,0">
              <!-- Break (working only) -->
              <Button Grid.Column="0"
                      Text="Break"
                      ImageSource="icon_coffee_white.png"
                      Command="{Binding RequestBreakCommand}"
                      IsVisible="{Binding IsOnBreak, Converter={StaticResource InvertBoolConverter}}"
                      Style="{StaticResource OrangePillButton}" />

              <!-- End Break (break only) — full-width orange gradient CTA -->
              <Border Grid.Column="0" Grid.ColumnSpan="3"
                      Style="{StaticResource OrangeGradientButtonBorder}"
                      IsVisible="{Binding IsOnBreak}">
                <Grid>
                  <Button Command="{Binding EndBreakCommand}"
                          Style="{StaticResource TrayPrimaryActionOverlay}"
                          HeightRequest="52"
                          Text=""
                          SemanticProperties.Description="End Break" />
                  <HorizontalStackLayout InputTransparent="True"
                                         HorizontalOptions="Center" VerticalOptions="Center"
                                         Spacing="8">
                    <Image Source="icon_coffee_white.png" WidthRequest="18" HeightRequest="18"
                           VerticalOptions="Center" />
                    <Label Text="End Break" FontSize="15" FontAttributes="Bold"
                           TextColor="White" VerticalOptions="Center" />
                  </HorizontalStackLayout>
                </Grid>
              </Border>

              <!-- Clock Out / Dashboard hide while on break — only End Break shows then -->
              <Button Grid.Column="1"
                      Text="Clock Out"
                      ImageSource="icon_power_white.png"
                      Command="{Binding ClockOutCommand}"
                      IsVisible="{Binding IsOnBreak, Converter={StaticResource InvertBoolConverter}}"
                      Style="{StaticResource RedPillButton}" />

              <Button Grid.Column="2"
                      Text="Dashboard"
                      ImageSource="icon_chart_blue.png"
                      Command="{Binding OpenDashboardCommand}"
                      IsVisible="{Binding IsOnBreak, Converter={StaticResource InvertBoolConverter}}"
                      Style="{StaticResource OutlineButton}"
                      HeightRequest="48"
                      CornerRadius="24"
                      FontSize="13" />
            </Grid>

            <Label Text="{Binding ErrorMessage}" TextColor="{StaticResource StatusRed}"
                   FontSize="12"
                   IsVisible="{Binding ErrorMessage, Converter={StaticResource IsNotNullConverter}}" />
            <Label Text="{Binding HintMessage}" TextColor="{StaticResource TextSecondary}"
                   FontSize="12"
                   IsVisible="{Binding IsOnBreak}" />
            <Label Text="{Binding SyncMessage}" TextColor="{StaticResource TextSecondary}"
                   FontSize="11"
                   IsVisible="{Binding SyncMessage, Converter={StaticResource IsNotNullConverter}}" />
            <ActivityIndicator IsRunning="{Binding IsBusyAction}"
                               IsVisible="{Binding IsBusyAction}"
                               Color="{StaticResource Primary}" />
          </VerticalStackLayout>
        </Grid>

        <!-- Today's Summary strip -->
        <Border Grid.Row="2" Style="{StaticResource TrayCompactGlassCard}" Margin="0,10,0,4" Padding="12,10">
          <VerticalStackLayout Spacing="10">
            <HorizontalStackLayout Spacing="8">
              <Image Source="icon_break_chart.png" WidthRequest="22" HeightRequest="22"
                     VerticalOptions="Center" />
              <VerticalStackLayout VerticalOptions="Center">
                <Label Text="Today's Summary" FontSize="13" FontAttributes="Bold"
                       TextColor="{StaticResource TextPrimary}" />
                <Label Text="Here's how your day is shaping up."
                       FontSize="10" TextColor="{StaticResource TextSecondary}" />
              </VerticalStackLayout>
            </HorizontalStackLayout>
            <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="8">
              <VerticalStackLayout Grid.Column="0" Spacing="2">
                <Label Text="Work Duration" FontSize="10" TextColor="{StaticResource TextSecondary}" />
                <Label Text="{Binding WorkDurationDisplay}" FontSize="14" FontAttributes="Bold"
                       TextColor="{StaticResource StatusGreen}" />
              </VerticalStackLayout>
              <VerticalStackLayout Grid.Column="1" Spacing="2">
                <Label Text="Break Time" FontSize="10" TextColor="{StaticResource TextSecondary}" />
                <Label Text="{Binding BreakTimeDisplay}" FontSize="14" FontAttributes="Bold"
                       TextColor="{StaticResource StatusOrange}" />
              </VerticalStackLayout>
              <VerticalStackLayout Grid.Column="2" Spacing="2">
                <Label Text="Productive Time" FontSize="10" TextColor="{StaticResource TextSecondary}" />
                <Label Text="{Binding ProductiveTimeDisplay}" FontSize="14" FontAttributes="Bold"
                       TextColor="{StaticResource Primary}" />
              </VerticalStackLayout>
              <VerticalStackLayout Grid.Column="3" Spacing="2">
                <Label Text="Idle Time" FontSize="10" TextColor="{StaticResource TextSecondary}" />
                <Label Text="{Binding IdleTimeDisplay}" FontSize="14" FontAttributes="Bold"
                       TextColor="{StaticResource TextPrimary}" />
              </VerticalStackLayout>
            </Grid>
          </VerticalStackLayout>
        </Border>

        <!-- Footer -->
        <Grid Grid.Row="3" ColumnDefinitions="Auto,*,Auto" Padding="0,4,0,0">
          <HorizontalStackLayout Grid.Column="0" Spacing="4">
            <Image Source="icon_break_settings.png" WidthRequest="14" HeightRequest="14"
                   VerticalOptions="Center" />
            <Label Text="Settings" FontSize="11"
                   TextColor="{StaticResource TextMuted}" VerticalOptions="Center" />
          </HorizontalStackLayout>
          <Label Grid.Column="1" Text="Version 1.0.0" FontSize="11"
                 TextColor="{StaticResource TextMuted}" HorizontalOptions="Center" />
          <HorizontalStackLayout Grid.Column="2" Spacing="6">
            <Image Source="icon_break_status.png" WidthRequest="10" HeightRequest="10"
                   VerticalOptions="Center" />
            <Label Text="Connected to OneXso Server" FontSize="11"
                   TextColor="{StaticResource TextSecondary}" />
          </HorizontalStackLayout>
        </Grid>
    </Grid>

    <!-- Break confirmation overlay -->
    <Grid IsVisible="{Binding IsBreakConfirmVisible}"
          BackgroundColor="#80000000">
      <Border Style="{StaticResource TrayCompactGlassCard}"
              WidthRequest="360"
              HorizontalOptions="Center"
              VerticalOptions="Center"
              Padding="24">
        <VerticalStackLayout Spacing="12">
          <Label Text="❓" FontSize="28" HorizontalOptions="Center" />
          <Label Text="Start Break?"
                 FontSize="18" FontAttributes="Bold"
                 TextColor="{StaticResource TextPrimary}"
                 HorizontalOptions="Center" />
          <Label Text="Your work timer will be paused and the break timer will begin."
                 FontSize="12" TextColor="{StaticResource TextSecondary}"
                 HorizontalTextAlignment="Center" />
          <Grid ColumnDefinitions="*,*" ColumnSpacing="10" Margin="0,8,0,0">
            <Button Grid.Column="0" Text="Cancel"
                    Command="{Binding CancelBreakConfirmCommand}"
                    Style="{StaticResource OutlineButton}"
                    HeightRequest="44" />
            <Button Grid.Column="1" Text="Start Break"
                    Command="{Binding ConfirmStartBreakCommand}"
                    BackgroundColor="{StaticResource Primary}"
                    TextColor="White"
                    FontAttributes="Bold"
                    CornerRadius="22"
                    HeightRequest="44" />
          </Grid>
        </VerticalStackLayout>
      </Border>
    </Grid>
  </Grid>
</ContentPage>
