<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:ONEVO.Agent.TrayApp.ViewModels"
             xmlns:controls="clr-namespace:ONEVO.Agent.TrayApp.Controls"
             x:Class="ONEVO.Agent.TrayApp.Views.ActiveSessionPage"
             x:DataType="vm:ActiveSessionViewModel"
             Shell.NavBarIsVisible="False"
             Title="OneXso WorkPulse">

  <Grid>
    <Grid RowDefinitions="*,Auto,Auto" Padding="28,16,28,12">
      <Grid.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
          <GradientStop Color="{StaticResource BackgroundWashStart}" Offset="0" />
          <GradientStop Color="{StaticResource BackgroundWashMid}" Offset="0.45" />
          <GradientStop Color="{StaticResource BackgroundWashEnd}" Offset="1" />
        </LinearGradientBrush>
      </Grid.Background>

      <Grid x:Name="PaneGrid" Grid.Row="0" ColumnDefinitions="*,*" ColumnSpacing="28">
        <Grid x:Name="LeftPane" Grid.Column="0">
          <Image Source="workspace_active.png" Aspect="AspectFit" HorizontalOptions="Fill" VerticalOptions="Center">
            <Image.Triggers>
              <DataTrigger TargetType="Image" Binding="{Binding IsOnBreak}" Value="True">
                <Setter Property="Source" Value="break_hero.png" />
              </DataTrigger>
            </Image.Triggers>
          </Image>
        </Grid>

        <VerticalStackLayout x:Name="RightPane" Grid.Column="1" VerticalOptions="Center" Spacing="8">
          <HorizontalStackLayout Spacing="8">
            <Label Text="{Binding HeaderLead}" FontSize="26" FontAttributes="Bold" TextColor="{StaticResource TextPrimary}" />
            <Label Text="{Binding HeaderAccent}" FontSize="26" FontAttributes="Bold" TextColor="{StaticResource BrandTitle}">
              <Label.Triggers>
                <DataTrigger TargetType="Label" Binding="{Binding IsOnBreak}" Value="True">
                  <Setter Property="TextColor" Value="{StaticResource BreakAccent}" />
                </DataTrigger>
                <DataTrigger TargetType="Label" Binding="{Binding IsBackToWork}" Value="True">
                  <Setter Property="TextColor" Value="{StaticResource Primary}" />
                </DataTrigger>
              </Label.Triggers>
            </Label>
          </HorizontalStackLayout>
          <Label Text="{Binding HeaderSubtitle}" FontSize="14" TextColor="{StaticResource TextSecondary}" />

          <Border Style="{StaticResource TrayCompactGlassCard}" Padding="16,8">
            <VerticalStackLayout Spacing="0">
              <Grid ColumnDefinitions="36,*" Padding="0,10" ColumnSpacing="10">
                <Grid HorizontalOptions="Center" VerticalOptions="Center">
                  <Ellipse x:Name="StatusDot" WidthRequest="22" HeightRequest="22" HorizontalOptions="Center" VerticalOptions="Center"
                           IsVisible="{Binding IsOnBreak, Converter={StaticResource InvertBoolConverter}}">
                    <Ellipse.Fill>
                      <SolidColorBrush Color="{StaticResource StatusGreen}" />
                    </Ellipse.Fill>
                  </Ellipse>
                  <Image Source="icon3d_coffee.png" WidthRequest="32" HeightRequest="32" Aspect="AspectFit"
                         HorizontalOptions="Center" VerticalOptions="Center" IsVisible="{Binding IsOnBreak}" />
                </Grid>
                <VerticalStackLayout Grid.Column="1">
                  <Label Text="Status" Style="{StaticResource StatLabel}" />
                  <Label Text="{Binding StatusText}" FontSize="15" FontAttributes="Bold" TextColor="{StaticResource StatusGreen}">
                    <Label.Triggers>
                      <DataTrigger TargetType="Label" Binding="{Binding IsOnBreak}" Value="True">
                        <Setter Property="TextColor" Value="{StaticResource BreakAccent}" />
                      </DataTrigger>
                    </Label.Triggers>
                  </Label>
                </VerticalStackLayout>
              </Grid>
              <BoxView HeightRequest="1" BackgroundColor="{StaticResource Separator}" />
              <Grid ColumnDefinitions="36,*" Padding="0,10" ColumnSpacing="10" IsVisible="{Binding ShowWorkingActions}">
                <Image Source="icon_clock.png" WidthRequest="32" HeightRequest="32" Aspect="AspectFit" HorizontalOptions="Center" VerticalOptions="Center" />
                <VerticalStackLayout Grid.Column="1">
                  <Label Text="Start Time" Style="{StaticResource StatLabel}" />
                  <Label Text="{Binding StartTimeDisplay}" Style="{StaticResource FieldValue}" />
                </VerticalStackLayout>
              </Grid>
              <BoxView HeightRequest="1" BackgroundColor="{StaticResource Separator}" IsVisible="{Binding ShowWorkingActions}" />
              <Grid ColumnDefinitions="36,*" Padding="0,10" ColumnSpacing="10" IsVisible="{Binding ShowBackToWorkActions}">
                <Image Source="icon_clock.png" WidthRequest="32" HeightRequest="32" Aspect="AspectFit" HorizontalOptions="Center" VerticalOptions="Center" />
                <VerticalStackLayout Grid.Column="1">
                  <Label Text="Break ended at" Style="{StaticResource StatLabel}" />
                  <Label Text="{Binding BreakEndedAtDisplay}" Style="{StaticResource FieldValue}" />
                </VerticalStackLayout>
              </Grid>
              <BoxView HeightRequest="1" BackgroundColor="{StaticResource Separator}" IsVisible="{Binding ShowBackToWorkActions}" />
              <Grid ColumnDefinitions="36,*" Padding="0,10" ColumnSpacing="10" IsVisible="{Binding ShowBackToWorkActions}">
                <Image Source="icon3d_coffee.png" WidthRequest="32" HeightRequest="32" Aspect="AspectFit" HorizontalOptions="Center" VerticalOptions="Center" />
                <VerticalStackLayout Grid.Column="1">
                  <Label Text="Break duration" Style="{StaticResource StatLabel}" />
                  <Label Text="{Binding LastBreakDurationDisplay}" Style="{StaticResource FieldValue}" />
                </VerticalStackLayout>
              </Grid>
              <BoxView HeightRequest="1" BackgroundColor="{StaticResource Separator}" IsVisible="{Binding ShowBackToWorkActions}" />
              <Grid ColumnDefinitions="36,*" Padding="0,10" ColumnSpacing="10">
                <Image Source="icon_stopwatch.png" WidthRequest="32" HeightRequest="32" Aspect="AspectFit" HorizontalOptions="Center" VerticalOptions="Center">
                  <Image.Triggers>
                    <DataTrigger TargetType="Image" Binding="{Binding IsOnBreak}" Value="True">
                      <Setter Property="Source" Value="icon3d_coffee.png" />
                    </DataTrigger>
                  </Image.Triggers>
                </Image>
                <VerticalStackLayout Grid.Column="1">
                  <Label Text="{Binding PrimaryTimerLabel}" Style="{StaticResource StatLabel}" />
                  <Label Text="{Binding PrimaryTimer}" FontSize="20" FontAttributes="Bold" TextColor="{StaticResource StatusGreen}">
                    <Label.Triggers>
                      <DataTrigger TargetType="Label" Binding="{Binding IsOnBreak}" Value="True">
                        <Setter Property="TextColor" Value="{StaticResource BreakAccent}" />
                      </DataTrigger>
                    </Label.Triggers>
                  </Label>
                </VerticalStackLayout>
              </Grid>
              <BoxView HeightRequest="1" BackgroundColor="{StaticResource Separator}" IsVisible="{Binding IsOnBreak}" />
              <Grid ColumnDefinitions="36,*" Padding="0,10" ColumnSpacing="10" IsVisible="{Binding IsOnBreak}">
                <Image Source="icon_clock.png" WidthRequest="32" HeightRequest="32" Aspect="AspectFit" HorizontalOptions="Center" VerticalOptions="Center" />
                <VerticalStackLayout Grid.Column="1">
                  <Label Text="Start Time" Style="{StaticResource StatLabel}" />
                  <Label Text="{Binding StartTimeDisplay}" Style="{StaticResource FieldValue}" />
                </VerticalStackLayout>
              </Grid>
              <BoxView HeightRequest="1" BackgroundColor="{StaticResource Separator}" />
              <Grid ColumnDefinitions="36,*" Padding="0,10" ColumnSpacing="10">
                <Image Source="icon_calendar.png" WidthRequest="32" HeightRequest="32" Aspect="AspectFit" HorizontalOptions="Center" VerticalOptions="Center" />
                <VerticalStackLayout Grid.Column="1">
                  <Label Text="Today's Schedule" Style="{StaticResource StatLabel}" />
                  <Label Text="{Binding ScheduleDisplay}" Style="{StaticResource FieldValue}" />
                </VerticalStackLayout>
              </Grid>
              <BoxView HeightRequest="1" BackgroundColor="{StaticResource Separator}" IsVisible="{Binding ShowWorkingActions}" />
              <Grid ColumnDefinitions="36,*" Padding="0,10" ColumnSpacing="10" IsVisible="{Binding ShowWorkingActions}">
                <Image Source="icon_pin.png" WidthRequest="32" HeightRequest="32" Aspect="AspectFit" HorizontalOptions="Center" VerticalOptions="Center">
                  <Image.Triggers>
                    <DataTrigger TargetType="Image" Binding="{Binding WorkLocationDisplay}" Value="Work From Home">
                      <Setter Property="Source" Value="icon_home.png" />
                    </DataTrigger>
                  </Image.Triggers>
                </Image>
                <VerticalStackLayout Grid.Column="1">
                  <Label Text="Work Location" Style="{StaticResource StatLabel}" />
                  <Label Text="{Binding WorkLocationDisplay}" Style="{StaticResource FieldValue}" />
                </VerticalStackLayout>
              </Grid>
            </VerticalStackLayout>
          </Border>

          <HorizontalStackLayout Spacing="6" IsVisible="{Binding IsOnBreak, Converter={StaticResource InvertBoolConverter}}">
            <Image Source="icon3d_info.png" WidthRequest="16" HeightRequest="16" Aspect="AspectFit" VerticalOptions="Center" />
            <Label Text="{Binding HintMessage}" FontSize="14" TextColor="{StaticResource TextSecondary}" VerticalOptions="Center" />
          </HorizontalStackLayout>

          <Grid ColumnDefinitions="*,*" ColumnSpacing="10" IsVisible="{Binding ShowBackToWorkActions}">
            <Border Grid.Column="0" Style="{StaticResource TrayPrimaryActionBorder}" StrokeShape="RoundRectangle 16">
              <Border.Background>
                <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                  <GradientStop Color="{StaticResource ConnectButtonStart}" Offset="0" />
                  <GradientStop Color="{StaticResource ConnectButtonMid}" Offset="0.55" />
                  <GradientStop Color="{StaticResource ConnectButtonEnd}" Offset="1" />
                </LinearGradientBrush>
              </Border.Background>
              <Grid>
                <Button Command="{Binding OpenDashboardCommand}" Style="{StaticResource TrayPrimaryActionOverlay}" Text="" SemanticProperties.Description="Open Dashboard" />
                <HorizontalStackLayout InputTransparent="True" HorizontalOptions="Center" VerticalOptions="Center" Spacing="8">
                  <Label Text="{StaticResource IconGlobe}" FontFamily="Segoe MDL2 Assets" FontSize="15" TextColor="White" VerticalOptions="Center" />
                  <Label Text="Open Dashboard" FontSize="15" FontAttributes="Bold" TextColor="White" />
                </HorizontalStackLayout>
              </Grid>
            </Border>
            <Border Grid.Column="1" Style="{StaticResource TraySecondaryActionBorder}" StrokeShape="RoundRectangle 16">
              <Grid>
                <Button Command="{Binding ContinueWorkingCommand}" Style="{StaticResource TrayPrimaryActionOverlay}" Text="" SemanticProperties.Description="Continue Working" />
                <HorizontalStackLayout InputTransparent="True" HorizontalOptions="Center" VerticalOptions="Center" Spacing="8">
                  <Image Source="icon3d_play.png" WidthRequest="18" HeightRequest="18" Aspect="AspectFit" VerticalOptions="Center" />
                  <Label Text="Continue Working" Style="{StaticResource ButtonLabelOutline}" />
                </HorizontalStackLayout>
              </Grid>
            </Border>
          </Grid>

          <Grid ColumnDefinitions="*,*" ColumnSpacing="10" IsVisible="{Binding ShowWorkingActions}">
            <Border Grid.Column="0" Style="{StaticResource TrayPrimaryActionBorder}" StrokeShape="RoundRectangle 16">
              <Border.Background>
                <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                  <GradientStop Color="{StaticResource ConnectButtonStart}" Offset="0" />
                  <GradientStop Color="{StaticResource ConnectButtonMid}" Offset="0.55" />
                  <GradientStop Color="{StaticResource ConnectButtonEnd}" Offset="1" />
                </LinearGradientBrush>
              </Border.Background>
              <Grid>
                <Button Command="{Binding OpenDashboardCommand}" Style="{StaticResource TrayPrimaryActionOverlay}" Text="" SemanticProperties.Description="Open Dashboard" />
                <HorizontalStackLayout InputTransparent="True" HorizontalOptions="Center" VerticalOptions="Center" Spacing="8">
                  <Label Text="{StaticResource IconGlobe}" FontFamily="Segoe MDL2 Assets" FontSize="15" TextColor="White" VerticalOptions="Center" />
                  <Label Text="Open Dashboard" FontSize="15" FontAttributes="Bold" TextColor="White" />
                </HorizontalStackLayout>
              </Grid>
            </Border>
            <Border Grid.Column="1" Style="{StaticResource TraySecondaryActionBorder}" StrokeShape="RoundRectangle 16">
              <Grid>
                <Button Command="{Binding RequestBreakCommand}" Style="{StaticResource TrayPrimaryActionOverlay}" Text="" SemanticProperties.Description="Start Break Later" />
                <HorizontalStackLayout InputTransparent="True" HorizontalOptions="Center" VerticalOptions="Center" Spacing="8">
                  <Label Text="{StaticResource IconClock}" FontFamily="Segoe MDL2 Assets" FontSize="15" TextColor="{StaticResource Primary}" VerticalOptions="Center" />
                  <Label Text="Start Break Later" Style="{StaticResource ButtonLabelOutline}" />
                </HorizontalStackLayout>
              </Grid>
            </Border>
          </Grid>

          <Border Style="{StaticResource OrangeGradientButtonBorder}" StrokeShape="RoundRectangle 16" IsVisible="{Binding IsOnBreak}">
            <Grid>
              <Button Command="{Binding RequestEndBreakCommand}" Style="{StaticResource TrayPrimaryActionOverlay}" HeightRequest="52" Text="" SemanticProperties.Description="End Break" />
              <HorizontalStackLayout InputTransparent="True" HorizontalOptions="Center" VerticalOptions="Center" Spacing="8">
                <Label Text="{StaticResource IconCafe}" FontFamily="Segoe MDL2 Assets" FontSize="16" TextColor="White" VerticalOptions="Center" />
                <Label Text="End Break" FontSize="15" FontAttributes="Bold" TextColor="White" />
              </HorizontalStackLayout>
            </Grid>
          </Border>

          <HorizontalStackLayout Spacing="6" IsVisible="{Binding IsOnBreak}">
            <Image Source="icon3d_info.png" WidthRequest="16" HeightRequest="16" Aspect="AspectFit" VerticalOptions="Center" />
            <Label Text="{Binding HintMessage}" FontSize="14" TextColor="{StaticResource TextSecondary}" VerticalOptions="Center" />
          </HorizontalStackLayout>

          <Border Style="{StaticResource TraySecondaryActionBorder}" StrokeShape="RoundRectangle 16"
                  StrokeThickness="0"
                  IsVisible="{Binding ShowClockOutAction}">
            <Border.Background>
              <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                <GradientStop Color="{StaticResource ButtonRed}" Offset="0" />
                <GradientStop Color="{StaticResource ButtonRedEnd}" Offset="1" />
              </LinearGradientBrush>
            </Border.Background>
            <Grid>
              <Button Command="{Binding RequestClockOutCommand}" Style="{StaticResource TrayPrimaryActionOverlay}" Text="" SemanticProperties.Description="Clock Out" />
              <HorizontalStackLayout InputTransparent="True" HorizontalOptions="Center" VerticalOptions="Center" Spacing="8">
                <Label Text="{StaticResource IconPower}" FontFamily="Segoe MDL2 Assets" FontSize="16" TextColor="White" VerticalOptions="Center" />
                <Label Text="Clock Out" FontSize="15" FontAttributes="Bold" TextColor="White" />
              </HorizontalStackLayout>
            </Grid>
          </Border>

          <HorizontalStackLayout Spacing="6" HorizontalOptions="Center" IsVisible="{Binding IsRemoteWorkMode}">
            <Button Text="Request Location Change" Command="{Binding RequestLocationChangeCommand}"
                    Style="{StaticResource OutlineButton}" FontSize="13" Padding="12,6" HeightRequest="34" />
          </HorizontalStackLayout>
          <Label Text="{Binding LocationChangeStatusMessage}" TextColor="{StaticResource StatusGreen}" FontSize="13"
                 HorizontalTextAlignment="Center"
                 IsVisible="{Binding LocationChangeStatusMessage, Converter={StaticResource IsNotNullConverter}}" />

          <Label Text="{Binding ErrorMessage}" TextColor="{StaticResource StatusRed}" FontSize="14"
                 IsVisible="{Binding ErrorMessage, Converter={StaticResource IsNotNullConverter}}" />
          <ActivityIndicator IsRunning="{Binding IsBusyAction}" IsVisible="{Binding IsBusyAction}" Color="{StaticResource Primary}" />
        </VerticalStackLayout>
      </Grid>

      <Border Grid.Row="1" Style="{StaticResource TrayCompactGlassCard}" Padding="14,10" Margin="0,8,0,0" IsVisible="{Binding IsOnBreak}">
        <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="8">
          <HorizontalStackLayout Grid.Column="0" Spacing="8" VerticalOptions="Center">
            <Image Source="icon3d_chart.png" WidthRequest="32" HeightRequest="32" Aspect="AspectFit" VerticalOptions="Center" />
            <Label Text="Today's Summary" Style="{StaticResource SectionTitle}" FontSize="13" VerticalOptions="Center" LineBreakMode="TailTruncation" MaxLines="1" />
          </HorizontalStackLayout>
          <HorizontalStackLayout Grid.Column="1" Spacing="8" VerticalOptions="Center">
            <Image Source="icon_clock.png" WidthRequest="32" HeightRequest="32" Aspect="AspectFit" VerticalOptions="Center" />
            <VerticalStackLayout Spacing="0">
              <Label Text="Work Duration So Far" Style="{StaticResource StatLabel}" />
              <Label Text="{Binding WorkDurationDisplay}" Style="{StaticResource FieldValue}" TextColor="{StaticResource Primary}" />
              <Label Text="{Binding WorkStartedCaption}" Style="{StaticResource DeltaNeutral}" />
            </VerticalStackLayout>
          </HorizontalStackLayout>
          <HorizontalStackLayout Grid.Column="2" Spacing="8" VerticalOptions="Center">
            <Image Source="icon3d_coffee.png" WidthRequest="32" HeightRequest="32" Aspect="AspectFit" VerticalOptions="Center" />
            <VerticalStackLayout Spacing="0">
              <Label Text="Break Sessions Today" Style="{StaticResource StatLabel}" />
              <Label Text="{Binding BreakSessionsDisplay}" Style="{StaticResource FieldValue}" TextColor="{StaticResource BreakAccent}" />
              <Label Text="{Binding BreakTotalCaption}" Style="{StaticResource DeltaNeutral}" />
            </VerticalStackLayout>
          </HorizontalStackLayout>
          <HorizontalStackLayout Grid.Column="3" Spacing="8" VerticalOptions="Center">
            <Image Source="icon3d_chart.png" WidthRequest="32" HeightRequest="32" Aspect="AspectFit" VerticalOptions="Center" />
            <VerticalStackLayout Spacing="0">
              <Label Text="Productive Time" Style="{StaticResource StatLabel}" />
              <Label Text="{Binding ProductiveTimeDisplay}" Style="{StaticResource FieldValue}" TextColor="{StaticResource StatusGreen}" />
              <Label Text="{Binding ProductiveShareCaption}" Style="{StaticResource DeltaNeutral}" />
            </VerticalStackLayout>
          </HorizontalStackLayout>
        </Grid>
      </Border>

      <controls:FooterStatusBar Grid.Row="2" VersionText="Version 1.0.0" ConnectionLabel="Connected" IsConnected="True" />
    </Grid>

    <controls:GlassConfirmHost IsOpen="{Binding IsBreakConfirmVisible}"
                               Title="Start Break?"
                               Message="Your work timer will pause and your break timer will begin."
                               BadgeImage="icon3d_coffee.png"
                               CancelCommand="{Binding CancelBreakConfirmCommand}"
                               ConfirmCommand="{Binding ConfirmStartBreakCommand}"
                               ConfirmText="Start Break">
      <controls:GlassConfirmHost.Body>
        <VerticalStackLayout Spacing="0">
          <controls:PopupInfoRow IconImage="icon3d_status.png"
                                 Prefix="Current status: "
                                 Value="Working"
                                 ValueColor="{StaticResource StatusGreen}" />
          <controls:PopupInfoRow IconImage="icon3d_calendar.png"
                                 Prefix="Today's schedule: "
                                 Value="{Binding ScheduleDisplay}" />
          <controls:PopupInfoRow IconImage="icon3d_clock.png"
                                 Caption="Break tracking will start now."
                                 ShowDivider="False" />
        </VerticalStackLayout>
      </controls:GlassConfirmHost.Body>
    </controls:GlassConfirmHost>

    <controls:GlassConfirmHost IsOpen="{Binding IsEndBreakConfirmVisible}"
                               Title="End Break?"
                               Message="Your break will end and your work timer will resume."
                               BadgeImage="icon3d_clock.png"
                               CancelCommand="{Binding CancelEndBreakConfirmCommand}"
                               ConfirmCommand="{Binding EndBreakCommand}"
                               ConfirmText="End Break">
      <controls:GlassConfirmHost.Body>
        <VerticalStackLayout Spacing="0">
          <controls:PopupInfoRow IconImage="icon3d_coffee.png"
                                 Prefix="Break status: "
                                 Value="Active"
                                 ValueColor="{StaticResource BreakAccent}" />
          <controls:PopupInfoRow IconImage="icon3d_stopwatch.png"
                                 Prefix="Break timer: "
                                 Value="{Binding PrimaryTimer}"
                                 ValueColor="{StaticResource BrandTitle}" />
          <controls:PopupInfoRow IconImage="icon3d_play.png"
                                 Caption="Work session will resume immediately."
                                 ShowDivider="False" />
        </VerticalStackLayout>
      </controls:GlassConfirmHost.Body>
    </controls:GlassConfirmHost>

    <controls:GlassConfirmHost IsOpen="{Binding IsClockOutConfirmVisible}"
                               Title="Clock Out?"
                               Message="Are you sure you want to end your workday? Your current work session will end and attendance will be recorded."
                               BadgeImage="icon3d_clockout.png"
                               CardWidth="480"
                               CancelCommand="{Binding CancelClockOutConfirmCommand}"
                               ConfirmCommand="{Binding ClockOutCommand}"
                               ConfirmText="Clock Out">
      <controls:GlassConfirmHost.Body>
        <VerticalStackLayout Spacing="0">
          <controls:PopupInfoRow IconImage="icon3d_status.png"
                                 Prefix="Current Status: "
                                 Value="{Binding StatusText}"
                                 ValueColor="{StaticResource StatusGreen}" />
          <controls:PopupInfoRow IconImage="icon3d_clock.png"
                                 Prefix="Since "
                                 Value="{Binding StartTimeDisplay}" />
          <controls:PopupInfoRow IconImage="icon3d_clock.png"
                                 Prefix="Today's Work Duration: "
                                 Value="{Binding WorkDurationDisplay}" />
          <controls:PopupInfoRow IconImage="icon3d_coffee.png"
                                 Prefix="Total Break Time: "
                                 Value="{Binding BreakTimeDisplay}" />
          <controls:PopupInfoRow IconImage="icon3d_chart.png"
                                 Prefix="Productive Time: "
                                 Value="{Binding ProductiveTimeDisplay}"
                                 ShowDivider="False" />
        </VerticalStackLayout>
      </controls:GlassConfirmHost.Body>
    </controls:GlassConfirmHost>

    <controls:GlassConfirmHost IsOpen="{Binding IsRequestLocationChangeFormVisible}"
                               Title="Request Location Change"
                               Message="This captures your current location and sends it to your manager for approval. Your saved work location won't change until you accept it on a later clock-in."
                               CancelCommand="{Binding CancelRequestLocationChangeCommand}"
                               ConfirmCommand="{Binding SubmitLocationChangeCommand}"
                               ConfirmText="Submit Request">
      <controls:GlassConfirmHost.Body>
        <VerticalStackLayout Spacing="8">
          <Label Text="Reason" Style="{StaticResource StatLabel}" />
          <Editor Text="{Binding LocationChangeReason}" Placeholder="Why are you working from a new location?"
                  HeightRequest="80" AutoSize="TextChanges" />
          <Label Text="{Binding LocationChangeError}" TextColor="{StaticResource StatusRed}" FontSize="13"
                 IsVisible="{Binding LocationChangeError, Converter={StaticResource IsNotNullConverter}}" />
          <ActivityIndicator IsRunning="{Binding IsSubmittingLocationChange}" IsVisible="{Binding IsSubmittingLocationChange}" Color="{StaticResource Primary}" />
        </VerticalStackLayout>
      </controls:GlassConfirmHost.Body>
    </controls:GlassConfirmHost>

    <controls:GlassConfirmHost IsOpen="{Binding IsLocationChangePromptVisible}"
                               Title="Save This as Your New Location?"
                               Message="Your location change request was approved. Save it as your new registered work location? If you choose not now, you'll be asked again on your next clock-in."
                               CancelCommand="{Binding DismissLocationChangePromptCommand}"
                               CancelText="Not Now"
                               ConfirmCommand="{Binding ConfirmLocationChangePromptCommand}"
                               ConfirmText="Save as New Location">
      <controls:GlassConfirmHost.Body>
        <ActivityIndicator IsRunning="{Binding IsRespondingToLocationChangePrompt}" IsVisible="{Binding IsRespondingToLocationChangePrompt}" Color="{StaticResource Primary}" />
      </controls:GlassConfirmHost.Body>
    </controls:GlassConfirmHost>
  </Grid>
</ContentPage>
