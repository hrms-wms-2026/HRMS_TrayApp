<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:ONEVO.Agent.TrayApp.ViewModels"
             xmlns:controls="clr-namespace:ONEVO.Agent.TrayApp.Controls"
             xmlns:ipc="clr-namespace:ONEVO.Agent.Shared.IPC;assembly=ONEVO.Agent.Shared"
             x:Class="ONEVO.Agent.TrayApp.Views.LegalConsentPage"
             x:DataType="vm:LegalConsentViewModel"
             x:Name="RootPage"
             Shell.NavBarIsVisible="False"
             Title="OneXso WorkPulse">

  <Grid RowDefinitions="*,Auto" Padding="28,16,28,12">
    <Grid.Background>
      <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="{StaticResource BackgroundWashStart}" Offset="0" />
        <GradientStop Color="{StaticResource BackgroundWashMid}" Offset="0.45" />
        <GradientStop Color="{StaticResource BackgroundWashEnd}" Offset="1" />
      </LinearGradientBrush>
    </Grid.Background>

    <Grid x:Name="PaneGrid" Grid.Row="0" ColumnDefinitions="*,*" ColumnSpacing="28">
      <Image x:Name="LeftPane" Grid.Column="0" Source="workspace_privacy.png" Aspect="AspectFit" VerticalOptions="Center" />

      <VerticalStackLayout x:Name="RightPane" Grid.Column="1" VerticalOptions="Center" Spacing="0">
        <Label Margin="0,0,0,6">
          <Label.FormattedText>
            <FormattedString>
              <Span Text="Before You " FontSize="26" FontAttributes="Bold" TextColor="{StaticResource TextPrimary}" />
              <Span Text="Continue" FontSize="26" FontAttributes="Bold" TextColor="{StaticResource BrandTitle}" />
            </FormattedString>
          </Label.FormattedText>
        </Label>
        <Label Text="Please review and accept the updated terms to continue to your workspace."
               Style="{StaticResource PageSubtitle}" HorizontalTextAlignment="Start" Margin="0,0,0,14" />

        <VerticalStackLayout Spacing="10" Margin="0,0,0,14"
                              BindableLayout.ItemsSource="{Binding PendingDocuments}">
          <BindableLayout.ItemTemplate>
            <DataTemplate x:DataType="ipc:PendingLegalDocumentPayload">
              <Border Style="{StaticResource TrayCompactGlassCard}" Padding="16,14" StrokeShape="RoundRectangle 20">
                <Grid ColumnDefinitions="40,*,Auto" ColumnSpacing="12">
                  <Border Grid.Column="0" Style="{StaticResource IconTile}" BackgroundColor="{StaticResource AccentSoft}">
                    <Image Source="icon_shield_policy.png" WidthRequest="18" HeightRequest="18"
                           HorizontalOptions="Center" VerticalOptions="Center" />
                  </Border>
                  <VerticalStackLayout Grid.Column="1" Spacing="1" VerticalOptions="Center">
                    <Label Text="{Binding Title}" FontAttributes="Bold" FontSize="15" TextColor="{StaticResource TextPrimary}" />
                    <Label FontSize="14" TextColor="{StaticResource TextSecondary}">
                      <Label.FormattedText>
                        <FormattedString>
                          <Span Text="Version " />
                          <Span Text="{Binding Version}" />
                        </FormattedString>
                      </Label.FormattedText>
                    </Label>
                  </VerticalStackLayout>
                  <Button Grid.Column="2" Text="View" FontSize="13"
                          IsVisible="{Binding ContentUrl, Converter={StaticResource IsNotNullConverter}}"
                          BackgroundColor="Transparent" TextColor="{StaticResource Primary}" BorderWidth="0"
                          VerticalOptions="Center"
                          Command="{Binding Source={x:Reference RootPage}, Path=BindingContext.OpenDocumentCommand}"
                          CommandParameter="{Binding .}" />
                </Grid>
              </Border>
            </DataTemplate>
          </BindableLayout.ItemTemplate>
        </VerticalStackLayout>

        <Label Text="{Binding ErrorMessage}" IsVisible="{Binding ErrorMessage, Converter={StaticResource IsNotNullConverter}}"
               TextColor="{StaticResource StatusRed}" FontSize="14" Margin="0,0,0,10" LineBreakMode="WordWrap" />

        <Border Style="{StaticResource TrayPrimaryActionBorder}" Margin="0,0,0,8">
          <Border.Background>
            <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
              <GradientStop Color="{StaticResource ConnectButtonStart}" Offset="0" />
              <GradientStop Color="{StaticResource ConnectButtonMid}" Offset="0.55" />
              <GradientStop Color="{StaticResource ConnectButtonEnd}" Offset="1" />
            </LinearGradientBrush>
          </Border.Background>
          <Grid>
            <Button Command="{Binding AcceptCommand}" IsEnabled="{Binding IsNotBusy}"
                    Style="{StaticResource TrayPrimaryActionOverlay}" Text="" SemanticProperties.Description="Accept and continue" />
            <Label InputTransparent="True" Text="Accepting…" IsVisible="{Binding IsSubmitting}"
                   FontSize="15" FontAttributes="Bold" TextColor="White" HorizontalOptions="Center" VerticalOptions="Center" />
            <Label InputTransparent="True" Text="Accept and continue" IsVisible="{Binding IsSubmitting, Converter={StaticResource InvertBoolConverter}}"
                   FontSize="15" FontAttributes="Bold" TextColor="White" HorizontalOptions="Center" VerticalOptions="Center" />
          </Grid>
        </Border>
      </VerticalStackLayout>
    </Grid>

    <controls:FooterStatusBar Grid.Row="1" VersionText="Version 1.0.0" ConnectionLabel="Connected" IsConnected="True" />
  </Grid>
</ContentPage>
