<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:ONEVO.Agent.TrayApp.ViewModels"
             x:Class="ONEVO.Agent.TrayApp.Views.ClockInPage"
             x:DataType="vm:ClockInViewModel"
             BackgroundColor="White">

  <Grid RowDefinitions="Auto,*,Auto,Auto" Padding="20,16">

    <!-- ── Header ─────────────────────────────────────────────────────── -->
    <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto" Margin="0,0,0,12">
      <HorizontalStackLayout Grid.Column="0" Spacing="12">

        <!-- Onexso logo -->
        <Border WidthRequest="42" HeightRequest="42"
                StrokeShape="RoundRectangle 13" StrokeThickness="0"
                BackgroundColor="Transparent">
          <Image Source="logo_onexso.png"
                 Aspect="AspectFit"
                 WidthRequest="42" HeightRequest="42"
                 HorizontalOptions="Center" VerticalOptions="Center" />
        </Border>

        <VerticalStackLayout VerticalOptions="Center" Spacing="1">
          <Label Text="Onexso Workspace" FontSize="14" FontAttributes="Bold"
                 TextColor="{StaticResource TextPrimary}" />
          <Label Text="Your Workplace. Simplified."
                 FontSize="10" TextColor="{StaticResource TextSecondary}" />
        </VerticalStackLayout>
      </HorizontalStackLayout>

      <Label Grid.Column="2" Text="•••" FontSize="22"
             TextColor="{StaticResource TextMuted}" VerticalOptions="Center" />
    </Grid>

    <!-- ── Main body ──────────────────────────────────────────────────── -->
    <ScrollView Grid.Row="1">
    <Grid x:Name="PaneGrid" ColumnDefinitions="*,*" ColumnSpacing="24">

      <!-- LEFT: greeting + date/time + illustration ───────────────────── -->
      <VerticalStackLayout x:Name="LeftPane" Grid.Column="0" Spacing="0">

        <!-- "Good Morning, Pirakeerthan 👋" -->
        <HorizontalStackLayout Spacing="0" Margin="0,0,0,6">
          <Label Text="{Binding Greeting}"
                 FontSize="26" FontAttributes="Bold"
                 TextColor="{StaticResource TextPrimary}" />
          <Label Text=", "
                 FontSize="26" FontAttributes="Bold"
                 TextColor="{StaticResource TextPrimary}" />
          <Label Text="{Binding EmployeeName}"
                 FontSize="26" FontAttributes="Bold"
                 TextColor="{StaticResource Primary}" />
          <Label Text=" 👋" FontSize="24" VerticalOptions="Center" Margin="2,0,0,0" />
        </HorizontalStackLayout>

        <Label Text="Welcome back to Onexso Workspace."
               FontSize="13" TextColor="{StaticResource TextSecondary}" Margin="0,0,0,2" />
        <Label Text="Ready to begin your workday?"
               FontSize="13" TextColor="{StaticResource TextSecondary}" Margin="0,0,0,18" />

        <!-- Date + Time cards -->
        <Grid ColumnDefinitions="*,*" ColumnSpacing="12" Margin="0,0,0,18">

          <Border Grid.Column="0" BackgroundColor="White"
                  StrokeShape="RoundRectangle 16" Stroke="{StaticResource Separator}"
                  StrokeThickness="1" Padding="14,12">
            <Border.Shadow>
              <Shadow Brush="#10000040" Offset="0,3" Radius="10" Opacity="0.1" />
            </Border.Shadow>
            <HorizontalStackLayout Spacing="10">
              <Border WidthRequest="36" HeightRequest="36"
                      StrokeShape="RoundRectangle 10" StrokeThickness="0"
                      BackgroundColor="#EEF4FF" VerticalOptions="Center">
                <Label Text="📅" FontSize="17"
                       HorizontalOptions="Center" VerticalOptions="Center" />
              </Border>
              <VerticalStackLayout Spacing="2" VerticalOptions="Center">
                <Label Text="Today's Date" FontSize="10"
                       TextColor="{StaticResource TextSecondary}" />
                <Label Text="{Binding CurrentDateDisplay}"
                       FontSize="12" FontAttributes="Bold"
                       TextColor="{StaticResource Primary}"
                       LineBreakMode="TailTruncation" />
              </VerticalStackLayout>
            </HorizontalStackLayout>
          </Border>

          <Border Grid.Column="1" BackgroundColor="White"
                  StrokeShape="RoundRectangle 16" Stroke="{StaticResource Separator}"
                  StrokeThickness="1" Padding="14,12">
            <Border.Shadow>
              <Shadow Brush="#10000040" Offset="0,3" Radius="10" Opacity="0.1" />
            </Border.Shadow>
            <HorizontalStackLayout Spacing="10">
              <Border WidthRequest="36" HeightRequest="36"
                      StrokeShape="RoundRectangle 10" StrokeThickness="0"
                      BackgroundColor="#EEF4FF" VerticalOptions="Center">
                <Label Text="🕐" FontSize="17"
                       HorizontalOptions="Center" VerticalOptions="Center" />
              </Border>
              <VerticalStackLayout Spacing="2" VerticalOptions="Center">
                <Label Text="Current Time" FontSize="10"
                       TextColor="{StaticResource TextSecondary}" />
                <Label Text="{Binding CurrentTimeDisplay}"
                       FontSize="14" FontAttributes="Bold"
                       TextColor="{StaticResource Primary}" />
              </VerticalStackLayout>
            </HorizontalStackLayout>
          </Border>
        </Grid>

        <!-- Illustration card — gradient canvas + emoji scene -->
        <Border StrokeShape="RoundRectangle 20" StrokeThickness="1"
                Stroke="{StaticResource Separator}"
                Padding="0" VerticalOptions="FillAndExpand">
          <Border.Shadow>
            <Shadow Brush="#10000040" Offset="0,4" Radius="14" Opacity="0.1" />
          </Border.Shadow>
          <!-- ClipToBounds is not a MAUI Grid property (WPF-only); parent Border StrokeShape clips. -->
          <Grid>
            <Grid.Background>
              <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#ECF2FF" Offset="0" />
                <GradientStop Color="#F2ECFF" Offset="1" />
              </LinearGradientBrush>
            </Grid.Background>

            <!-- Decorative blobs -->
            <Ellipse WidthRequest="180" HeightRequest="180"
                     HorizontalOptions="Start" VerticalOptions="End"
                     Margin="-60,0,0,20" Opacity="0.16">
              <Ellipse.Fill>
                <RadialGradientBrush Center="0.5,0.5" Radius="0.5">
                  <GradientStop Color="#7B3FE4" Offset="0" />
                  <GradientStop Color="#7B3FE400" Offset="1" />
                </RadialGradientBrush>
              </Ellipse.Fill>
            </Ellipse>
            <Ellipse WidthRequest="120" HeightRequest="120"
                     HorizontalOptions="End" VerticalOptions="Start"
                     Margin="0,10,-30,0" Opacity="0.14">
              <Ellipse.Fill>
                <RadialGradientBrush Center="0.5,0.5" Radius="0.5">
                  <GradientStop Color="#1A5FF7" Offset="0" />
                  <GradientStop Color="#1A5FF700" Offset="1" />
                </RadialGradientBrush>
              </Ellipse.Fill>
            </Ellipse>
            <Ellipse WidthRequest="80" HeightRequest="80"
                     HorizontalOptions="Center" VerticalOptions="End"
                     Margin="80,0,0,10" Opacity="0.10">
              <Ellipse.Fill>
                <RadialGradientBrush Center="0.5,0.5" Radius="0.5">
                  <GradientStop Color="#1A5FF7" Offset="0" />
                  <GradientStop Color="#1A5FF700" Offset="1" />
                </RadialGradientBrush>
              </Ellipse.Fill>
            </Ellipse>

            <!-- Emoji scene -->
            <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Center"
                                 Spacing="0" Padding="16,28">
              <Grid ColumnDefinitions="Auto,*,Auto" HeightRequest="130">
                <VerticalStackLayout Grid.Column="0" VerticalOptions="End" Margin="0,0,0,4">
                  <Label Text="🪴" FontSize="46" />
                </VerticalStackLayout>
                <VerticalStackLayout Grid.Column="1" HorizontalOptions="Center"
                                     VerticalOptions="Center" Spacing="0">
                  <Label Text="💻" FontSize="62" HorizontalOptions="Center" />
                  <Label Text="☕" FontSize="24" HorizontalOptions="Start"
                         Margin="14,-6,0,0" />
                </VerticalStackLayout>
                <VerticalStackLayout Grid.Column="2" VerticalOptions="Start"
                                     Margin="0,8,0,0">
                  <Label Text="📅" FontSize="38" />
                  <Label Text="📘" FontSize="24" Margin="10,2,0,0" />
                </VerticalStackLayout>
              </Grid>

              <Label Text="Onexso Workspace"
                     FontSize="13" FontAttributes="Bold"
                     TextColor="{StaticResource Primary}"
                     HorizontalOptions="Center" Margin="0,12,0,3" />
              <Label Text="Your attendance, simplified."
                     FontSize="11" TextColor="{StaticResource TextSecondary}"
                     HorizontalOptions="Center" />
            </VerticalStackLayout>
          </Grid>
        </Border>
      </VerticalStackLayout>

      <!-- RIGHT: Status + CLOCK IN ────────────────────────────────────── -->
      <VerticalStackLayout x:Name="RightPane" Grid.Column="1" Spacing="0" VerticalOptions="Start">

        <!-- Green dot + "Ready to Start Work" -->
        <HorizontalStackLayout Spacing="10" Margin="0,2,0,8">
          <Ellipse WidthRequest="14" HeightRequest="14"
                   Fill="{StaticResource StatusGreen}"
                   VerticalOptions="Center" />
          <Label Text="Ready to Start Work"
                 FontSize="22" FontAttributes="Bold"
                 TextColor="{StaticResource TextPrimary}" />
        </HorizontalStackLayout>

        <Label Text="Click the button below to begin today's attendance."
               FontSize="12" TextColor="{StaticResource TextSecondary}"
               Margin="0,0,0,22" />

        <!-- Working Status | divider | Live Timer -->
        <Border BackgroundColor="White"
                StrokeShape="RoundRectangle 18"
                Stroke="{StaticResource Separator}"
                StrokeThickness="1" Padding="18,16" Margin="0,0,0,24">
          <Border.Shadow>
            <Shadow Brush="#10000040" Offset="0,3" Radius="10" Opacity="0.1" />
          </Border.Shadow>
          <Grid ColumnDefinitions="Auto,*,Auto,*" ColumnSpacing="4">

            <!-- Briefcase icon -->
            <Border Grid.Column="0" WidthRequest="40" HeightRequest="40"
                    StrokeShape="RoundRectangle 12" StrokeThickness="0"
                    BackgroundColor="#EEF4FF" VerticalOptions="Center">
              <Label Text="💼" FontSize="19"
                     HorizontalOptions="Center" VerticalOptions="Center" />
            </Border>

            <!-- Working Status -->
            <VerticalStackLayout Grid.Column="1" Spacing="2"
                                 VerticalOptions="Center" Margin="10,0,0,0">
              <Label Text="Working Status" FontSize="10"
                     TextColor="{StaticResource TextSecondary}" />
              <Label Text="{Binding WorkingStatus}"
                     FontSize="17" FontAttributes="Bold"
                     TextColor="{StaticResource Primary}" />
            </VerticalStackLayout>

            <!-- Vertical divider -->
            <BoxView Grid.Column="2" WidthRequest="1"
                     BackgroundColor="{StaticResource Separator}"
                     Margin="6,2" />

            <!-- Live Timer -->
            <VerticalStackLayout Grid.Column="3" Spacing="2"
                                 VerticalOptions="Center" Margin="12,0,0,0">
              <Label Text="Live Timer" FontSize="10"
                     TextColor="{StaticResource TextSecondary}" />
              <Label Text="{Binding LiveTimer}"
                     FontSize="20" FontAttributes="Bold"
                     TextColor="{StaticResource TextPrimary}" />
            </VerticalStackLayout>
          </Grid>
        </Border>

        <!-- ⏱ CLOCK IN — glowing gradient pill -->
        <Border StrokeShape="RoundRectangle 40" StrokeThickness="0"
                HeightRequest="78" Margin="0,0,0,10">
          <Border.Background>
            <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
              <GradientStop Color="#1A5FF7" Offset="0" />
              <GradientStop Color="#5B3DF5" Offset="0.5" />
              <GradientStop Color="#7B3FE4" Offset="1" />
            </LinearGradientBrush>
          </Border.Background>
          <Border.Shadow>
            <Shadow Brush="#801A5FF7" Offset="0,10" Radius="22" Opacity="0.55" />
          </Border.Shadow>
          <Button Text="⏱  CLOCK IN"
                  Command="{Binding ClockInCommand}"
                  BackgroundColor="Transparent"
                  TextColor="White"
                  FontSize="22"
                  FontAttributes="Bold"
                  CharacterSpacing="1.5"
                  HeightRequest="78"
                  HorizontalOptions="Fill"
                  IsEnabled="{Binding IsClockinIn, Converter={StaticResource InvertBoolConverter}}" />
        </Border>

        <Label Text="{Binding ErrorMessage}"
               TextColor="{StaticResource StatusRed}"
               FontSize="11" Margin="0,4,0,0"
               IsVisible="{Binding ErrorMessage, Converter={StaticResource IsNotNullConverter}}" />
        <ActivityIndicator IsRunning="{Binding IsClockinIn}"
                           IsVisible="{Binding IsClockinIn}"
                           Color="{StaticResource Primary}"
                           HorizontalOptions="Center" Margin="0,8,0,0" />
      </VerticalStackLayout>
    </Grid>
    </ScrollView>

    <!-- ── Bottom status cards ──────────────────────────────────────────── -->
    <Grid Grid.Row="2" ColumnDefinitions="*,*,*" ColumnSpacing="10" Margin="0,12,0,8">

      <!-- Current Status -->
      <Border Grid.Column="0" BackgroundColor="White"
              StrokeShape="RoundRectangle 16" Stroke="{StaticResource Separator}"
              StrokeThickness="1" Padding="14,12">
        <Border.Shadow>
          <Shadow Brush="#08000040" Offset="0,2" Radius="8" Opacity="0.08" />
        </Border.Shadow>
        <Grid ColumnDefinitions="*,Auto">
          <HorizontalStackLayout Grid.Column="0" Spacing="8">
            <Ellipse WidthRequest="10" HeightRequest="10"
                     Fill="{StaticResource StatusGreen}" VerticalOptions="Center" />
            <VerticalStackLayout Spacing="1" VerticalOptions="Center">
              <Label Text="Current Status" FontSize="10"
                     TextColor="{StaticResource TextSecondary}" />
              <Label Text="{Binding ConnectionStatus}" FontSize="13" FontAttributes="Bold"
                     TextColor="{StaticResource StatusGreen}" />
            </VerticalStackLayout>
          </HorizontalStackLayout>
          <Label Grid.Column="1" Text="📡" FontSize="16"
                 VerticalOptions="Center" Opacity="0.5" />
        </Grid>
      </Border>

      <!-- Internet -->
      <Border Grid.Column="1" BackgroundColor="White"
              StrokeShape="RoundRectangle 16" Stroke="{StaticResource Separator}"
              StrokeThickness="1" Padding="14,12">
        <Border.Shadow>
          <Shadow Brush="#08000040" Offset="0,2" Radius="8" Opacity="0.08" />
        </Border.Shadow>
        <Grid ColumnDefinitions="*,Auto">
          <HorizontalStackLayout Grid.Column="0" Spacing="8">
            <Label Text="🌐" FontSize="18" VerticalOptions="Center" />
            <VerticalStackLayout Spacing="1" VerticalOptions="Center">
              <Label Text="Internet" FontSize="10"
                     TextColor="{StaticResource TextSecondary}" />
              <Label Text="{Binding InternetStatus}" FontSize="13" FontAttributes="Bold"
                     TextColor="{StaticResource Primary}" />
            </VerticalStackLayout>
          </HorizontalStackLayout>
          <Label Grid.Column="1" Text="📶" FontSize="15"
                 VerticalOptions="Center" Opacity="0.5" />
        </Grid>
      </Border>

      <!-- Device -->
      <Border Grid.Column="2" BackgroundColor="White"
              StrokeShape="RoundRectangle 16" Stroke="{StaticResource Separator}"
              StrokeThickness="1" Padding="14,12">
        <Border.Shadow>
          <Shadow Brush="#08000040" Offset="0,2" Radius="8" Opacity="0.08" />
        </Border.Shadow>
        <Grid ColumnDefinitions="*,Auto">
          <HorizontalStackLayout Grid.Column="0" Spacing="8">
            <Label Text="🖥" FontSize="18" VerticalOptions="Center" />
            <VerticalStackLayout Spacing="1" VerticalOptions="Center">
              <Label Text="Device" FontSize="10"
                     TextColor="{StaticResource TextSecondary}" />
              <Label Text="{Binding DeviceType}" FontSize="13" FontAttributes="Bold"
                     TextColor="{StaticResource Primary}" />
            </VerticalStackLayout>
          </HorizontalStackLayout>
          <Label Grid.Column="1" Text="🪟" FontSize="15"
                 VerticalOptions="Center" Opacity="0.5" />
        </Grid>
      </Border>
    </Grid>

    <!-- ── Footer ────────────────────────────────────────────────────────── -->
    <Grid Grid.Row="3" ColumnDefinitions="Auto,*,Auto" Padding="2,2,2,0">
      <HorizontalStackLayout Grid.Column="0" Spacing="6" VerticalOptions="Center">
        <Label Text="⚙" FontSize="12" TextColor="{StaticResource TextMuted}" />
        <Label Text="Settings" FontSize="11" TextColor="{StaticResource TextMuted}" />
      </HorizontalStackLayout>

      <Label Grid.Column="1" Text="Version 1.0.0" FontSize="11"
             TextColor="{StaticResource TextMuted}"
             HorizontalOptions="Center" VerticalOptions="Center" />

      <HorizontalStackLayout Grid.Column="2" Spacing="6" VerticalOptions="Center">
        <Ellipse WidthRequest="8" HeightRequest="8"
                 Fill="{StaticResource StatusGreen}" VerticalOptions="Center" />
        <Label Text="Connected to Onexso Server" FontSize="11"
               TextColor="{StaticResource TextSecondary}" />
      </HorizontalStackLayout>
    </Grid>
  </Grid>
</ContentPage>
