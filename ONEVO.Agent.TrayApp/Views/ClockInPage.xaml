<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:ONEVO.Agent.TrayApp.ViewModels"
             x:Class="ONEVO.Agent.TrayApp.Views.ClockInPage"
             x:DataType="vm:ClockInViewModel"
             BackgroundColor="{StaticResource Background}">

  <Grid RowDefinitions="Auto,*,Auto,Auto" Padding="20,16">

    <!-- ── Header ─────────────────────────────────────────────────────── -->
    <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto" Margin="0,0,0,12">
      <HorizontalStackLayout Grid.Column="0" Spacing="12">

        <!-- OneXso logo -->
        <Border WidthRequest="42" HeightRequest="42"
                StrokeShape="RoundRectangle 13" StrokeThickness="0"
                BackgroundColor="Transparent">
          <Image Source="onexso_logo_mark.svg"
                 Aspect="AspectFit"
                 WidthRequest="42" HeightRequest="42"
                 HorizontalOptions="Center" VerticalOptions="Center" />
        </Border>

        <VerticalStackLayout VerticalOptions="Center" Spacing="1">
          <Label Text="OneXso Workspace" FontSize="14" FontAttributes="Bold"
                 TextColor="{StaticResource TextPrimary}" />
          <Label Text="Your Workplace. Simplified."
                 FontSize="10" TextColor="{StaticResource TextSecondary}" />
        </VerticalStackLayout>
      </HorizontalStackLayout>

      <Image Grid.Column="2" Source="icon_ellipsis.svg" WidthRequest="18" HeightRequest="18"
             VerticalOptions="Center" />
    </Grid>

    <!-- ── Main body ──────────────────────────────────────────────────── -->
    <ScrollView Grid.Row="1">
    <Grid x:Name="PaneGrid" ColumnDefinitions="*,*" ColumnSpacing="24">

      <!-- LEFT: greeting + date/time + illustration ───────────────────── -->
      <VerticalStackLayout x:Name="LeftPane" Grid.Column="0" Spacing="0">

        <!-- "Good Morning, Pirakeerthan 👋" -->
        <HorizontalStackLayout Spacing="0" Margin="0,0,0,6">
          <Label Text="{Binding Greeting}"
                 FontSize="26" FontAttributes="Bold"
                 TextColor="{StaticResource TextPrimary}" />
          <Label Text=", "
                 FontSize="26" FontAttributes="Bold"
                 TextColor="{StaticResource TextPrimary}" />
          <Label Text="{Binding EmployeeName}"
                 FontSize="26" FontAttributes="Bold"
                 TextColor="{StaticResource Primary}" />
          <Label Text=" 👋" FontSize="24" VerticalOptions="Center" Margin="2,0,0,0" />
        </HorizontalStackLayout>

        <Label Text="Welcome back to OneXso Workspace."
               FontSize="13" TextColor="{StaticResource TextSecondary}" Margin="0,0,0,2" />
        <Label Text="Ready to begin your workday?"
               FontSize="13" TextColor="{StaticResource TextSecondary}" Margin="0,0,0,18" />

        <!-- Date + Time cards -->
        <Grid ColumnDefinitions="*,*" ColumnSpacing="12" Margin="0,0,0,18">

          <Border Grid.Column="0" Style="{StaticResource GlassCard}" Padding="14,12">
            <HorizontalStackLayout Spacing="10">
              <Border WidthRequest="36" HeightRequest="36"
                      StrokeShape="RoundRectangle 10" StrokeThickness="0"
                      BackgroundColor="#EEF4FF" VerticalOptions="Center">
                <Image Source="icon_calendar.svg" WidthRequest="18" HeightRequest="18"
                       HorizontalOptions="Center" VerticalOptions="Center" />
              </Border>
              <VerticalStackLayout Spacing="2" VerticalOptions="Center">
                <Label Text="Today's Date" FontSize="10"
                       TextColor="{StaticResource TextSecondary}" />
                <Label Text="{Binding CurrentDateDisplay}"
                       FontSize="12" FontAttributes="Bold"
                       TextColor="{StaticResource Primary}"
                       LineBreakMode="TailTruncation" />
              </VerticalStackLayout>
            </HorizontalStackLayout>
          </Border>

          <Border Grid.Column="1" Style="{StaticResource GlassCard}" Padding="14,12">
            <HorizontalStackLayout Spacing="10">
              <Border WidthRequest="36" HeightRequest="36"
                      StrokeShape="RoundRectangle 10" StrokeThickness="0"
                      BackgroundColor="#EEF4FF" VerticalOptions="Center">
                <Image Source="icon_clock.svg" WidthRequest="18" HeightRequest="18"
                       HorizontalOptions="Center" VerticalOptions="Center" />
              </Border>
              <VerticalStackLayout Spacing="2" VerticalOptions="Center">
                <Label Text="Current Time" FontSize="10"
                       TextColor="{StaticResource TextSecondary}" />
                <Label Text="{Binding CurrentTimeDisplay}"
                       FontSize="14" FontAttributes="Bold"
                       TextColor="{StaticResource Primary}" />
              </VerticalStackLayout>
            </HorizontalStackLayout>
          </Border>
        </Grid>

        <!-- Illustration card — desk-scene artwork (Resources/Images/workspace_illustration.png) -->
        <Border Style="{StaticResource GlassPanel}" Padding="24" VerticalOptions="FillAndExpand">
          <Border.Shadow>
            <Shadow Brush="#10000040" Offset="0,4" Radius="14" Opacity="0.1" />
          </Border.Shadow>
          <Image Source="workspace_illustration.png"
                 Aspect="AspectFit"
                 HorizontalOptions="Center" VerticalOptions="Center" />
        </Border>
      </VerticalStackLayout>

      <!-- RIGHT: Status + CLOCK IN ────────────────────────────────────── -->
      <VerticalStackLayout x:Name="RightPane" Grid.Column="1" Spacing="0" VerticalOptions="Start">

        <!-- Green dot + "Ready to Start Work" -->
        <HorizontalStackLayout Spacing="10" Margin="0,2,0,8">
          <Image x:Name="StatusDot" Source="icon_status_ready.svg"
                 WidthRequest="14" HeightRequest="14"
                 VerticalOptions="Center" />
          <Label Text="Ready to Start Work"
                 FontSize="22" FontAttributes="Bold"
                 TextColor="{StaticResource TextPrimary}" />
        </HorizontalStackLayout>

        <Label Text="Click the button below to begin today's attendance."
               FontSize="12" TextColor="{StaticResource TextSecondary}"
               Margin="0,0,0,22" />

        <!-- Working Status | divider | Live Timer -->
        <Border Style="{StaticResource GlassCard}" Padding="18,16" Margin="0,0,0,24">
          <Grid ColumnDefinitions="Auto,*,Auto,*" ColumnSpacing="4">

            <!-- Briefcase icon -->
            <Border Grid.Column="0" WidthRequest="40" HeightRequest="40"
                    StrokeShape="RoundRectangle 12" StrokeThickness="0"
                    BackgroundColor="#EEF4FF" VerticalOptions="Center">
              <Image Source="icon_briefcase.svg" WidthRequest="20" HeightRequest="20"
                     HorizontalOptions="Center" VerticalOptions="Center" />
            </Border>

            <!-- Working Status -->
            <VerticalStackLayout Grid.Column="1" Spacing="2"
                                 VerticalOptions="Center" Margin="10,0,0,0">
              <Label Text="Working Status" FontSize="10"
                     TextColor="{StaticResource TextSecondary}" />
              <Label Text="{Binding WorkingStatus}"
                     FontSize="17" FontAttributes="Bold"
                     TextColor="{StaticResource Primary}" />
            </VerticalStackLayout>

            <!-- Vertical divider -->
            <BoxView Grid.Column="2" WidthRequest="1"
                     BackgroundColor="{StaticResource Separator}"
                     Margin="6,2" />

            <!-- Live Timer -->
            <VerticalStackLayout Grid.Column="3" Spacing="2"
                                 VerticalOptions="Center" Margin="12,0,0,0">
              <Label Text="Live Timer" FontSize="10"
                     TextColor="{StaticResource TextSecondary}" />
              <Label Text="{Binding LiveTimer}"
                     FontSize="20" FontAttributes="Bold"
                     TextColor="{StaticResource TextPrimary}" />
            </VerticalStackLayout>
          </Grid>
        </Border>

        <!-- CLOCK IN — glowing gradient pill with premium hover/press interaction -->
        <Border x:Name="ClockInGlow" StrokeShape="RoundRectangle 40" StrokeThickness="1.4"
                HeightRequest="78" Margin="0,0,0,10">
          <Border.Stroke>
            <SolidColorBrush x:Name="ClockInStrokeBrush" Color="#00FFFFFF" />
          </Border.Stroke>
          <Border.Background>
            <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
              <GradientStop x:Name="ClockInStop0" Color="#22C7F0" Offset="0" />
              <GradientStop x:Name="ClockInStop1" Color="#175CFF" Offset="0.5" />
              <GradientStop x:Name="ClockInStop2" Color="#6D28D9" Offset="1" />
            </LinearGradientBrush>
          </Border.Background>
          <Border.Shadow>
            <Shadow x:Name="ClockInShadow" Brush="#80175CFF" Offset="0,10" Radius="22" Opacity="0.55" />
          </Border.Shadow>

          <Grid>
            <!-- Light sweep — one-shot on hover-enter, input-transparent -->
            <BoxView x:Name="ClockInShimmer" InputTransparent="True" Opacity="0"
                     WidthRequest="46" HorizontalOptions="Start" VerticalOptions="Fill"
                     TranslationX="-60">
              <BoxView.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                  <GradientStop Color="#00FFFFFF" Offset="0" />
                  <GradientStop Color="#4DFFFFFF" Offset="0.5" />
                  <GradientStop Color="#00FFFFFF" Offset="1" />
                </LinearGradientBrush>
              </BoxView.Background>
            </BoxView>

            <!-- Sparkles — subtle twinkle while hovering, input-transparent -->
            <Ellipse x:Name="ClockInSparkle1" WidthRequest="4" HeightRequest="4" Fill="White"
                     Opacity="0" InputTransparent="True"
                     HorizontalOptions="Start" VerticalOptions="Start" Margin="36,12,0,0" />
            <Ellipse x:Name="ClockInSparkle2" WidthRequest="3" HeightRequest="3" Fill="White"
                     Opacity="0" InputTransparent="True"
                     HorizontalOptions="End" VerticalOptions="End" Margin="0,0,40,14" />
            <Ellipse x:Name="ClockInSparkle3" WidthRequest="3" HeightRequest="3" Fill="White"
                     Opacity="0" InputTransparent="True"
                     HorizontalOptions="End" VerticalOptions="Start" Margin="0,16,66,0" />

            <!-- Real hit target — keeps native Windows hover cursor + disabled state for free -->
            <Button x:Name="ClockInButtonHit" Text=""
                    Command="{Binding ClockInCommand}"
                    BackgroundColor="Transparent"
                    HeightRequest="78" HorizontalOptions="Fill"
                    Pressed="OnClockInPressed" Released="OnClockInReleased"
                    IsEnabled="{Binding IsClockinIn, Converter={StaticResource InvertBoolConverter}}">
              <Button.GestureRecognizers>
                <PointerGestureRecognizer PointerEntered="OnClockInPointerEntered"
                                           PointerExited="OnClockInPointerExited" />
              </Button.GestureRecognizers>
            </Button>

            <!-- Visual content — input-transparent so clicks pass through to the Button -->
            <HorizontalStackLayout InputTransparent="True" Spacing="10"
                                   HorizontalOptions="Center" VerticalOptions="Center">
              <Border x:Name="ClockInIconCircle" WidthRequest="34" HeightRequest="34"
                      StrokeShape="RoundRectangle 17" StrokeThickness="0"
                      BackgroundColor="#26FFFFFF">
                <Image Source="icon_clock_white.png" WidthRequest="16" HeightRequest="16"
                       HorizontalOptions="Center" VerticalOptions="Center" />
              </Border>
              <Label Text="CLOCK IN" TextColor="White" FontSize="22" FontAttributes="Bold"
                     CharacterSpacing="1.5" VerticalOptions="Center" />
            </HorizontalStackLayout>
          </Grid>
        </Border>

        <Label Text="{Binding ErrorMessage}"
               TextColor="{StaticResource StatusRed}"
               FontSize="11" Margin="0,4,0,0"
               IsVisible="{Binding ErrorMessage, Converter={StaticResource IsNotNullConverter}}" />
        <ActivityIndicator IsRunning="{Binding IsClockinIn}"
                           IsVisible="{Binding IsClockinIn}"
                           Color="{StaticResource Primary}"
                           HorizontalOptions="Center" Margin="0,8,0,0" />
      </VerticalStackLayout>
    </Grid>
    </ScrollView>

    <!-- ── Bottom status cards ──────────────────────────────────────────── -->
    <Grid Grid.Row="2" ColumnDefinitions="*,*,*" ColumnSpacing="10" Margin="0,12,0,8">

      <!-- Current Status -->
      <Border Grid.Column="0" Style="{StaticResource GlassCard}" Padding="14,12">
        <Grid ColumnDefinitions="*,Auto">
          <HorizontalStackLayout Grid.Column="0" Spacing="8">
            <Ellipse WidthRequest="10" HeightRequest="10"
                     Fill="{StaticResource StatusGreen}" VerticalOptions="Center" />
            <VerticalStackLayout Spacing="1" VerticalOptions="Center">
              <Label Text="Current Status" FontSize="10"
                     TextColor="{StaticResource TextSecondary}" />
              <Label Text="{Binding ConnectionStatus}" FontSize="13" FontAttributes="Bold"
                     TextColor="{StaticResource StatusGreen}" />
            </VerticalStackLayout>
          </HorizontalStackLayout>
          <Image Grid.Column="1" Source="icon_connection.svg" WidthRequest="15" HeightRequest="15"
                 VerticalOptions="Center" Opacity="0.6" />
        </Grid>
      </Border>

      <!-- Internet -->
      <Border Grid.Column="1" Style="{StaticResource GlassCard}" Padding="14,12">
        <Grid ColumnDefinitions="*,Auto">
          <HorizontalStackLayout Grid.Column="0" Spacing="8">
            <Image Source="icon_globe.svg" WidthRequest="18" HeightRequest="18" VerticalOptions="Center" />
            <VerticalStackLayout Spacing="1" VerticalOptions="Center">
              <Label Text="Internet" FontSize="10"
                     TextColor="{StaticResource TextSecondary}" />
              <Label Text="{Binding InternetStatus}" FontSize="13" FontAttributes="Bold"
                     TextColor="{StaticResource Primary}" />
            </VerticalStackLayout>
          </HorizontalStackLayout>
          <Image Grid.Column="1" Source="icon_wifi.svg" WidthRequest="15" HeightRequest="15"
                 VerticalOptions="Center" Opacity="0.6" />
        </Grid>
      </Border>

      <!-- Device -->
      <Border Grid.Column="2" Style="{StaticResource GlassCard}" Padding="14,12">
        <Grid ColumnDefinitions="*,Auto">
          <HorizontalStackLayout Grid.Column="0" Spacing="8">
            <Image Source="icon_windows.svg" WidthRequest="18" HeightRequest="18" VerticalOptions="Center" />
            <VerticalStackLayout Spacing="1" VerticalOptions="Center">
              <Label Text="Device" FontSize="10"
                     TextColor="{StaticResource TextSecondary}" />
              <Label Text="{Binding DeviceType}" FontSize="13" FontAttributes="Bold"
                     TextColor="{StaticResource Primary}" />
            </VerticalStackLayout>
          </HorizontalStackLayout>
          <Image Grid.Column="1" Source="icon_desktop.svg" WidthRequest="15" HeightRequest="15"
                 VerticalOptions="Center" Opacity="0.6" />
        </Grid>
      </Border>
    </Grid>

    <!-- ── Footer ────────────────────────────────────────────────────────── -->
    <Grid Grid.Row="3" ColumnDefinitions="Auto,*,Auto" Padding="2,2,2,0">
      <HorizontalStackLayout Grid.Column="0" Spacing="6" VerticalOptions="Center">
        <HorizontalStackLayout.GestureRecognizers>
          <TapGestureRecognizer Command="{Binding SignOutCommand}" />
        </HorizontalStackLayout.GestureRecognizers>
        <Label Text="{StaticResource IconPower}" FontFamily="Segoe MDL2 Assets" FontSize="11" TextColor="{StaticResource TextMuted}" />
        <Label Text="Sign Out" FontSize="11" TextColor="{StaticResource TextMuted}" />
        <ActivityIndicator IsRunning="{Binding IsSigningOut}"
                           IsVisible="{Binding IsSigningOut}"
                           Color="{StaticResource TextMuted}"
                           WidthRequest="12" HeightRequest="12" />
      </HorizontalStackLayout>

      <Label Grid.Column="1" Text="Version 1.0.0" FontSize="11"
             TextColor="{StaticResource TextMuted}"
             HorizontalOptions="Center" VerticalOptions="Center" />

      <HorizontalStackLayout Grid.Column="2" Spacing="6" VerticalOptions="Center">
        <Ellipse WidthRequest="8" HeightRequest="8"
                 Fill="{StaticResource StatusGreen}" VerticalOptions="Center" />
        <Label Text="Connected to OneXso Server" FontSize="11"
               TextColor="{StaticResource TextSecondary}" />
      </HorizontalStackLayout>
    </Grid>
  </Grid>
</ContentPage>
