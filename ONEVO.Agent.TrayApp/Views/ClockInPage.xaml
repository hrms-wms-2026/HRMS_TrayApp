<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:ONEVO.Agent.TrayApp.ViewModels"
             xmlns:controls="clr-namespace:ONEVO.Agent.TrayApp.Controls"
             x:Class="ONEVO.Agent.TrayApp.Views.ClockInPage"
             x:DataType="vm:ClockInViewModel"
             Shell.NavBarIsVisible="False"
             Title="OneXso WorkPulse">

  <Grid>
    <Grid RowDefinitions="*,Auto" Padding="28,16,28,12">
      <Grid.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
          <GradientStop Color="{StaticResource BackgroundWashStart}" Offset="0" />
          <GradientStop Color="{StaticResource BackgroundWashMid}" Offset="0.45" />
          <GradientStop Color="{StaticResource BackgroundWashEnd}" Offset="1" />
        </LinearGradientBrush>
      </Grid.Background>

      <Grid x:Name="PaneGrid" Grid.Row="0" ColumnDefinitions="*,*" ColumnSpacing="28">
        <Grid x:Name="LeftPane" Grid.Column="0">
          <Image Source="clockin_hero.png" Aspect="AspectFit" HorizontalOptions="Fill" VerticalOptions="Center" />
          <AbsoluteLayout InputTransparent="True">
            <Border Style="{StaticResource ClockInFloatCard}"
                    AbsoluteLayout.LayoutBounds="0.04, 0.20, 172, 50"
                    AbsoluteLayout.LayoutFlags="PositionProportional">
              <HorizontalStackLayout Spacing="8">
                <Border WidthRequest="28" HeightRequest="28" StrokeShape="RoundRectangle 14" StrokeThickness="0" BackgroundColor="#DCFCE7" VerticalOptions="Center">
                  <Label Text="{StaticResource IconShield}" FontFamily="Segoe MDL2 Assets" FontSize="12" TextColor="{StaticResource StatusGreen}" HorizontalOptions="Center" VerticalOptions="Center" />
                </Border>
                <VerticalStackLayout Spacing="0" VerticalOptions="Center">
                  <Label Text="Workspace Status" FontSize="14" TextColor="{StaticResource TextSecondary}" LineBreakMode="TailTruncation" MaxLines="1" />
                  <Label Text="{Binding WorkspaceStatus}" FontSize="13" FontAttributes="Bold" TextColor="{StaticResource StatusGreen}" LineBreakMode="TailTruncation" MaxLines="1">
                    <Label.Triggers>
                      <DataTrigger TargetType="Label" Binding="{Binding IsConnected}" Value="False">
                        <Setter Property="TextColor" Value="{StaticResource StatusRed}" />
                      </DataTrigger>
                    </Label.Triggers>
                  </Label>
                </VerticalStackLayout>
              </HorizontalStackLayout>
            </Border>
            <Border Style="{StaticResource ClockInFloatCard}"
                    AbsoluteLayout.LayoutBounds="0.96, 0.16, 168, 50"
                    AbsoluteLayout.LayoutFlags="PositionProportional">
              <HorizontalStackLayout Spacing="8">
                <Border WidthRequest="28" HeightRequest="28" StrokeShape="RoundRectangle 14" StrokeThickness="0" BackgroundColor="{StaticResource AccentSoft}" VerticalOptions="Center">
                  <Label Text="{StaticResource IconShield}" FontFamily="Segoe MDL2 Assets" FontSize="12" TextColor="{StaticResource Primary}" HorizontalOptions="Center" VerticalOptions="Center" />
                </Border>
                <VerticalStackLayout Spacing="0" VerticalOptions="Center">
                  <Label Text="Policies" FontSize="14" TextColor="{StaticResource TextSecondary}" LineBreakMode="TailTruncation" MaxLines="1" />
                  <Label Text="{Binding PoliciesStatus}" FontSize="13" FontAttributes="Bold" TextColor="{StaticResource Primary}" LineBreakMode="TailTruncation" MaxLines="1" />
                </VerticalStackLayout>
              </HorizontalStackLayout>
            </Border>
            <Border Style="{StaticResource ClockInFloatCard}"
                    AbsoluteLayout.LayoutBounds="0.00, 0.38, 164, 50"
                    AbsoluteLayout.LayoutFlags="PositionProportional">
              <HorizontalStackLayout Spacing="8">
                <Border WidthRequest="28" HeightRequest="28" StrokeShape="RoundRectangle 14" StrokeThickness="0" BackgroundColor="{StaticResource PrimarySoft}" VerticalOptions="Center">
                  <Label Text="{StaticResource IconPerson}" FontFamily="Segoe MDL2 Assets" FontSize="12" TextColor="{StaticResource Primary}" HorizontalOptions="Center" VerticalOptions="Center" />
                </Border>
                <VerticalStackLayout Spacing="0" VerticalOptions="Center">
                  <Label Text="Profile" FontSize="14" TextColor="{StaticResource TextSecondary}" LineBreakMode="TailTruncation" MaxLines="1" />
                  <Label Text="{Binding EmployeeName}" FontSize="13" FontAttributes="Bold" TextColor="{StaticResource Primary}" LineBreakMode="TailTruncation" MaxLines="1" />
                </VerticalStackLayout>
              </HorizontalStackLayout>
            </Border>
            <Border Style="{StaticResource ClockInFloatCard}"
                    AbsoluteLayout.LayoutBounds="1.00, 0.38, 168, 50"
                    AbsoluteLayout.LayoutFlags="PositionProportional">
              <HorizontalStackLayout Spacing="8">
                <Border WidthRequest="28" HeightRequest="28" StrokeShape="RoundRectangle 14" StrokeThickness="0" BackgroundColor="{StaticResource PrimarySoft}" VerticalOptions="Center">
                  <Label Text="{StaticResource IconLaptop}" FontFamily="Segoe MDL2 Assets" FontSize="12" TextColor="{StaticResource Primary}" HorizontalOptions="Center" VerticalOptions="Center" />
                </Border>
                <VerticalStackLayout Spacing="0" VerticalOptions="Center">
                  <Label Text="Devices" FontSize="14" TextColor="{StaticResource TextSecondary}" LineBreakMode="TailTruncation" MaxLines="1" />
                  <Label Text="{Binding DeviceType}" FontSize="13" FontAttributes="Bold" TextColor="{StaticResource Primary}" LineBreakMode="TailTruncation" MaxLines="1" />
                </VerticalStackLayout>
              </HorizontalStackLayout>
            </Border>
          </AbsoluteLayout>
        </Grid>

        <VerticalStackLayout x:Name="RightPane" Grid.Column="1" VerticalOptions="Center" Spacing="0">
          <Label Margin="0,0,0,4">
            <Label.FormattedText>
              <FormattedString>
                <Span Text="Ready to " FontSize="26" FontAttributes="Bold" TextColor="{StaticResource TextPrimary}" />
                <Span Text="Start Work" FontSize="26" FontAttributes="Bold" TextColor="{StaticResource BrandTitle}" />
              </FormattedString>
            </Label.FormattedText>
          </Label>
          <HorizontalStackLayout Spacing="6" Margin="0,0,0,2">
            <Label Text="{Binding Greeting}" FontSize="15" TextColor="{StaticResource TextSecondary}" />
            <Label Text="{Binding EmployeeName}" FontSize="15" FontAttributes="Bold" TextColor="{StaticResource BrandTitle}" />
          </HorizontalStackLayout>
          <Label Text="Everything is ready for today's work session."
                 FontSize="14" TextColor="{StaticResource TextSecondary}" Margin="0,0,0,14" />

          <Border Style="{StaticResource TrayCompactGlassCard}" Padding="16,12" Margin="0,0,0,14">
            <Grid RowDefinitions="Auto,Auto,Auto" ColumnDefinitions="*,*" RowSpacing="12" ColumnSpacing="12">
              <HorizontalStackLayout Grid.Row="0" Grid.Column="0" Spacing="10">
                <Border Style="{StaticResource IconTileCircle}">
                  <Label Text="{StaticResource IconCalendar}" FontFamily="Segoe MDL2 Assets" FontSize="14" TextColor="{StaticResource Primary}" HorizontalOptions="Center" VerticalOptions="Center" />
                </Border>
                <VerticalStackLayout Spacing="1">
                  <Label Text="Today's Date" Style="{StaticResource StatLabel}" />
                  <Label Text="{Binding CurrentDateDisplay}" Style="{StaticResource FieldValue}" />
                </VerticalStackLayout>
              </HorizontalStackLayout>
              <HorizontalStackLayout Grid.Row="0" Grid.Column="1" Spacing="10">
                <Border Style="{StaticResource IconTileCircle}">
                  <Label Text="{StaticResource IconClock}" FontFamily="Segoe MDL2 Assets" FontSize="14" TextColor="{StaticResource Primary}" HorizontalOptions="Center" VerticalOptions="Center" />
                </Border>
                <VerticalStackLayout Spacing="1">
                  <Label Text="Current Time" Style="{StaticResource StatLabel}" />
                  <Label Text="{Binding CurrentTimeDisplay}" Style="{StaticResource FieldValue}" />
                </VerticalStackLayout>
              </HorizontalStackLayout>
              <HorizontalStackLayout Grid.Row="1" Grid.Column="0" Spacing="10">
                <Border Style="{StaticResource IconTileCircle}">
                  <Label Text="{StaticResource IconLocation}" FontFamily="Segoe MDL2 Assets" FontSize="14" TextColor="{StaticResource Primary}" HorizontalOptions="Center" VerticalOptions="Center">
                    <Label.Triggers>
                      <DataTrigger TargetType="Label" Binding="{Binding WorkLocation}" Value="Work From Home">
                        <Setter Property="Text" Value="&#xE80F;" />
                      </DataTrigger>
                    </Label.Triggers>
                  </Label>
                </Border>
                <VerticalStackLayout Spacing="1">
                  <Label Text="Work Location" Style="{StaticResource StatLabel}" />
                  <Label Text="{Binding WorkLocation}" Style="{StaticResource FieldValue}" />
                </VerticalStackLayout>
              </HorizontalStackLayout>
              <HorizontalStackLayout Grid.Row="1" Grid.Column="1" Spacing="10">
                <Border Style="{StaticResource IconTileCircle}">
                  <Label Text="{StaticResource IconMonitor}" FontFamily="Segoe MDL2 Assets" FontSize="14" TextColor="{StaticResource Primary}" HorizontalOptions="Center" VerticalOptions="Center" />
                </Border>
                <VerticalStackLayout Spacing="1">
                  <Label Text="Device" Style="{StaticResource StatLabel}" />
                  <Label Text="{Binding DeviceType}" Style="{StaticResource FieldValue}" />
                </VerticalStackLayout>
              </HorizontalStackLayout>
              <HorizontalStackLayout Grid.Row="2" Grid.Column="0" Spacing="10">
                <Border Style="{StaticResource IconTileCircle}" BackgroundColor="#DCFCE7">
                  <Label Text="{StaticResource IconWifi}" FontFamily="Segoe MDL2 Assets" FontSize="14" TextColor="{StaticResource StatusGreen}" HorizontalOptions="Center" VerticalOptions="Center" />
                </Border>
                <VerticalStackLayout Spacing="1">
                  <Label Text="Connection" Style="{StaticResource StatLabel}" />
                  <Label Text="{Binding InternetStatus}" Style="{StaticResource FieldValue}" TextColor="{StaticResource StatusGreen}" />
                </VerticalStackLayout>
              </HorizontalStackLayout>
              <HorizontalStackLayout Grid.Row="2" Grid.Column="1" Spacing="10">
                <Border Style="{StaticResource IconTileCircle}">
                  <Label Text="{StaticResource IconCalendar}" FontFamily="Segoe MDL2 Assets" FontSize="14" TextColor="{StaticResource Primary}" HorizontalOptions="Center" VerticalOptions="Center" />
                </Border>
                <VerticalStackLayout Spacing="1">
                  <Label Text="Today's Schedule" Style="{StaticResource StatLabel}" />
                  <Label Text="{Binding ScheduleDisplay}" Style="{StaticResource FieldValue}" />
                </VerticalStackLayout>
              </HorizontalStackLayout>
            </Grid>
          </Border>

          <Border x:Name="ClockInGlow" StrokeShape="RoundRectangle 18" StrokeThickness="1.4"
                  HeightRequest="{StaticResource TrayHeroActionHeight}" Margin="0,0,0,12">
            <Border.Stroke>
              <SolidColorBrush x:Name="ClockInStrokeBrush" Color="#00FFFFFF" />
            </Border.Stroke>
            <Border.Background>
              <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                <GradientStop x:Name="ClockInStop0" Color="#22C7F0" Offset="0" />
                <GradientStop x:Name="ClockInStop1" Color="#175CFF" Offset="0.5" />
                <GradientStop x:Name="ClockInStop2" Color="#6D28D9" Offset="1" />
              </LinearGradientBrush>
            </Border.Background>
            <Border.Shadow>
              <Shadow x:Name="ClockInShadow" Brush="#80175CFF" Offset="0,10" Radius="22" Opacity="0.55" />
            </Border.Shadow>
            <Grid>
              <BoxView x:Name="ClockInShimmer" InputTransparent="True" Opacity="0" WidthRequest="46" HorizontalOptions="Start" VerticalOptions="Fill" TranslationX="-60">
                <BoxView.Background>
                  <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Color="#00FFFFFF" Offset="0" />
                    <GradientStop Color="#4DFFFFFF" Offset="0.5" />
                    <GradientStop Color="#00FFFFFF" Offset="1" />
                  </LinearGradientBrush>
                </BoxView.Background>
              </BoxView>
              <Ellipse x:Name="ClockInSparkle1" WidthRequest="4" HeightRequest="4" Fill="White" Opacity="0" InputTransparent="True" HorizontalOptions="Start" VerticalOptions="Start" Margin="36,12,0,0" />
              <Ellipse x:Name="ClockInSparkle2" WidthRequest="3" HeightRequest="3" Fill="White" Opacity="0" InputTransparent="True" HorizontalOptions="End" VerticalOptions="End" Margin="0,0,40,14" />
              <Ellipse x:Name="ClockInSparkle3" WidthRequest="3" HeightRequest="3" Fill="White" Opacity="0" InputTransparent="True" HorizontalOptions="End" VerticalOptions="Start" Margin="0,16,66,0" />
              <Button x:Name="ClockInButtonHit" Text="" Command="{Binding RequestStartWorkdayCommand}"
                      BackgroundColor="Transparent" HeightRequest="{StaticResource TrayHeroActionHeight}" HorizontalOptions="Fill"
                      Pressed="OnClockInPressed" Released="OnClockInReleased"
                      IsEnabled="{Binding IsClockinIn, Converter={StaticResource InvertBoolConverter}}">
                <Button.GestureRecognizers>
                  <PointerGestureRecognizer PointerEntered="OnClockInPointerEntered" PointerExited="OnClockInPointerExited" />
                </Button.GestureRecognizers>
              </Button>
              <HorizontalStackLayout InputTransparent="True" Spacing="10" HorizontalOptions="Center" VerticalOptions="Center">
                <Border x:Name="ClockInIconCircle" WidthRequest="28" HeightRequest="28" StrokeShape="RoundRectangle 14" StrokeThickness="0" BackgroundColor="Transparent">
                  <Label Text="{StaticResource IconClock}" FontFamily="Segoe MDL2 Assets" FontSize="18" TextColor="White" HorizontalOptions="Center" VerticalOptions="Center" />
                </Border>
                <Label Text="CLOCK IN" TextColor="White" FontSize="18" FontAttributes="Bold" VerticalOptions="Center" />
              </HorizontalStackLayout>
            </Grid>
          </Border>

          <Border Style="{StaticResource TrayCompactGlassCard}" Padding="14,10">
            <Grid ColumnDefinitions="*,*">
              <HorizontalStackLayout Spacing="10">
                <Label Text="{StaticResource IconStopwatch}" FontFamily="Segoe MDL2 Assets" FontSize="22" TextColor="{StaticResource Primary}" VerticalOptions="Center" />
                <VerticalStackLayout Spacing="1">
                  <Label Text="Live Timer" Style="{StaticResource StatLabel}" />
                  <Label Text="{Binding LiveTimer}" Style="{StaticResource StatValue}" FontSize="18" />
                </VerticalStackLayout>
              </HorizontalStackLayout>
              <VerticalStackLayout Grid.Column="1" HorizontalOptions="End" Spacing="4">
                <Label Text="Work Status" Style="{StaticResource StatLabel}" HorizontalOptions="End" />
                <Border StrokeShape="RoundRectangle 10" Padding="10,4" BackgroundColor="#F3F5FA">
                  <Label Text="Not started" FontSize="13" FontAttributes="Bold" TextColor="{StaticResource TextSecondary}" />
                </Border>
              </VerticalStackLayout>
            </Grid>
          </Border>

          <Label Text="{Binding ErrorMessage}" TextColor="{StaticResource StatusRed}" FontSize="14" Margin="0,8,0,0"
                 IsVisible="{Binding ErrorMessage, Converter={StaticResource IsNotNullConverter}}" />
          <Ellipse x:Name="StatusDot" WidthRequest="8" HeightRequest="8" Fill="{StaticResource StatusGreen}" Opacity="0" />
        </VerticalStackLayout>
      </Grid>

      <controls:FooterStatusBar Grid.Row="1" VersionText="Version 1.0.0"
                                ConnectionLabel="{Binding ConnectionStatus}"
                                IsConnected="{Binding IsConnected}"
                                ShowSignOut="True"
                                SignOutCommand="{Binding SignOutCommand}" />
    </Grid>

    <controls:GlassConfirmHost IsOpen="{Binding IsStartConfirmVisible}"
                               Title="Start your workday?"
                               Message="Your attendance and work session will begin now."
                               CancelCommand="{Binding CancelStartWorkdayCommand}"
                               ConfirmCommand="{Binding ConfirmStartWorkdayCommand}"
                               ConfirmText="Clock In Now">
      <controls:GlassConfirmHost.Body>
        <VerticalStackLayout Spacing="0">
          <controls:PopupInfoRow Icon="{StaticResource IconHome}"
                                 Prefix="Today's work location: "
                                 Value="{Binding WorkLocation}" />
          <controls:PopupInfoRow Icon="{StaticResource IconShield}"
                                 Caption="Identity verification required" />
          <controls:PopupInfoRow Icon="{StaticResource IconMonitor}"
                                 Caption="Monitoring starts after clock-in"
                                 ShowDivider="False" />
        </VerticalStackLayout>
      </controls:GlassConfirmHost.Body>
    </controls:GlassConfirmHost>
  </Grid>
</ContentPage>
