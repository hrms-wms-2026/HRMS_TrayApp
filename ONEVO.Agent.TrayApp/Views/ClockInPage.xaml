<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:ONEVO.Agent.TrayApp.ViewModels"
             x:Class="ONEVO.Agent.TrayApp.Views.ClockInPage"
             x:DataType="vm:ClockInViewModel"
             BackgroundColor="{StaticResource Background}">

  <Grid RowDefinitions="Auto,*,Auto">

    <!-- Top: app header bar -->
    <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto"
          Padding="24,16,24,0">
      <HorizontalStackLayout Grid.Column="0" Spacing="10">
        <Border WidthRequest="32" HeightRequest="32"
                StrokeShape="RoundRectangle 8" StrokeThickness="0">
          <Border.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
              <GradientStop Color="{StaticResource PrimaryGradientStart}" Offset="0" />
              <GradientStop Color="{StaticResource PrimaryGradientEnd}" Offset="1" />
            </LinearGradientBrush>
          </Border.Background>
          <Label Text="OV" FontSize="12" FontAttributes="Bold" TextColor="White"
                 HorizontalOptions="Center" VerticalOptions="Center" />
        </Border>
        <VerticalStackLayout VerticalOptions="Center">
          <Label Text="OneVo Workspace" FontSize="13" FontAttributes="Bold"
                 TextColor="{StaticResource TextPrimary}" />
          <Label Text="Your Workplace. Simplified."
                 FontSize="10" TextColor="{StaticResource TextSecondary}" />
        </VerticalStackLayout>
      </HorizontalStackLayout>

      <!-- Right menu dots -->
      <Label Grid.Column="2" Text="•••" FontSize="20"
             TextColor="{StaticResource TextMuted}" VerticalOptions="Center" />
    </Grid>

    <!-- Middle: two-column main content -->
    <Grid Grid.Row="1" ColumnDefinitions="*,*"
          Padding="24,20,24,16" ColumnSpacing="24">

      <!-- Left: greeting + date/time + illustration -->
      <VerticalStackLayout Grid.Column="0" Spacing="0">

        <HorizontalStackLayout Spacing="6">
          <Label Text="{Binding Greeting, StringFormat='{0},'}"
                 FontSize="22" FontAttributes="Bold" TextColor="{StaticResource TextPrimary}" />
        </HorizontalStackLayout>
        <HorizontalStackLayout Spacing="8" Margin="0,2,0,0">
          <Label Text="{Binding EmployeeName}"
                 FontSize="22" FontAttributes="Bold" TextColor="{StaticResource Primary}" />
          <Label Text="👋" FontSize="20" />
        </HorizontalStackLayout>
        <Label Text="Welcome back to OneVo Workspace. Ready to begin your workday?"
               FontSize="12" TextColor="{StaticResource TextSecondary}"
               Margin="0,6,0,20" />

        <!-- Date + Time cards -->
        <Grid ColumnDefinitions="*,*" ColumnSpacing="10" Margin="0,0,0,20">
          <Border Grid.Column="0" Style="{StaticResource Card}" Padding="12,10">
            <VerticalStackLayout Spacing="2">
              <Label Text="📅  Today's Date"
                     FontSize="10" TextColor="{StaticResource TextSecondary}" />
              <Label Text="{Binding CurrentDate, StringFormat='{0:dddd, MMM d}'}"
                     FontSize="12" FontAttributes="Bold" TextColor="{StaticResource Primary}"
                     LineBreakMode="WordWrap" />
            </VerticalStackLayout>
          </Border>
          <Border Grid.Column="1" Style="{StaticResource Card}" Padding="12,10">
            <VerticalStackLayout Spacing="2">
              <Label Text="🕐  Current Time"
                     FontSize="10" TextColor="{StaticResource TextSecondary}" />
              <Label Text="{Binding CurrentDate, StringFormat='{0:hh:mm tt}'}"
                     FontSize="12" FontAttributes="Bold" TextColor="{StaticResource Primary}" />
            </VerticalStackLayout>
          </Border>
        </Grid>

        <!-- Illustration placeholder -->
        <Border Style="{StaticResource Card}" Padding="20,28" VerticalOptions="FillAndExpand">
          <VerticalStackLayout VerticalOptions="Center">
            <Label Text="💼" FontSize="64" HorizontalOptions="Center" />
            <Label Text="OneVo Workspace" FontSize="12" FontAttributes="Bold"
                   TextColor="{StaticResource Primary}" HorizontalOptions="Center"
                   Margin="0,8,0,0" />
            <Label Text="Your attendance, simplified."
                   FontSize="10" TextColor="{StaticResource TextSecondary}"
                   HorizontalOptions="Center" />
          </VerticalStackLayout>
        </Border>

      </VerticalStackLayout>

      <!-- Right: status + CLOCK IN -->
      <VerticalStackLayout Grid.Column="1" Spacing="0">

        <!-- Ready to start work header -->
        <HorizontalStackLayout Spacing="10" Margin="0,0,0,4">
          <Ellipse WidthRequest="14" HeightRequest="14"
                   Fill="{StaticResource StatusGreen}"
                   VerticalOptions="Center" />
          <Label Text="Ready to Start Work"
                 FontSize="18" FontAttributes="Bold"
                 TextColor="{StaticResource TextPrimary}" />
        </HorizontalStackLayout>
        <Label Text="Click the button below to begin today's attendance."
               FontSize="12" TextColor="{StaticResource TextSecondary}"
               Margin="0,0,0,20" />

        <!-- Working Status + Live Timer card -->
        <Border Style="{StaticResource Card}" Margin="0,0,0,20" Padding="16,14">
          <Grid ColumnDefinitions="*,*" ColumnSpacing="16">
            <VerticalStackLayout Grid.Column="0" Spacing="2">
              <Label Text="Working Status"
                     FontSize="11" TextColor="{StaticResource TextSecondary}" />
              <Label Text="Ready" FontSize="15" FontAttributes="Bold"
                     TextColor="{StaticResource Primary}" />
            </VerticalStackLayout>
            <VerticalStackLayout Grid.Column="1" Spacing="2">
              <Label Text="Live Timer"
                     FontSize="11" TextColor="{StaticResource TextSecondary}" />
              <Label Text="{Binding LiveTimer}"
                     FontSize="18" FontAttributes="Bold"
                     TextColor="{StaticResource TextPrimary}" />
            </VerticalStackLayout>
          </Grid>
        </Border>

        <!-- CLOCK IN button -->
        <Border StrokeShape="RoundRectangle 32" StrokeThickness="0"
                HeightRequest="72" Margin="0,0,0,0">
          <Border.Background>
            <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
              <GradientStop Color="{StaticResource PrimaryGradientStart}" Offset="0" />
              <GradientStop Color="{StaticResource PrimaryGradientEnd}" Offset="1" />
            </LinearGradientBrush>
          </Border.Background>
          <Button Text="🕐  CLOCK IN"
                  Command="{Binding ClockInCommand}"
                  BackgroundColor="Transparent"
                  TextColor="White"
                  FontSize="20"
                  FontAttributes="Bold"
                  HeightRequest="72"
                  HorizontalOptions="Fill" />
        </Border>

        <!-- Error + spinner -->
        <Label Text="{Binding ErrorMessage}" TextColor="{StaticResource StatusRed}"
               FontSize="12" Margin="0,8,0,0"
               IsVisible="{Binding ErrorMessage, Converter={StaticResource IsNotNullConverter}}" />
        <ActivityIndicator IsRunning="{Binding IsClockinIn}"
                           IsVisible="{Binding IsClockinIn}"
                           Color="{StaticResource Primary}"
                           Margin="0,8,0,0" />

        <!-- Spacer -->
        <BoxView HeightRequest="1" BackgroundColor="Transparent" VerticalOptions="FillAndExpand" />

        <!-- Footer connection info -->
        <HorizontalStackLayout Spacing="8" HorizontalOptions="Center">
          <Ellipse WidthRequest="8" HeightRequest="8"
                   Fill="{StaticResource StatusGreen}" VerticalOptions="Center" />
          <Label Text="Connected to OneVo Server"
                 FontSize="11" TextColor="{StaticResource TextSecondary}" />
        </HorizontalStackLayout>

      </VerticalStackLayout>
    </Grid>

    <!-- Bottom: 3 status cards -->
    <Grid Grid.Row="2" ColumnDefinitions="*,*,*"
          ColumnSpacing="12" Padding="24,0,24,20">

      <!-- Current Status -->
      <Border Grid.Column="0" Style="{StaticResource Card}" Padding="12,10">
        <HorizontalStackLayout Spacing="10">
          <Ellipse WidthRequest="10" HeightRequest="10"
                   Fill="{StaticResource StatusGreen}"
                   VerticalOptions="Center" />
          <VerticalStackLayout>
            <Label Text="Current Status"
                   FontSize="10" TextColor="{StaticResource TextSecondary}" />
            <Label Text="{Binding ConnectionStatus}"
                   FontSize="12" FontAttributes="Bold"
                   TextColor="{StaticResource TextPrimary}" />
          </VerticalStackLayout>
        </HorizontalStackLayout>
      </Border>

      <!-- Internet -->
      <Border Grid.Column="1" Style="{StaticResource Card}" Padding="12,10">
        <HorizontalStackLayout Spacing="10">
          <Label Text="🌐" FontSize="16" VerticalOptions="Center" />
          <VerticalStackLayout>
            <Label Text="Internet"
                   FontSize="10" TextColor="{StaticResource TextSecondary}" />
            <Label Text="{Binding InternetStatus}"
                   FontSize="12" FontAttributes="Bold"
                   TextColor="{StaticResource TextPrimary}" />
          </VerticalStackLayout>
        </HorizontalStackLayout>
      </Border>

      <!-- Device -->
      <Border Grid.Column="2" Style="{StaticResource Card}" Padding="12,10">
        <HorizontalStackLayout Spacing="10">
          <Label Text="🖥" FontSize="16" VerticalOptions="Center" />
          <VerticalStackLayout>
            <Label Text="Device"
                   FontSize="10" TextColor="{StaticResource TextSecondary}" />
            <Label Text="{Binding DeviceType}"
                   FontSize="12" FontAttributes="Bold"
                   TextColor="{StaticResource TextPrimary}" />
          </VerticalStackLayout>
        </HorizontalStackLayout>
      </Border>

    </Grid>
  </Grid>
</ContentPage>
