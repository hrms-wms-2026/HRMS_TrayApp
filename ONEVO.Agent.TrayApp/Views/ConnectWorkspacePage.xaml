<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:ONEVO.Agent.TrayApp.ViewModels"
             xmlns:controls="clr-namespace:ONEVO.Agent.TrayApp.Controls"
             x:Class="ONEVO.Agent.TrayApp.Views.ConnectWorkspacePage"
             x:DataType="vm:ConnectWorkspaceViewModel"
             Title="Connect ONEVO Workspace">

  <Grid RowDefinitions="Auto,*,Auto" Padding="{StaticResource TrayPagePadding}">
    <Grid.Background>
      <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="{StaticResource BackgroundWashStart}" Offset="0" />
        <GradientStop Color="#EEF2FF" Offset="0.45" />
        <GradientStop Color="{StaticResource BackgroundWashEnd}" Offset="1" />
      </LinearGradientBrush>
    </Grid.Background>

    <controls:AppHeaderBar Grid.Row="0" ShowSubtitle="False" />

    <Grid x:Name="PaneGrid" Grid.Row="1" ColumnDefinitions="5*,6*" ColumnSpacing="20">

      <!-- Ambient glow blobs sit behind the glass panels so the translucency has something to catch -->
      <Ellipse Grid.ColumnSpan="2" WidthRequest="520" HeightRequest="520"
               HorizontalOptions="Start" VerticalOptions="Start" Margin="-160,-120,0,0" Opacity="0.95">
        <Ellipse.Fill>
          <RadialGradientBrush Center="0.5,0.5" Radius="0.5">
            <GradientStop Color="{StaticResource GlassGlowPrimary}" Offset="0" />
            <GradientStop Color="#00175CFF" Offset="1" />
          </RadialGradientBrush>
        </Ellipse.Fill>
      </Ellipse>
      <Ellipse Grid.Column="1" WidthRequest="420" HeightRequest="420"
               HorizontalOptions="End" VerticalOptions="End" Margin="0,0,-120,-80" Opacity="0.95">
        <Ellipse.Fill>
          <RadialGradientBrush Center="0.5,0.5" Radius="0.5">
            <GradientStop Color="{StaticResource GlassGlowAccent}" Offset="0" />
            <GradientStop Color="#006D28D9" Offset="1" />
          </RadialGradientBrush>
        </Ellipse.Fill>
      </Ellipse>
      <Ellipse Grid.Column="1" WidthRequest="280" HeightRequest="280"
               HorizontalOptions="Center" VerticalOptions="Start" Margin="40,-80,0,0" Opacity="0.65">
        <Ellipse.Fill>
          <RadialGradientBrush Center="0.5,0.5" Radius="0.5">
            <GradientStop Color="{StaticResource GlassGlowPrimary}" Offset="0" />
            <GradientStop Color="#00175CFF" Offset="1" />
          </RadialGradientBrush>
        </Ellipse.Fill>
      </Ellipse>

      <!-- Left: 3D workspace photo (raster — not reconstructed in XAML) -->
      <Grid x:Name="LeftPane" Grid.Column="0" MinimumWidthRequest="0">
        <Image Source="workspace_connect.png"
               Aspect="AspectFit"
               HorizontalOptions="Fill"
               VerticalOptions="Fill"
               Margin="0,4,4,4" />
      </Grid>

      <!-- Right: form — fills the pane, no scroll -->
            <Grid x:Name="RightPane" Grid.Column="1"
            RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,*"
            Padding="4,0,0,0">

          <Label Grid.Row="0" Margin="0,0,0,4">
            <Label.FormattedText>
              <FormattedString>
                <Span Text="Welcome to " FontSize="24" FontAttributes="Bold"
                      TextColor="{StaticResource TextPrimary}" />
                <Span Text="ONEVO Workspace" FontSize="24" FontAttributes="Bold"
                      TextColor="{StaticResource BrandTitle}" />
              </FormattedString>
            </Label.FormattedText>
          </Label>
          <Label Grid.Row="1"
                 Text="Paste your activation code below to securely connect your desktop application."
                 Style="{StaticResource PageSubtitle}"
                 HorizontalTextAlignment="Start"
                 Margin="0,0,0,12" />

          <Border Grid.Row="2" Style="{StaticResource TrayCompactGlassCard}" Padding="16,12" Margin="0,0,0,8">
            <VerticalStackLayout Spacing="8">
              <Label Text="Activation Code" FontAttributes="Bold"
                     TextColor="{StaticResource TextPrimary}" FontSize="13" />

              <Border Style="{StaticResource GlassInputRow}" Padding="14,6">
                <Grid ColumnDefinitions="*,Auto">
                  <Entry Grid.Column="0"
                         Placeholder="Paste your activation code here..."
                         Text="{Binding ActivationCode}"
                         IsEnabled="{Binding IsConnecting, Converter={StaticResource InvertBoolConverter}}"
                         FontSize="15"
                         FontAttributes="Bold"
                         TextColor="{StaticResource TextPrimary}"
                         PlaceholderColor="{StaticResource TextMuted}"
                         BackgroundColor="Transparent"
                         Keyboard="Text" />
                  <Button Grid.Column="1"
                          Text="{StaticResource IconPaste}"
                          FontFamily="Segoe MDL2 Assets"
                          FontSize="16"
                          TextColor="{StaticResource Primary}"
                          BackgroundColor="Transparent"
                          WidthRequest="40" HeightRequest="40"
                          Command="{Binding PasteActivationCodeCommand}"
                          ToolTipProperties.Text="Paste from clipboard" />
                </Grid>
              </Border>

              <HorizontalStackLayout Spacing="6">
                <Label Text="{StaticResource IconInfo}" FontFamily="Segoe MDL2 Assets"
                       FontSize="12" TextColor="{StaticResource TextSecondary}" VerticalOptions="Center" />
                <Label Text="{Binding HintText}"
                       FontSize="11" TextColor="{StaticResource TextSecondary}" />
              </HorizontalStackLayout>
            </VerticalStackLayout>
          </Border>

          <Label Grid.Row="3" Text="{Binding ErrorMessage}" TextColor="{StaticResource StatusRed}"
                 FontSize="12" Margin="4,0,0,6"
                 IsVisible="{Binding ErrorMessage, Converter={StaticResource IsNotNullConverter}}" />

          <Border Grid.Row="4" Style="{StaticResource TrayPrimaryActionBorder}" Margin="0,2,0,0">
            <Border.Background>
              <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                <GradientStop Color="{StaticResource ConnectButtonStart}" Offset="0" />
                <GradientStop Color="{StaticResource ConnectButtonMid}" Offset="0.55" />
                <GradientStop Color="{StaticResource ConnectButtonEnd}" Offset="1" />
              </LinearGradientBrush>
            </Border.Background>
            <Grid>
              <Button Command="{Binding VerifyAndConnectCommand}"
                      Style="{StaticResource TrayPrimaryActionOverlay}"
                      Text=""
                      SemanticProperties.Description="Connect and login" />
              <HorizontalStackLayout InputTransparent="True"
                                     HorizontalOptions="Center"
                                     VerticalOptions="Center"
                                     Spacing="8">
                <Label Text="{StaticResource IconLink}" FontFamily="Segoe MDL2 Assets"
                       FontSize="16" TextColor="White" VerticalOptions="Center" />
                <Label Text="Connect &amp; Login" FontSize="15" FontAttributes="Bold"
                       TextColor="White" VerticalOptions="Center" />
              </HorizontalStackLayout>
            </Grid>
          </Border>

          <ActivityIndicator Grid.Row="5"
                             IsRunning="{Binding IsConnecting}"
                             IsVisible="{Binding IsConnecting}"
                             Color="{StaticResource Primary}"
                             Margin="0,8,0,0" />

          <Grid Grid.Row="6" ColumnDefinitions="*,*" ColumnSpacing="12"
                VerticalOptions="End" Margin="0,12,0,0">
            <Border Grid.Column="0" Style="{StaticResource TrayCompactGlassCard}" Padding="12,10">
              <VerticalStackLayout Spacing="4">
                <HorizontalStackLayout Spacing="8">
                  <Border WidthRequest="28" HeightRequest="28"
                          StrokeShape="RoundRectangle 14" BackgroundColor="{StaticResource AccentSoft}"
                          StrokeThickness="0">
                    <Label Text="{StaticResource IconHelp}" FontFamily="Segoe MDL2 Assets"
                           FontSize="13" TextColor="{StaticResource BrandTitle}"
                           HorizontalOptions="Center" VerticalOptions="Center" />
                  </Border>
                  <Label Text="Need Help?" FontAttributes="Bold"
                         TextColor="{StaticResource TextPrimary}" FontSize="13"
                         VerticalOptions="Center" />
                </HorizontalStackLayout>
                <Label Text="If you don't have an activation code, open the ONEVO web portal and generate one."
                       FontSize="11" TextColor="{StaticResource TextSecondary}" />
              </VerticalStackLayout>
            </Border>
            <Border Grid.Column="1" Style="{StaticResource TrayCompactGlassCard}" Padding="12,10">
              <VerticalStackLayout Spacing="4">
                <HorizontalStackLayout Spacing="8">
                  <Border WidthRequest="28" HeightRequest="28"
                          StrokeShape="RoundRectangle 14" BackgroundColor="{StaticResource AccentSoft}"
                          StrokeThickness="0">
                    <Label Text="{StaticResource IconShield}" FontFamily="Segoe MDL2 Assets"
                           FontSize="13" TextColor="{StaticResource BrandTitle}"
                           HorizontalOptions="Center" VerticalOptions="Center" />
                  </Border>
                  <Label Text="Secure Connection" FontAttributes="Bold"
                         TextColor="{StaticResource TextPrimary}" FontSize="13"
                         VerticalOptions="Center" />
                </HorizontalStackLayout>
                <Label Text="All communication is encrypted and protected using enterprise-grade security."
                       FontSize="11" TextColor="{StaticResource TextSecondary}" />
              </VerticalStackLayout>
            </Border>
          </Grid>
      </Grid>
    </Grid>

    <controls:FooterStatusBar Grid.Row="2"
                              VersionText="{Binding VersionText}"
                              ConnectionLabel="{Binding ConnectionLabel}"
                              IsConnected="{Binding IsConnected}" />
  </Grid>
</ContentPage>
