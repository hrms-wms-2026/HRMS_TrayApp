<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:ONEVO.Agent.TrayApp.ViewModels"
             xmlns:controls="clr-namespace:ONEVO.Agent.TrayApp.Controls"
             x:Class="ONEVO.Agent.TrayApp.Views.ConnectWorkspacePage"
             x:DataType="vm:ConnectWorkspaceViewModel"
             Title="Connect OneXso Workspace">

  <Grid RowDefinitions="Auto,*,Auto" Padding="20,16">
    <Grid.Background>
      <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="{StaticResource BackgroundWashStart}" Offset="0" />
        <GradientStop Color="{StaticResource BackgroundWashEnd}" Offset="1" />
      </LinearGradientBrush>
    </Grid.Background>

    <controls:AppHeaderBar Grid.Row="0" ShowSubtitle="False" />

    <Grid x:Name="PaneGrid" Grid.Row="1" ColumnDefinitions="5*,6*" ColumnSpacing="24">

      <!-- Ambient glow blobs sit behind the glass panels so the translucency has something to catch -->
      <Ellipse Grid.ColumnSpan="2" WidthRequest="440" HeightRequest="440"
               HorizontalOptions="Start" VerticalOptions="Start" Margin="-120,-100,0,0" Opacity="0.85">
        <Ellipse.Fill>
          <RadialGradientBrush Center="0.5,0.5" Radius="0.5">
            <GradientStop Color="{StaticResource GlassGlowPrimary}" Offset="0" />
            <GradientStop Color="#00175CFF" Offset="1" />
          </RadialGradientBrush>
        </Ellipse.Fill>
      </Ellipse>
      <Ellipse Grid.Column="1" WidthRequest="380" HeightRequest="380"
               HorizontalOptions="End" VerticalOptions="End" Margin="0,0,-100,-100" Opacity="0.85">
        <Ellipse.Fill>
          <RadialGradientBrush Center="0.5,0.5" Radius="0.5">
            <GradientStop Color="{StaticResource GlassGlowAccent}" Offset="0" />
            <GradientStop Color="#006D28D9" Offset="1" />
          </RadialGradientBrush>
        </Ellipse.Fill>
      </Ellipse>
      <Ellipse Grid.Column="1" WidthRequest="260" HeightRequest="260"
               HorizontalOptions="Center" VerticalOptions="Start" Margin="0,-60,0,0" Opacity="0.5">
        <Ellipse.Fill>
          <RadialGradientBrush Center="0.5,0.5" Radius="0.5">
            <GradientStop Color="{StaticResource GlassGlowPrimary}" Offset="0" />
            <GradientStop Color="#00175CFF" Offset="1" />
          </RadialGradientBrush>
        </Ellipse.Fill>
      </Ellipse>

      <!-- Left: illustration panel -->
      <Border x:Name="LeftPane" Grid.Column="0" Style="{StaticResource GlassPanel}"
              MinimumWidthRequest="0">
        <Grid>
          <Ellipse WidthRequest="220" HeightRequest="220"
                   HorizontalOptions="Center" VerticalOptions="Center" Opacity="0.35">
            <Ellipse.Fill>
              <RadialGradientBrush Center="0.5,0.5" Radius="0.5">
                <GradientStop Color="#B8C9FF" Offset="0" />
                <GradientStop Color="#B8C9FF00" Offset="1" />
              </RadialGradientBrush>
            </Ellipse.Fill>
          </Ellipse>

          <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Center" Spacing="10" Padding="24">
            <!-- Cloud lock stack -->
            <Border WidthRequest="88" HeightRequest="64" Style="{StaticResource GlassInputRow}"
                    StrokeShape="RoundRectangle 20"
                    HorizontalOptions="Center" Margin="0,0,0,4">
              <Label Text="{StaticResource IconShield}" FontFamily="Segoe MDL2 Assets"
                     FontSize="32" TextColor="{StaticResource Primary}"
                     HorizontalOptions="Center" VerticalOptions="Center" />
            </Border>

            <Label Text="💻" FontSize="72" HorizontalOptions="Center" />
            <Border Style="{StaticResource GlassInputRow}" StrokeShape="RoundRectangle 14"
                    Padding="12,8" HorizontalOptions="Center">
              <HorizontalStackLayout Spacing="8">
                <Image Source="onexso_logo_mark.svg"
                       Aspect="AspectFit"
                       WidthRequest="28" HeightRequest="28"
                       VerticalOptions="Center" />
                <Label Text="Connected" FontSize="12" FontAttributes="Bold"
                       TextColor="{StaticResource StatusGreen}" VerticalOptions="Center" />
              </HorizontalStackLayout>
            </Border>
          </VerticalStackLayout>
        </Grid>
      </Border>

      <!-- Right: form -->
      <VerticalStackLayout x:Name="RightPane" Grid.Column="1" Spacing="0" Padding="4,0,0,0" VerticalOptions="Center">

          <HorizontalStackLayout Spacing="6" Margin="0,0,0,6">
            <Label Text="Welcome to " Style="{StaticResource PageTitle}" />
            <Label Text="OneXso Workspace" Style="{StaticResource PageTitleAccent}" />
          </HorizontalStackLayout>
          <Label Text="Paste your activation code below to securely&#x0a;connect your desktop application."
                 Style="{StaticResource PageSubtitle}"
                 HorizontalTextAlignment="Start"
                 Margin="0,0,0,22" />

          <Border Style="{StaticResource GlassCard}" Margin="0,0,0,10">
            <VerticalStackLayout Spacing="10">
              <Label Text="Activation Code" FontAttributes="Bold"
                     TextColor="{StaticResource TextPrimary}" FontSize="13" />

              <Border Style="{StaticResource GlassInputRow}">
                <Grid ColumnDefinitions="*,Auto">
                  <Entry Grid.Column="0"
                         Placeholder="Paste your activation code here..."
                         Text="{Binding ActivationCode}"
                         IsEnabled="{Binding IsConnecting, Converter={StaticResource InvertBoolConverter}}"
                         FontSize="15"
                         FontAttributes="Bold"
                         TextColor="{StaticResource TextPrimary}"
                         PlaceholderColor="{StaticResource TextMuted}"
                         BackgroundColor="Transparent"
                         Keyboard="Text" />
                  <Button Grid.Column="1"
                          Text="{StaticResource IconPaste}"
                          FontFamily="Segoe MDL2 Assets"
                          FontSize="16"
                          TextColor="{StaticResource Primary}"
                          BackgroundColor="Transparent"
                          WidthRequest="40" HeightRequest="40"
                          Command="{Binding PasteActivationCodeCommand}"
                          ToolTipProperties.Text="Paste from clipboard" />
                </Grid>
              </Border>

              <HorizontalStackLayout Spacing="6">
                <Label Text="{StaticResource IconInfo}" FontFamily="Segoe MDL2 Assets"
                       FontSize="12" TextColor="{StaticResource TextSecondary}" VerticalOptions="Center" />
                <Label Text="{Binding HintText}"
                       FontSize="11" TextColor="{StaticResource TextSecondary}" />
              </HorizontalStackLayout>
            </VerticalStackLayout>
          </Border>

          <Label Text="{Binding ErrorMessage}" TextColor="{StaticResource StatusRed}"
                 FontSize="12" Margin="4,4,0,4"
                 IsVisible="{Binding ErrorMessage, Converter={StaticResource IsNotNullConverter}}" />

          <Border Style="{StaticResource GradientButtonBorder}" Margin="0,8,0,0">
            <Button Text="🔗  Connect"
                    Command="{Binding VerifyAndConnectCommand}"
                    Style="{StaticResource GradientButtonOverlay}" />
          </Border>

          <Button Text="🌐  Open Activation Website"
                  Command="{Binding OpenEmployeePortalCommand}"
                  Style="{StaticResource OutlineButton}"
                  Margin="0,12,0,0" />

          <ActivityIndicator IsRunning="{Binding IsConnecting}"
                             IsVisible="{Binding IsConnecting}"
                             Color="{StaticResource Primary}"
                             Margin="0,12,0,0" />

          <Grid ColumnDefinitions="*,*" ColumnSpacing="12" Margin="0,24,0,0">
            <Border Grid.Column="0" Style="{StaticResource GlassCard}" Padding="14,12">
              <VerticalStackLayout Spacing="6">
                <HorizontalStackLayout Spacing="8">
                  <Border WidthRequest="28" HeightRequest="28"
                          StrokeShape="RoundRectangle 14" BackgroundColor="{StaticResource AccentSoft}"
                          StrokeThickness="0">
                    <Label Text="{StaticResource IconHelp}" FontFamily="Segoe MDL2 Assets"
                           FontSize="13" TextColor="{StaticResource Primary}"
                           HorizontalOptions="Center" VerticalOptions="Center" />
                  </Border>
                  <Label Text="Need Help?" FontAttributes="Bold"
                         TextColor="{StaticResource TextPrimary}" FontSize="13"
                         VerticalOptions="Center" />
                </HorizontalStackLayout>
                <Label Text="If you don't have an activation code, open the OneXso Workspace web portal and generate one."
                       FontSize="11" TextColor="{StaticResource TextSecondary}" />
              </VerticalStackLayout>
            </Border>
            <Border Grid.Column="1" Style="{StaticResource GlassCard}" Padding="14,12">
              <VerticalStackLayout Spacing="6">
                <HorizontalStackLayout Spacing="8">
                  <Border WidthRequest="28" HeightRequest="28"
                          StrokeShape="RoundRectangle 14" BackgroundColor="{StaticResource AccentSoft}"
                          StrokeThickness="0">
                    <Label Text="{StaticResource IconShield}" FontFamily="Segoe MDL2 Assets"
                           FontSize="13" TextColor="{StaticResource Primary}"
                           HorizontalOptions="Center" VerticalOptions="Center" />
                  </Border>
                  <Label Text="Secure Connection" FontAttributes="Bold"
                         TextColor="{StaticResource TextPrimary}" FontSize="13"
                         VerticalOptions="Center" />
                </HorizontalStackLayout>
                <Label Text="All communication is encrypted and protected using enterprise-grade security."
                       FontSize="11" TextColor="{StaticResource TextSecondary}" />
              </VerticalStackLayout>
            </Border>
          </Grid>
      </VerticalStackLayout>
    </Grid>

    <controls:FooterStatusBar Grid.Row="2"
                              VersionText="{Binding VersionText}"
                              ConnectionLabel="{Binding ConnectionLabel}"
                              IsConnected="{Binding IsConnected}" />
  </Grid>
</ContentPage>
