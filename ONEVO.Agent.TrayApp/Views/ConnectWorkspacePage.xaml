<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:ONEVO.Agent.TrayApp.ViewModels"
             xmlns:controls="clr-namespace:ONEVO.Agent.TrayApp.Controls"
             x:Class="ONEVO.Agent.TrayApp.Views.ConnectWorkspacePage"
             x:DataType="vm:ConnectWorkspaceViewModel"
             Shell.NavBarIsVisible="False"
             Title="OneXso WorkPulse">

  <Grid RowDefinitions="*,Auto" Padding="28,16,28,12">
    <Grid.Background>
      <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="{StaticResource BackgroundWashStart}" Offset="0" />
        <GradientStop Color="#EEF2FF" Offset="0.45" />
        <GradientStop Color="{StaticResource BackgroundWashEnd}" Offset="1" />
      </LinearGradientBrush>
    </Grid.Background>

    <Grid x:Name="PaneGrid" Grid.Row="0" ColumnDefinitions="*,*" ColumnSpacing="32">

      <Ellipse Grid.ColumnSpan="2" WidthRequest="520" HeightRequest="520"
               HorizontalOptions="Start" VerticalOptions="Start" Margin="-160,-120,0,0"
               Opacity="0.95" InputTransparent="True">
        <Ellipse.Fill>
          <RadialGradientBrush Center="0.5,0.5" Radius="0.5">
            <GradientStop Color="{StaticResource GlassGlowPrimary}" Offset="0" />
            <GradientStop Color="#00175CFF" Offset="1" />
          </RadialGradientBrush>
        </Ellipse.Fill>
      </Ellipse>
      <Ellipse Grid.Column="1" WidthRequest="420" HeightRequest="420"
               HorizontalOptions="End" VerticalOptions="End" Margin="0,0,-120,-80"
               Opacity="0.95" InputTransparent="True">
        <Ellipse.Fill>
          <RadialGradientBrush Center="0.5,0.5" Radius="0.5">
            <GradientStop Color="{StaticResource GlassGlowAccent}" Offset="0" />
            <GradientStop Color="#006D28D9" Offset="1" />
          </RadialGradientBrush>
        </Ellipse.Fill>
      </Ellipse>
      <Ellipse Grid.Column="1" WidthRequest="280" HeightRequest="280"
               HorizontalOptions="Center" VerticalOptions="Start" Margin="40,-80,0,0"
               Opacity="0.65" InputTransparent="True">
        <Ellipse.Fill>
          <RadialGradientBrush Center="0.5,0.5" Radius="0.5">
            <GradientStop Color="{StaticResource GlassGlowPrimary}" Offset="0" />
            <GradientStop Color="#00175CFF" Offset="1" />
          </RadialGradientBrush>
        </Ellipse.Fill>
      </Ellipse>

      <Grid x:Name="LeftPane" Grid.Column="0" MinimumWidthRequest="0">
        <Image Source="workspace_connect.png"
               Aspect="AspectFit"
               HorizontalOptions="Fill"
               VerticalOptions="Center"
               Margin="0,8,8,8" />
      </Grid>

      <VerticalStackLayout x:Name="RightPane" Grid.Column="1"
                           Spacing="0"
                           Padding="4,24,0,0"
                           VerticalOptions="Start">

          <Label Margin="0,0,0,8">
            <Label.FormattedText>
              <FormattedString>
                <Span Text="Welcome to " FontSize="26" FontAttributes="Bold"
                      TextColor="{StaticResource TextPrimary}" />
                <Span Text="OneXso Workspace" FontSize="26" FontAttributes="Bold"
                      TextColor="{StaticResource BrandTitle}" />
              </FormattedString>
            </Label.FormattedText>
          </Label>
          <Label Text="Paste your activation code below to securely connect your desktop application."
                 Style="{StaticResource PageSubtitle}"
                 HorizontalTextAlignment="Start"
                 FontSize="13"
                 Margin="0,0,0,18" />

          <Border Style="{StaticResource TrayCompactGlassCard}" Padding="18,16" Margin="0,0,0,14">
            <VerticalStackLayout Spacing="10">
              <Label Text="Activation Code" FontAttributes="Bold"
                     TextColor="{StaticResource TextPrimary}" FontSize="13" />

              <Border Stroke="{StaticResource InputStroke}"
                      StrokeThickness="1.4"
                      StrokeShape="RoundRectangle 12"
                      BackgroundColor="White"
                      Padding="14,2">
                <Grid ColumnDefinitions="*,Auto" HeightRequest="44">
                  <Entry Grid.Column="0"
                         Placeholder="Paste your activation code here..."
                         Text="{Binding ActivationCode}"
                         IsEnabled="{Binding IsConnecting, Converter={StaticResource InvertBoolConverter}}"
                         FontSize="16"
                         FontAttributes="Bold"
                         TextColor="{StaticResource TextPrimary}"
                         PlaceholderColor="{StaticResource TextMuted}"
                         BackgroundColor="Transparent"
                         VerticalOptions="Center"
                         Keyboard="Text" />
                  <Button Grid.Column="1"
                          Text="{StaticResource IconPaste}"
                          FontFamily="Segoe MDL2 Assets"
                          FontSize="16"
                          TextColor="{StaticResource Primary}"
                          BackgroundColor="Transparent"
                          WidthRequest="40" HeightRequest="40"
                          VerticalOptions="Center"
                          Command="{Binding PasteActivationCodeCommand}"
                          ToolTipProperties.Text="Paste from clipboard" />
                </Grid>
              </Border>

              <HorizontalStackLayout Spacing="6">
                <Label Text="{StaticResource IconInfo}" FontFamily="Segoe MDL2 Assets"
                       FontSize="12" TextColor="{StaticResource TextSecondary}" VerticalOptions="Center" />
                <Label Text="{Binding HintText}"
                       FontSize="11" TextColor="{StaticResource TextSecondary}"
                       LineBreakMode="WordWrap" />
              </HorizontalStackLayout>
            </VerticalStackLayout>
          </Border>

          <Label Text="{Binding ErrorMessage}" TextColor="{StaticResource StatusRed}"
                 FontSize="12" Margin="4,0,0,10"
                 IsVisible="{Binding ErrorMessage, Converter={StaticResource IsNotNullConverter}}" />

          <Border Style="{StaticResource TrayPrimaryActionBorder}" Margin="0,0,0,10">
            <Border.Background>
              <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                <GradientStop Color="{StaticResource ConnectButtonStart}" Offset="0" />
                <GradientStop Color="{StaticResource ConnectButtonMid}" Offset="0.55" />
                <GradientStop Color="{StaticResource ConnectButtonEnd}" Offset="1" />
              </LinearGradientBrush>
            </Border.Background>
            <Grid>
              <Button Command="{Binding VerifyAndConnectCommand}"
                      Style="{StaticResource TrayPrimaryActionOverlay}"
                      Text=""
                      SemanticProperties.Description="Connect" />
              <HorizontalStackLayout InputTransparent="True"
                                     HorizontalOptions="Center"
                                     VerticalOptions="Center"
                                     Spacing="8">
                <Label Text="{StaticResource IconLink}" FontFamily="Segoe MDL2 Assets"
                       FontSize="16" TextColor="White" VerticalOptions="Center" />
                <Label Text="Connect" FontSize="15" FontAttributes="Bold"
                       TextColor="White" VerticalOptions="Center" />
              </HorizontalStackLayout>
            </Grid>
          </Border>

          <Border Style="{StaticResource TraySecondaryActionBorder}" Margin="0,0,0,16">
            <Grid>
              <Button Command="{Binding OpenActivationWebsiteCommand}"
                      Style="{StaticResource TrayPrimaryActionOverlay}"
                      Text=""
                      SemanticProperties.Description="Open activation website" />
              <HorizontalStackLayout InputTransparent="True"
                                     HorizontalOptions="Center"
                                     VerticalOptions="Center"
                                     Spacing="8">
                <Label Text="{StaticResource IconGlobe}" FontFamily="Segoe MDL2 Assets"
                       FontSize="16" TextColor="{StaticResource Primary}" VerticalOptions="Center" />
                <Label Text="Open Activation Website" FontSize="15" FontAttributes="Bold"
                       TextColor="{StaticResource Primary}" VerticalOptions="Center" />
              </HorizontalStackLayout>
            </Grid>
          </Border>

          <ActivityIndicator IsRunning="{Binding IsConnecting}"
                             IsVisible="{Binding IsConnecting}"
                             Color="{StaticResource Primary}"
                             Margin="0,0,0,12" />

          <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
            <Border Grid.Column="0" Style="{StaticResource TrayCompactGlassCard}" Padding="14,12">
              <VerticalStackLayout Spacing="6">
                <HorizontalStackLayout Spacing="8">
                  <Border WidthRequest="28" HeightRequest="28"
                          StrokeShape="RoundRectangle 14" BackgroundColor="{StaticResource AccentSoft}"
                          StrokeThickness="0">
                    <Label Text="{StaticResource IconHelp}" FontFamily="Segoe MDL2 Assets"
                           FontSize="13" TextColor="{StaticResource BrandTitle}"
                           HorizontalOptions="Center" VerticalOptions="Center" />
                  </Border>
                  <Label Text="Need Help?" FontAttributes="Bold"
                         TextColor="{StaticResource TextPrimary}" FontSize="13"
                         VerticalOptions="Center" />
                </HorizontalStackLayout>
                <Label Text="If you do not have an activation code, open the OneXso Workspace web portal and generate one."
                       FontSize="11" TextColor="{StaticResource TextSecondary}"
                       LineBreakMode="WordWrap" />
              </VerticalStackLayout>
            </Border>
            <Border Grid.Column="1" Style="{StaticResource TrayCompactGlassCard}" Padding="14,12">
              <VerticalStackLayout Spacing="6">
                <HorizontalStackLayout Spacing="8">
                  <Border WidthRequest="28" HeightRequest="28"
                          StrokeShape="RoundRectangle 14" BackgroundColor="{StaticResource AccentSoft}"
                          StrokeThickness="0">
                    <Label Text="{StaticResource IconShield}" FontFamily="Segoe MDL2 Assets"
                           FontSize="13" TextColor="{StaticResource BrandTitle}"
                           HorizontalOptions="Center" VerticalOptions="Center" />
                  </Border>
                  <Label Text="Secure Connection" FontAttributes="Bold"
                         TextColor="{StaticResource TextPrimary}" FontSize="13"
                         VerticalOptions="Center" />
                </HorizontalStackLayout>
                <Label Text="All communication is encrypted and protected using enterprise-grade security."
                       FontSize="11" TextColor="{StaticResource TextSecondary}"
                       LineBreakMode="WordWrap" />
              </VerticalStackLayout>
            </Border>
          </Grid>
      </VerticalStackLayout>
    </Grid>

    <controls:FooterStatusBar Grid.Row="1"
                              VersionText="{Binding VersionText}"
                              ConnectionLabel="{Binding ConnectionLabel}"
                              IsConnected="{Binding IsConnected}" />
  </Grid>
</ContentPage>
