<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:ONEVO.Agent.TrayApp.ViewModels"
             xmlns:controls="clr-namespace:ONEVO.Agent.TrayApp.Controls"
             x:Class="ONEVO.Agent.TrayApp.Views.PrivacyTransparencyPage"
             x:DataType="vm:PrivacyTransparencyViewModel"
             Shell.NavBarIsVisible="False"
             Title="OneXso WorkPulse">

  <Grid RowDefinitions="*,Auto" Padding="28,16,28,12">
    <Grid.Background>
      <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="{StaticResource BackgroundWashStart}" Offset="0" />
        <GradientStop Color="{StaticResource BackgroundWashMid}" Offset="0.45" />
        <GradientStop Color="{StaticResource BackgroundWashEnd}" Offset="1" />
      </LinearGradientBrush>
    </Grid.Background>

    <Grid x:Name="PaneGrid" Grid.Row="0" ColumnDefinitions="*,*" ColumnSpacing="28">
      <Image x:Name="LeftPane" Grid.Column="0" Source="workspace_privacy.png" Aspect="AspectFit" VerticalOptions="Center" />

      <VerticalStackLayout x:Name="RightPane" Grid.Column="1" VerticalOptions="Center" Spacing="0">
        <Label Margin="0,0,0,6">
          <Label.FormattedText>
            <FormattedString>
              <Span Text="Privacy &amp; " FontSize="26" FontAttributes="Bold" TextColor="{StaticResource TextPrimary}" />
              <Span Text="Transparency" FontSize="26" FontAttributes="Bold" TextColor="{StaticResource BrandTitle}" />
            </FormattedString>
          </Label.FormattedText>
        </Label>
        <Label Text="Understand how your work data is used and your privacy rights."
               Style="{StaticResource PageSubtitle}" HorizontalTextAlignment="Start" Margin="0,0,0,14" />

        <Border Style="{StaticResource TrayCompactGlassCard}" Padding="16,14" StrokeShape="RoundRectangle 20" Margin="0,0,0,10">
          <VerticalStackLayout Spacing="0">
            <HorizontalStackLayout Spacing="10" Margin="0,0,0,8">
              <Border Style="{StaticResource IconTile}" BackgroundColor="{StaticResource AccentSoft}">
                <Image Source="icon_privacy_shield.png" WidthRequest="18" HeightRequest="18"
                       HorizontalOptions="Center" VerticalOptions="Center" />
              </Border>
              <Label Text="OneXso records" FontAttributes="Bold" FontSize="15" TextColor="{StaticResource TextPrimary}" VerticalOptions="Center" />
            </HorizontalStackLayout>
            <VerticalStackLayout Spacing="6" Margin="4,0,0,0">
              <HorizontalStackLayout Spacing="8">
                <Image Source="icon_check_circle.png" WidthRequest="16" HeightRequest="16" VerticalOptions="Center" />
                <Label Text="Work session times (clock in / out)" FontSize="14" TextColor="{StaticResource TextSecondary}" VerticalOptions="Center" />
              </HorizontalStackLayout>
              <HorizontalStackLayout Spacing="8">
                <Image Source="icon_check_circle.png" WidthRequest="16" HeightRequest="16" VerticalOptions="Center" />
                <Label Text="Work activity monitoring (active / idle periods)" FontSize="14" TextColor="{StaticResource TextSecondary}" VerticalOptions="Center" />
              </HorizontalStackLayout>
              <HorizontalStackLayout Spacing="8">
                <Image Source="icon_check_circle.png" WidthRequest="16" HeightRequest="16" VerticalOptions="Center" />
                <Label Text="Applications used and time spent" FontSize="14" TextColor="{StaticResource TextSecondary}" VerticalOptions="Center" />
              </HorizontalStackLayout>
              <HorizontalStackLayout Spacing="8">
                <Image Source="icon_check_circle.png" WidthRequest="16" HeightRequest="16" VerticalOptions="Center" />
                <Label Text="Meeting activity and duration" FontSize="14" TextColor="{StaticResource TextSecondary}" VerticalOptions="Center" />
              </HorizontalStackLayout>
              <HorizontalStackLayout Spacing="8">
                <Image Source="icon_check_circle.png" WidthRequest="16" HeightRequest="16" VerticalOptions="Center" />
                <Label Text="Device status and connectivity" FontSize="14" TextColor="{StaticResource TextSecondary}" VerticalOptions="Center" />
              </HorizontalStackLayout>
              <HorizontalStackLayout Spacing="8">
                <Image Source="icon_check_circle.png" WidthRequest="16" HeightRequest="16" VerticalOptions="Center" />
                <Label Text="Identity verification events" FontSize="14" TextColor="{StaticResource TextSecondary}" VerticalOptions="Center" />
              </HorizontalStackLayout>
            </VerticalStackLayout>
          </VerticalStackLayout>
        </Border>

        <Border Style="{StaticResource TrayCompactGlassCard}" Padding="16,14" StrokeShape="RoundRectangle 20" Margin="0,0,0,12">
          <VerticalStackLayout Spacing="0">
            <HorizontalStackLayout Spacing="10" Margin="0,0,0,8">
              <Border Style="{StaticResource IconTile}" BackgroundColor="{StaticResource AccentSoft}">
                <Image Source="icon_privacy_ban.png" WidthRequest="18" HeightRequest="18"
                       HorizontalOptions="Center" VerticalOptions="Center" />
              </Border>
              <Label Text="OneXso does not collect" FontAttributes="Bold" FontSize="15" TextColor="{StaticResource TextPrimary}" VerticalOptions="Center" />
            </HorizontalStackLayout>
            <VerticalStackLayout Spacing="6" Margin="4,0,0,0">
              <HorizontalStackLayout Spacing="8">
                <Image Source="icon_x_circle.png" WidthRequest="16" HeightRequest="16" VerticalOptions="Center" />
                <Label Text="Personal files or document contents" FontSize="14" TextColor="{StaticResource TextSecondary}" VerticalOptions="Center" />
              </HorizontalStackLayout>
              <HorizontalStackLayout Spacing="8">
                <Image Source="icon_x_circle.png" WidthRequest="16" HeightRequest="16" VerticalOptions="Center" />
                <Label Text="Keystrokes or typed text" FontSize="14" TextColor="{StaticResource TextSecondary}" VerticalOptions="Center" />
              </HorizontalStackLayout>
              <HorizontalStackLayout Spacing="8">
                <Image Source="icon_x_circle.png" WidthRequest="16" HeightRequest="16" VerticalOptions="Center" />
                <Label Text="Personal web browsing content" FontSize="14" TextColor="{StaticResource TextSecondary}" VerticalOptions="Center" />
              </HorizontalStackLayout>
              <HorizontalStackLayout Spacing="8">
                <Image Source="icon_x_circle.png" WidthRequest="16" HeightRequest="16" VerticalOptions="Center" />
                <Label Text="Audio or video from meetings" FontSize="14" TextColor="{StaticResource TextSecondary}" VerticalOptions="Center" />
              </HorizontalStackLayout>
            </VerticalStackLayout>
          </VerticalStackLayout>
        </Border>

        <HorizontalStackLayout Spacing="8" Margin="4,0,0,12" HorizontalOptions="Start">
          <CheckBox IsChecked="{Binding HasAgreed}" Color="{StaticResource Primary}" VerticalOptions="Center" />
          <Label Text="I understand and agree" FontSize="15" TextColor="{StaticResource TextPrimary}" VerticalOptions="Center">
            <Label.GestureRecognizers>
              <TapGestureRecognizer Command="{Binding ToggleAgreeCommand}" />
            </Label.GestureRecognizers>
          </Label>
        </HorizontalStackLayout>

        <Border Style="{StaticResource TrayPrimaryActionBorder}" Margin="0,0,0,8">
          <Border.Background>
            <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
              <GradientStop Color="{StaticResource ConnectButtonStart}" Offset="0" />
              <GradientStop Color="{StaticResource ConnectButtonMid}" Offset="0.55" />
              <GradientStop Color="{StaticResource ConnectButtonEnd}" Offset="1" />
            </LinearGradientBrush>
          </Border.Background>
          <Grid>
            <Button Command="{Binding ContinueCommand}" Style="{StaticResource TrayPrimaryActionOverlay}" Text="" SemanticProperties.Description="Continue" />
            <Label InputTransparent="True" Text="Continue" FontSize="15" FontAttributes="Bold" TextColor="White" HorizontalOptions="Center" VerticalOptions="Center" />
          </Grid>
        </Border>
        <Button Text="View Privacy Policy" Command="{Binding OpenPrivacyPolicyCommand}" BackgroundColor="Transparent" TextColor="{StaticResource Primary}" FontSize="15" HorizontalOptions="Center" />
      </VerticalStackLayout>
    </Grid>

    <controls:FooterStatusBar Grid.Row="1" VersionText="Version 1.0.0" ConnectionLabel="Connected" IsConnected="True" />
  </Grid>
</ContentPage>
