<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:ONEVO.Agent.TrayApp.ViewModels"
             xmlns:controls="clr-namespace:ONEVO.Agent.TrayApp.Controls"
             x:Class="ONEVO.Agent.TrayApp.Views.DailySummaryPage"
             x:DataType="vm:DailySummaryViewModel"
             Shell.NavBarIsVisible="False"
             Title="OneXso WorkPulse">

  <Grid RowDefinitions="Auto,*,Auto,Auto" Padding="24,14,24,10">
    <Grid.Background>
      <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="{StaticResource BackgroundWashStart}" Offset="0" />
        <GradientStop Color="#EEF2FF" Offset="0.45" />
        <GradientStop Color="{StaticResource BackgroundWashEnd}" Offset="1" />
      </LinearGradientBrush>
    </Grid.Background>

    <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,10">
      <VerticalStackLayout>
        <Label>
          <Label.FormattedText>
            <FormattedString>
              <Span Text="Daily " FontSize="26" FontAttributes="Bold" TextColor="{StaticResource TextPrimary}" />
              <Span Text="Summary" FontSize="26" FontAttributes="Bold" TextColor="{StaticResource BrandTitle}" />
            </FormattedString>
          </Label.FormattedText>
        </Label>
        <Label Text="Here's how your day went. Keep up the excellent work!"
               FontSize="13" TextColor="{StaticResource TextSecondary}" />
      </VerticalStackLayout>
      <Label Grid.Column="1" Text="{Binding DateDisplay}" FontSize="12" TextColor="{StaticResource TextSecondary}" VerticalOptions="Start" />
    </Grid>

    <Grid Grid.Row="1" RowDefinitions="Auto,*" RowSpacing="10">
      <Grid ColumnDefinitions="*,*,*,*,*" ColumnSpacing="8">
        <Border Style="{StaticResource TrayCompactGlassCard}" Padding="10,8">
          <VerticalStackLayout Spacing="2">
            <Label Text="Active Time" FontSize="10" TextColor="{StaticResource TextSecondary}" />
            <Label Text="{Binding ActiveTimeDisplay}" FontSize="16" FontAttributes="Bold" TextColor="{StaticResource TextPrimary}" />
          </VerticalStackLayout>
        </Border>
        <Border Grid.Column="1" Style="{StaticResource TrayCompactGlassCard}" Padding="10,8">
          <VerticalStackLayout Spacing="2">
            <Label Text="Idle Time" FontSize="10" TextColor="{StaticResource TextSecondary}" />
            <Label Text="{Binding IdleTimeDisplay}" FontSize="16" FontAttributes="Bold" TextColor="{StaticResource TextPrimary}" />
          </VerticalStackLayout>
        </Border>
        <Border Grid.Column="2" Style="{StaticResource TrayCompactGlassCard}" Padding="10,8">
          <VerticalStackLayout Spacing="2">
            <Label Text="Total Break Time" FontSize="10" TextColor="{StaticResource TextSecondary}" />
            <Label Text="{Binding BreakTimeDisplay}" FontSize="16" FontAttributes="Bold" TextColor="{StaticResource TextPrimary}" />
          </VerticalStackLayout>
        </Border>
        <Border Grid.Column="3" Style="{StaticResource TrayCompactGlassCard}" Padding="10,8">
          <VerticalStackLayout Spacing="2">
            <Label Text="Productive Time" FontSize="10" TextColor="{StaticResource TextSecondary}" />
            <Label Text="{Binding ProductiveTimeDisplay}" FontSize="16" FontAttributes="Bold" TextColor="{StaticResource StatusGreen}" />
          </VerticalStackLayout>
        </Border>
        <Border Grid.Column="4" Style="{StaticResource TrayCompactGlassCard}" Padding="10,8">
          <VerticalStackLayout Spacing="2">
            <Label Text="Break Sessions" FontSize="10" TextColor="{StaticResource TextSecondary}" />
            <Label Text="{Binding BreakSessionsDisplay}" FontSize="16" FontAttributes="Bold" TextColor="{StaticResource BreakAccent}" />
          </VerticalStackLayout>
        </Border>
      </Grid>

      <Grid Grid.Row="1" ColumnDefinitions="*,*" ColumnSpacing="10">
        <Border Style="{StaticResource TrayCompactGlassCard}" Padding="14,10">
          <VerticalStackLayout Spacing="6">
            <Label Text="Top Applications" FontAttributes="Bold" FontSize="14" TextColor="{StaticResource TextPrimary}" />
            <VerticalStackLayout BindableLayout.ItemsSource="{Binding TopApps}" Spacing="6">
              <BindableLayout.ItemTemplate>
                <DataTemplate x:DataType="vm:TopAppItem">
                  <Grid ColumnDefinitions="*,Auto">
                    <Label Text="{Binding Name}" FontSize="12" TextColor="{StaticResource TextPrimary}" LineBreakMode="TailTruncation" />
                    <Label Grid.Column="1" Text="{Binding Duration}" FontSize="12" FontAttributes="Bold" TextColor="{StaticResource Primary}" />
                  </Grid>
                </DataTemplate>
              </BindableLayout.ItemTemplate>
            </VerticalStackLayout>
          </VerticalStackLayout>
        </Border>
        <Border Style="{StaticResource TrayCompactGlassCard}" Padding="14,10">
          <VerticalStackLayout Spacing="8">
            <Label Text="Work Pattern Insights" FontAttributes="Bold" FontSize="14" TextColor="{StaticResource TextPrimary}" />
            <Label Text="Active, idle, and break time above come from today's recorded session." FontSize="12" TextColor="{StaticResource TextSecondary}" />
            <Label Text="Great job taking regular breaks when needed." FontSize="12" TextColor="{StaticResource TextSecondary}" />
            <Label Text="{Binding GreetingLine}" FontSize="13" FontAttributes="Bold" TextColor="{StaticResource BrandTitle}" />
          </VerticalStackLayout>
        </Border>
      </Grid>
    </Grid>

    <Grid Grid.Row="2" ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="8" Margin="0,10,0,0">
      <Label Text="{Binding ErrorMessage}" TextColor="{StaticResource StatusRed}" FontSize="12" VerticalOptions="Center"
             IsVisible="{Binding ErrorMessage, Converter={StaticResource IsNotNullConverter}}" />
      <Button Grid.Column="1" Text="Download Summary" Command="{Binding DownloadSummaryCommand}" Style="{StaticResource OutlineButton}" HeightRequest="44" FontSize="12" />
      <Button Grid.Column="2" Text="View Insights" Command="{Binding OpenInsightsCommand}" Style="{StaticResource OutlineButton}" HeightRequest="44" FontSize="12" />
      <Border Grid.Column="3" Style="{StaticResource TrayPrimaryActionBorder}" WidthRequest="140" HeightRequest="44">
        <Grid>
          <Button Command="{Binding DoneCommand}" Style="{StaticResource TrayPrimaryActionOverlay}" HeightRequest="44" Text="" SemanticProperties.Description="Done" />
          <Label InputTransparent="True" Text="Done" FontSize="14" FontAttributes="Bold" TextColor="White" HorizontalOptions="Center" VerticalOptions="Center" />
        </Grid>
      </Border>
    </Grid>

    <controls:FooterStatusBar Grid.Row="3" VersionText="Version 1.0.0" ConnectionLabel="Connected" IsConnected="True" />
  </Grid>
</ContentPage>
