<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:ONEVO.Agent.TrayApp.ViewModels"
             xmlns:controls="clr-namespace:ONEVO.Agent.TrayApp.Controls"
             x:Class="ONEVO.Agent.TrayApp.Views.DailySummaryPage"
             x:DataType="vm:DailySummaryViewModel"
             Shell.NavBarIsVisible="False"
             Title="OneXso WorkPulse">

  <ContentPage.Resources>
    <ResourceDictionary>
      <Style x:Key="SummaryCard" TargetType="Border" BasedOn="{StaticResource SetupResultCard}">
        <Setter Property="Padding" Value="12,10" />
        <Setter Property="StrokeShape" Value="RoundRectangle 16" />
        <Setter Property="VerticalOptions" Value="Fill" />
      </Style>
      <Style x:Key="SummaryLink" TargetType="Label">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="TextColor" Value="{StaticResource Primary}" />
        <Setter Property="VerticalOptions" Value="Center" />
        <Setter Property="LineBreakMode" Value="NoWrap" />
        <Setter Property="MaxLines" Value="1" />
      </Style>
      <Style x:Key="KpiLabel" TargetType="Label">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="TextColor" Value="{StaticResource TextSecondary}" />
        <Setter Property="LineBreakMode" Value="TailTruncation" />
        <Setter Property="MaxLines" Value="1" />
      </Style>
    </ResourceDictionary>
  </ContentPage.Resources>

  <Grid RowDefinitions="Auto,Auto,*,Auto,Auto,Auto" RowSpacing="8" Padding="16,8,16,4">
    <Grid.Background>
      <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="{StaticResource BackgroundWashStart}" Offset="0" />
        <GradientStop Color="{StaticResource BackgroundWashMid}" Offset="0.45" />
        <GradientStop Color="{StaticResource BackgroundWashEnd}" Offset="1" />
      </LinearGradientBrush>
    </Grid.Background>

    <Grid Grid.Row="0" ColumnDefinitions="*,Auto" ColumnSpacing="12">
      <VerticalStackLayout Spacing="0" VerticalOptions="Center">
        <Label>
          <Label.FormattedText>
            <FormattedString>
              <Span Text="Daily " FontSize="24" FontAttributes="Bold" TextColor="{StaticResource TextPrimary}" />
              <Span Text="Summary" FontSize="24" FontAttributes="Bold" TextColor="{StaticResource BrandTitle}" />
            </FormattedString>
          </Label.FormattedText>
        </Label>
        <Label Text="{Binding Headline}" Style="{StaticResource PageSubtitle}" FontSize="13" HorizontalTextAlignment="Start" />
      </VerticalStackLayout>
      <Border Grid.Column="1" Style="{StaticResource TrayCompactGlassCard}" Padding="12,8" VerticalOptions="Center">
        <HorizontalStackLayout Spacing="6">
          <Label Text="{StaticResource IconChevron}" FontFamily="Segoe MDL2 Assets" FontSize="11"
                 TextColor="{StaticResource TextMuted}" VerticalOptions="Center" Rotation="180" />
          <Image Source="icon3d_calendar.png" WidthRequest="16" HeightRequest="16" Aspect="AspectFit" VerticalOptions="Center" />
          <Label Text="{Binding DateDisplay}" FontSize="12" FontAttributes="Bold" TextColor="{StaticResource TextPrimary}" VerticalOptions="Center" />
          <Label Text="·" FontSize="12" TextColor="{StaticResource TextMuted}" VerticalOptions="Center" />
          <Label Text="{Binding WeekdayDisplay}" FontSize="12" TextColor="{StaticResource TextSecondary}" VerticalOptions="Center" />
          <Label Text="{StaticResource IconChevron}" FontFamily="Segoe MDL2 Assets" FontSize="11"
                 TextColor="{StaticResource TextMuted}" VerticalOptions="Center" />
        </HorizontalStackLayout>
      </Border>
    </Grid>

    <Grid Grid.Row="1" ColumnDefinitions="*,*,*,*" ColumnSpacing="8">
      <Border Style="{StaticResource SummaryCard}">
        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
          <Border WidthRequest="40" HeightRequest="40" StrokeThickness="0" StrokeShape="RoundRectangle 20"
                  BackgroundColor="{StaticResource AccentSoft}" VerticalOptions="Center">
            <Image Source="icon3d_clock.png" WidthRequest="24" HeightRequest="24" Aspect="AspectFit"
                   HorizontalOptions="Center" VerticalOptions="Center" />
          </Border>
          <VerticalStackLayout Grid.Column="1" Spacing="0" VerticalOptions="Center">
            <Label Text="Total Focus Time" Style="{StaticResource KpiLabel}" />
            <Label Text="{Binding FocusCompactDisplay}" Style="{StaticResource StatValue}" FontSize="20" />
            <Label Text="{Binding FocusTrendCaption}" FontSize="12" LineBreakMode="TailTruncation" MaxLines="1">
              <Label.Triggers>
                <DataTrigger TargetType="Label" Binding="{Binding IsFocusTrendPositive}" Value="True">
                  <Setter Property="TextColor" Value="{StaticResource StatusGreen}" />
                </DataTrigger>
                <DataTrigger TargetType="Label" Binding="{Binding IsFocusTrendPositive}" Value="False">
                  <Setter Property="TextColor" Value="{StaticResource TextMuted}" />
                </DataTrigger>
              </Label.Triggers>
            </Label>
          </VerticalStackLayout>
        </Grid>
      </Border>

      <Border Grid.Column="1" Style="{StaticResource SummaryCard}">
        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
          <Border WidthRequest="40" HeightRequest="40" StrokeThickness="0" StrokeShape="RoundRectangle 20"
                  BackgroundColor="{StaticResource PrimarySoft}" VerticalOptions="Center">
            <Image Source="icon3d_monitor.png" WidthRequest="24" HeightRequest="24" Aspect="AspectFit"
                   HorizontalOptions="Center" VerticalOptions="Center" />
          </Border>
          <VerticalStackLayout Grid.Column="1" Spacing="1" VerticalOptions="Center">
            <Label Text="Active Time" Style="{StaticResource KpiLabel}" />
            <Grid ColumnDefinitions="*,Auto">
              <Label Text="{Binding ActiveCompactDisplay}" Style="{StaticResource StatValue}" FontSize="20" />
              <Label Grid.Column="1" Text="{Binding ActiveShareCaption}" FontSize="12" FontAttributes="Bold"
                     TextColor="{StaticResource PrimaryGradientStart}" VerticalOptions="End" />
            </Grid>
            <controls:FractionBar Fraction="{Binding ActiveShareFraction}" FillColor="{StaticResource PrimaryGradientStart}" />
          </VerticalStackLayout>
        </Grid>
      </Border>

      <Border Grid.Column="2" Style="{StaticResource SummaryCard}">
        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
          <Border WidthRequest="40" HeightRequest="40" StrokeThickness="0" StrokeShape="RoundRectangle 20"
                  BackgroundColor="{StaticResource BreakTimerPillFill}" VerticalOptions="Center">
            <Image Source="icon3d_coffee.png" WidthRequest="24" HeightRequest="24" Aspect="AspectFit"
                   HorizontalOptions="Center" VerticalOptions="Center" />
          </Border>
          <VerticalStackLayout Grid.Column="1" Spacing="1" VerticalOptions="Center">
            <Label Text="Idle Time" Style="{StaticResource KpiLabel}" />
            <Grid ColumnDefinitions="*,Auto">
              <Label Text="{Binding IdleCompactDisplay}" Style="{StaticResource StatValue}" FontSize="20" />
              <Label Grid.Column="1" Text="{Binding IdleShareCaption}" FontSize="12" FontAttributes="Bold"
                     TextColor="{StaticResource ButtonOrange}" VerticalOptions="End" />
            </Grid>
            <controls:FractionBar Fraction="{Binding IdleShareFraction}" FillColor="{StaticResource ButtonOrange}" />
          </VerticalStackLayout>
        </Grid>
      </Border>

      <Border Grid.Column="3" Style="{StaticResource SummaryCard}">
        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
          <Border WidthRequest="40" HeightRequest="40" StrokeThickness="0" StrokeShape="RoundRectangle 20"
                  BackgroundColor="{StaticResource StatusGreenSoft}" VerticalOptions="Center">
            <Image Source="icon3d_stopwatch.png" WidthRequest="24" HeightRequest="24" Aspect="AspectFit"
                   HorizontalOptions="Center" VerticalOptions="Center" />
          </Border>
          <VerticalStackLayout Grid.Column="1" Spacing="0" VerticalOptions="Center">
            <Label Text="Total Break Time" Style="{StaticResource KpiLabel}" />
            <Label Text="{Binding BreakCompactDisplay}" Style="{StaticResource StatValue}" FontSize="20" />
            <Label Text="{Binding BreakSessionsCaption}" Style="{StaticResource DeltaNeutral}" />
          </VerticalStackLayout>
        </Grid>
      </Border>
    </Grid>

    <Grid Grid.Row="2" ColumnDefinitions="*,1.15*" ColumnSpacing="8">
      <Border Style="{StaticResource SummaryCard}">
        <Grid RowDefinitions="Auto,Auto,*" RowSpacing="8">
          <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="6">
            <Image Source="icon3d_bulb.png" WidthRequest="18" HeightRequest="18" Aspect="AspectFit" VerticalOptions="Center" />
            <Label Grid.Column="1" Text="Work Pattern Insights" Style="{StaticResource SectionTitle}" FontSize="15"
                   VerticalOptions="Center" LineBreakMode="TailTruncation" MaxLines="1" />
            <Label Grid.Column="2" Text="View insights ›" Style="{StaticResource SummaryLink}">
              <Label.GestureRecognizers>
                <TapGestureRecognizer Command="{Binding ViewInsightsCommand}" />
              </Label.GestureRecognizers>
            </Label>
          </Grid>

          <Border Grid.Row="1" BackgroundColor="{StaticResource StatusGreenSoft}" StrokeThickness="0"
                  StrokeShape="RoundRectangle 12" Padding="10,8">
            <Grid ColumnDefinitions="Auto,*,80,Auto" ColumnSpacing="8">
              <Image Source="icon3d_clock.png" WidthRequest="28" HeightRequest="28" Aspect="AspectFit" VerticalOptions="Center" />
              <VerticalStackLayout Grid.Column="1" Spacing="0" VerticalOptions="Center">
                <Label Text="Most Productive Period" FontSize="12" TextColor="{StaticResource TextSecondary}" />
                <Label Text="{Binding HighlightWindow}" FontSize="15" FontAttributes="Bold" TextColor="{StaticResource TextPrimary}"
                       LineBreakMode="TailTruncation" MaxLines="1"
                       IsVisible="{Binding HighlightWindow, Converter={StaticResource IsNotNullConverter}}" />
              </VerticalStackLayout>
              <controls:SparklineChart Grid.Column="2" Points="{Binding FocusSparklinePoints}"
                                       LineColor="{StaticResource StatusGreen}"
                                       WidthRequest="80" HeightRequest="32" VerticalOptions="Center" />
              <VerticalStackLayout Grid.Column="3" Spacing="0" VerticalOptions="Center">
                <Label Text="{Binding FocusCompactDisplay}" FontSize="16" FontAttributes="Bold"
                       TextColor="{StaticResource StatusGreen}" HorizontalTextAlignment="End" />
                <Label Text="focused" FontSize="11" TextColor="{StaticResource StatusGreen}" HorizontalTextAlignment="End" />
              </VerticalStackLayout>
            </Grid>
          </Border>

          <VerticalStackLayout Grid.Row="2" Spacing="6" VerticalOptions="Start">
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
              <Image Source="icon3d_clock.png" WidthRequest="16" HeightRequest="16" Aspect="AspectFit" VerticalOptions="Center" />
              <Label Grid.Column="1" Text="{Binding InsightFocus}" FontSize="12" TextColor="{StaticResource TextSecondary}"
                     LineBreakMode="TailTruncation" MaxLines="2" VerticalOptions="Center" />
            </Grid>
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
              <Image Source="icon3d_coffee.png" WidthRequest="16" HeightRequest="16" Aspect="AspectFit" VerticalOptions="Center" />
              <Label Grid.Column="1" Text="{Binding InsightIdle}" FontSize="12" TextColor="{StaticResource TextSecondary}"
                     LineBreakMode="TailTruncation" MaxLines="2" VerticalOptions="Center" />
            </Grid>
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
              <Image Source="icon3d_star.png" WidthRequest="16" HeightRequest="16" Aspect="AspectFit" VerticalOptions="Center" />
              <Label Grid.Column="1" Text="{Binding InsightBreaks}" FontSize="12" TextColor="{StaticResource TextSecondary}"
                     LineBreakMode="TailTruncation" MaxLines="2" VerticalOptions="Center" />
            </Grid>
          </VerticalStackLayout>
        </Grid>
      </Border>

      <Border Grid.Column="1" Style="{StaticResource SummaryCard}">
        <Grid RowDefinitions="Auto,*" RowSpacing="6">
          <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="6">
            <Image Source="icon3d_monitor.png" WidthRequest="18" HeightRequest="18" Aspect="AspectFit" VerticalOptions="Center" />
            <Label Grid.Column="1" Text="App Used Time" Style="{StaticResource SectionTitle}" FontSize="15"
                   VerticalOptions="Center" LineBreakMode="TailTruncation" MaxLines="1" />
            <Label Grid.Column="2" Text="View all ›" Style="{StaticResource SummaryLink}">
              <Label.GestureRecognizers>
                <TapGestureRecognizer Command="{Binding ViewInsightsCommand}" />
              </Label.GestureRecognizers>
            </Label>
          </Grid>

          <Grid Grid.Row="1" ColumnDefinitions="Auto,*" ColumnSpacing="10" VerticalOptions="Center">
            <Grid WidthRequest="112" HeightRequest="112" VerticalOptions="Center">
              <controls:MultiSegmentDonutChart Segments="{Binding AppDonutSegments}"
                                               WidthRequest="112" HeightRequest="112" />
              <VerticalStackLayout HorizontalOptions="Center" VerticalOptions="Center" InputTransparent="True" Spacing="0">
                <Label Text="{Binding FocusCompactDisplay}" FontSize="13" FontAttributes="Bold"
                       TextColor="{StaticResource TextPrimary}" HorizontalTextAlignment="Center" />
                <Label Text="Total Time" FontSize="10" TextColor="{StaticResource TextMuted}" HorizontalTextAlignment="Center" />
              </VerticalStackLayout>
            </Grid>
            <VerticalStackLayout Grid.Column="1" BindableLayout.ItemsSource="{Binding TopApps}" Spacing="5" VerticalOptions="Center">
              <BindableLayout.ItemTemplate>
                <DataTemplate x:DataType="vm:TopAppItem">
                  <Grid ColumnDefinitions="10,*,Auto,36" ColumnSpacing="6">
                    <Border WidthRequest="8" HeightRequest="8" StrokeThickness="0" StrokeShape="RoundRectangle 4"
                            BackgroundColor="{Binding Swatch}" VerticalOptions="Center" HorizontalOptions="Center" />
                    <Label Grid.Column="1" Text="{Binding Name}" FontSize="12" TextColor="{StaticResource TextPrimary}"
                           LineBreakMode="TailTruncation" MaxLines="1" VerticalOptions="Center" />
                    <Label Grid.Column="2" Text="{Binding DurationText}" FontSize="12" TextColor="{StaticResource TextSecondary}"
                           LineBreakMode="NoWrap" VerticalOptions="Center" />
                    <Label Grid.Column="3" Text="{Binding Percent}" FontSize="12" TextColor="{StaticResource TextMuted}"
                           HorizontalTextAlignment="End" VerticalOptions="Center" />
                  </Grid>
                </DataTemplate>
              </BindableLayout.ItemTemplate>
            </VerticalStackLayout>
          </Grid>
        </Grid>
      </Border>
    </Grid>

    <Border Grid.Row="3" Style="{StaticResource SummaryCard}" Padding="12,8">
      <Grid RowDefinitions="Auto,Auto" RowSpacing="6">
        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="6">
          <Image Source="icon3d_desktop.png" WidthRequest="18" HeightRequest="18" Aspect="AspectFit" VerticalOptions="Center" />
          <VerticalStackLayout Grid.Column="1" Spacing="0" VerticalOptions="Center">
            <Label Text="Screenshots" Style="{StaticResource SectionTitle}" FontSize="15" />
            <Label Text="Snapshots from your active working hours" FontSize="12" TextColor="{StaticResource TextSecondary}"
                   IsVisible="{Binding HasScreenshots}" LineBreakMode="TailTruncation" MaxLines="1" />
            <Label Text="{Binding ScreenshotsCaption}" FontSize="12" TextColor="{StaticResource TextSecondary}"
                   IsVisible="{Binding HasScreenshots, Converter={StaticResource InvertBoolConverter}}"
                   LineBreakMode="TailTruncation" MaxLines="2" />
          </VerticalStackLayout>
          <Label Grid.Column="2" Text="View all screenshots ›" Style="{StaticResource SummaryLink}" VerticalOptions="Center"
                 IsVisible="{Binding HasScreenshots}">
            <Label.GestureRecognizers>
              <TapGestureRecognizer Command="{Binding ViewInsightsCommand}" />
            </Label.GestureRecognizers>
          </Label>
        </Grid>
        <ScrollView Grid.Row="1" Orientation="Horizontal" HeightRequest="88"
                    HorizontalScrollBarVisibility="Never"
                    IsVisible="{Binding HasScreenshots}">
          <HorizontalStackLayout BindableLayout.ItemsSource="{Binding Screenshots}" Spacing="8">
            <BindableLayout.ItemTemplate>
              <DataTemplate x:DataType="vm:DailyScreenshotItem">
                <VerticalStackLayout WidthRequest="132" Spacing="3">
                  <Border StrokeShape="RoundRectangle 8" HeightRequest="68" Stroke="{StaticResource Separator}" StrokeThickness="1">
                    <Border.Triggers>
                      <DataTrigger TargetType="Border" Binding="{Binding IsSkipped}" Value="True">
                        <Setter Property="BackgroundColor" Value="{StaticResource StatusRedSoft}" />
                        <Setter Property="Stroke" Value="{StaticResource StatusRed}" />
                      </DataTrigger>
                    </Border.Triggers>
                    <Grid>
                      <Image Source="{Binding Preview}"
                             Aspect="AspectFill"
                             HeightRequest="68"
                             WidthRequest="132"
                             IsVisible="{Binding IsSkipped, Converter={StaticResource InvertBoolConverter}}" />
                      <VerticalStackLayout IsVisible="{Binding IsSkipped}" Padding="8" Spacing="0" VerticalOptions="Center">
                        <Label Text="Screenshot skipped" FontSize="11" FontAttributes="Bold"
                               TextColor="{StaticResource StatusRed}" HorizontalTextAlignment="Center" LineBreakMode="WordWrap" />
                      </VerticalStackLayout>
                      <BoxView IsVisible="{Binding IsSkipped, Converter={StaticResource InvertBoolConverter}}"
                               BackgroundColor="{StaticResource PrimaryGradientStart}"
                               HeightRequest="4" VerticalOptions="Start" HorizontalOptions="Fill" />
                    </Grid>
                  </Border>
                  <HorizontalStackLayout Spacing="4" HorizontalOptions="Center">
                    <Image Source="icon_desktop.png" WidthRequest="12" HeightRequest="12" Aspect="AspectFit" VerticalOptions="Center" />
                    <Label Text="{Binding TimeDisplay}" FontSize="11" TextColor="{StaticResource TextMuted}" VerticalOptions="Center" />
                  </HorizontalStackLayout>
                </VerticalStackLayout>
              </DataTemplate>
            </BindableLayout.ItemTemplate>
          </HorizontalStackLayout>
        </ScrollView>
      </Grid>
    </Border>

    <Grid Grid.Row="4" RowDefinitions="Auto,Auto" RowSpacing="4">
      <VerticalStackLayout Grid.Row="0" Spacing="0">
        <Label Text="{Binding Message}" FontSize="12" TextColor="{StaticResource StatusGreen}"
               IsVisible="{Binding Message, Converter={StaticResource IsNotNullConverter}}"
               LineBreakMode="TailTruncation" MaxLines="1" />
        <Label Text="{Binding ErrorMessage}" FontSize="12" TextColor="{StaticResource StatusRed}"
               IsVisible="{Binding ErrorMessage, Converter={StaticResource IsNotNullConverter}}"
               LineBreakMode="TailTruncation" MaxLines="1" />
      </VerticalStackLayout>
      <Grid Grid.Row="1" ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="8">
        <Border Style="{StaticResource TrayCompactGlassCard}" Padding="12,6" VerticalOptions="Center">
          <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
            <Image Source="icon3d_trophy.png" WidthRequest="28" HeightRequest="28" Aspect="AspectFit" VerticalOptions="Center" />
            <VerticalStackLayout Grid.Column="1" Spacing="0" VerticalOptions="Center">
              <Label Text="{Binding ExcellentDayCaption}" FontSize="13" FontAttributes="Bold" TextColor="{StaticResource TextPrimary}"
                     LineBreakMode="TailTruncation" MaxLines="1" />
              <Label Text="You stayed focused and made meaningful progress." FontSize="11" TextColor="{StaticResource TextSecondary}"
                     LineBreakMode="TailTruncation" MaxLines="1" />
            </VerticalStackLayout>
          </Grid>
        </Border>
        <Border Grid.Column="1" Style="{StaticResource TraySecondaryActionBorder}" StrokeShape="RoundRectangle 16"
                HeightRequest="42" MinimumWidthRequest="158">
          <Grid>
            <Button Command="{Binding DownloadSummaryCommand}" Style="{StaticResource TrayPrimaryActionOverlay}"
                    HeightRequest="42" Text="" SemanticProperties.Description="Download Summary" />
            <HorizontalStackLayout InputTransparent="True" HorizontalOptions="Center" VerticalOptions="Center" Spacing="6">
              <Image Source="icon3d_download.png" WidthRequest="16" HeightRequest="16" Aspect="AspectFit" VerticalOptions="Center" />
              <Label Text="Download Summary" Style="{StaticResource ButtonLabelOutline}" FontSize="13" />
            </HorizontalStackLayout>
          </Grid>
        </Border>
        <Border Grid.Column="2" Style="{StaticResource TraySecondaryActionBorder}" StrokeShape="RoundRectangle 16"
                HeightRequest="42" MinimumWidthRequest="148">
          <Grid>
            <Button Command="{Binding ViewInsightsCommand}" Style="{StaticResource TrayPrimaryActionOverlay}"
                    HeightRequest="42" Text="" SemanticProperties.Description="View Full Report" />
            <HorizontalStackLayout InputTransparent="True" HorizontalOptions="Center" VerticalOptions="Center" Spacing="6">
              <Image Source="icon3d_chart.png" WidthRequest="16" HeightRequest="16" Aspect="AspectFit" VerticalOptions="Center" />
              <Label Text="View Full Report" Style="{StaticResource ButtonLabelOutline}" FontSize="13" />
            </HorizontalStackLayout>
          </Grid>
        </Border>
        <Border Grid.Column="3" Style="{StaticResource TrayPrimaryActionBorder}" StrokeShape="RoundRectangle 16"
                HeightRequest="42" MinimumWidthRequest="96">
          <Grid>
            <Button Command="{Binding DoneCommand}" Style="{StaticResource TrayPrimaryActionOverlay}"
                    HeightRequest="42" Text="" SemanticProperties.Description="Done" />
            <HorizontalStackLayout InputTransparent="True" HorizontalOptions="Center" VerticalOptions="Center" Spacing="6">
              <Image Source="icon3d_check.png" WidthRequest="16" HeightRequest="16" Aspect="AspectFit" VerticalOptions="Center" />
              <Label Text="Done" Style="{StaticResource ButtonLabel}" FontSize="13" />
            </HorizontalStackLayout>
          </Grid>
        </Border>
      </Grid>
    </Grid>

    <controls:FooterStatusBar Grid.Row="5" VersionText="Version 1.0.0" ConnectionLabel="Connected" IsConnected="True" />
  </Grid>
</ContentPage>
