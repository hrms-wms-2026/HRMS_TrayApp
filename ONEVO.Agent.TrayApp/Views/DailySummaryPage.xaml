<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:ONEVO.Agent.TrayApp.ViewModels"
             xmlns:controls="clr-namespace:ONEVO.Agent.TrayApp.Controls"
             x:Class="ONEVO.Agent.TrayApp.Views.DailySummaryPage"
             x:DataType="vm:DailySummaryViewModel"
             Shell.NavBarIsVisible="False"
             Title="OneXso WorkPulse">

  <Grid RowDefinitions="Auto,*,Auto,Auto,Auto" Padding="24,12,24,8">
    <Grid.Background>
      <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="{StaticResource BackgroundWashStart}" Offset="0" />
        <GradientStop Color="{StaticResource BackgroundWashMid}" Offset="0.45" />
        <GradientStop Color="{StaticResource BackgroundWashEnd}" Offset="1" />
      </LinearGradientBrush>
    </Grid.Background>

    <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,10">
      <VerticalStackLayout Spacing="2">
        <Label>
          <Label.FormattedText>
            <FormattedString>
              <Span Text="Daily " FontSize="26" FontAttributes="Bold" TextColor="{StaticResource TextPrimary}" />
              <Span Text="Summary" FontSize="26" FontAttributes="Bold" TextColor="{StaticResource BrandTitle}" />
            </FormattedString>
          </Label.FormattedText>
        </Label>
        <Label Text="{Binding Headline}" Style="{StaticResource PageSubtitle}" HorizontalTextAlignment="Start" />
      </VerticalStackLayout>
      <Border Grid.Column="1" Style="{StaticResource TrayCompactGlassCard}" Padding="12,8" VerticalOptions="Start">
        <HorizontalStackLayout Spacing="6">
          <Image Source="icon3d_calendar.png" WidthRequest="18" HeightRequest="18" Aspect="AspectFit" VerticalOptions="Center" />
          <Label Text="{Binding DateDisplay}" FontSize="12" FontAttributes="Bold" TextColor="{StaticResource TextPrimary}" VerticalOptions="Center" />
          <Label Text="·" FontSize="12" TextColor="{StaticResource TextMuted}" VerticalOptions="Center" />
          <Label Text="{Binding WeekdayDisplay}" FontSize="12" TextColor="{StaticResource TextSecondary}" VerticalOptions="Center" />
        </HorizontalStackLayout>
      </Border>
    </Grid>

    <ScrollView Grid.Row="1">
      <VerticalStackLayout Spacing="10">
        <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="8">
          <Border Style="{StaticResource SetupResultCard}" Padding="14,12">
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
              <Image Source="icon3d_clock.png" WidthRequest="36" HeightRequest="36" Aspect="AspectFit" VerticalOptions="Start" />
              <VerticalStackLayout Grid.Column="1" Spacing="2">
                <Label Text="Total Focus Time" Style="{StaticResource StatLabel}" />
                <Label Text="{Binding FocusCompactDisplay}" Style="{StaticResource StatValue}" FontSize="22" />
                <Label Text="Focused hours" Style="{StaticResource DeltaNeutral}" />
              </VerticalStackLayout>
            </Grid>
          </Border>
          <Border Grid.Column="1" Style="{StaticResource SetupResultCard}" Padding="14,12">
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
              <Image Source="icon3d_monitor.png" WidthRequest="36" HeightRequest="36" Aspect="AspectFit" VerticalOptions="Start" />
              <VerticalStackLayout Grid.Column="1" Spacing="2">
                <Label Text="Active Time" Style="{StaticResource StatLabel}" />
                <Label Text="{Binding ActiveCompactDisplay}" Style="{StaticResource StatValue}" FontSize="22" />
                <Label Text="{Binding ActiveShareCaption}" Style="{StaticResource DeltaPositive}" />
              </VerticalStackLayout>
            </Grid>
          </Border>
          <Border Grid.Column="2" Style="{StaticResource SetupResultCard}" Padding="14,12">
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
              <Image Source="icon3d_coffee.png" WidthRequest="36" HeightRequest="36" Aspect="AspectFit" VerticalOptions="Start" />
              <VerticalStackLayout Grid.Column="1" Spacing="2">
                <Label Text="Idle Time" Style="{StaticResource StatLabel}" />
                <Label Text="{Binding IdleCompactDisplay}" Style="{StaticResource StatValue}" FontSize="22" />
                <Label Text="{Binding IdleShareCaption}" Style="{StaticResource DeltaNeutral}" />
              </VerticalStackLayout>
            </Grid>
          </Border>
          <Border Grid.Column="3" Style="{StaticResource SetupResultCard}" Padding="14,12">
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
              <Image Source="icon3d_stopwatch.png" WidthRequest="36" HeightRequest="36" Aspect="AspectFit" VerticalOptions="Start" />
              <VerticalStackLayout Grid.Column="1" Spacing="2">
                <Label Text="Total Break Time" Style="{StaticResource StatLabel}" />
                <Label Text="{Binding BreakCompactDisplay}" Style="{StaticResource StatValue}" FontSize="22" />
                <Label Text="{Binding BreakSessionsCaption}" Style="{StaticResource DeltaNeutral}" />
              </VerticalStackLayout>
            </Grid>
          </Border>
        </Grid>

        <Grid ColumnDefinitions="*,*,*" ColumnSpacing="8" HeightRequest="232">
          <Border Style="{StaticResource SetupResultCard}" Padding="12,10">
            <Grid RowDefinitions="Auto,*,Auto">
              <HorizontalStackLayout Spacing="6">
                <Image Source="icon3d_clipboard.png" WidthRequest="18" HeightRequest="18" Aspect="AspectFit" VerticalOptions="Center" />
                <Label Text="Session Snapshot" Style="{StaticResource SectionTitle}" FontSize="14" VerticalOptions="Center" />
              </HorizontalStackLayout>
              <VerticalStackLayout Grid.Row="1" Spacing="10" Margin="0,10,0,0" VerticalOptions="Center">
                <Grid ColumnDefinitions="*,Auto">
                  <Label Text="Clock in" Style="{StaticResource StatLabel}" />
                  <Label Grid.Column="1" Text="{Binding ClockInDisplay}" Style="{StaticResource ListTimestamp}" TextColor="{StaticResource TextPrimary}" FontAttributes="Bold" />
                </Grid>
                <Grid ColumnDefinitions="*,Auto">
                  <Label Text="Clock out" Style="{StaticResource StatLabel}" />
                  <Label Grid.Column="1" Text="{Binding ClockOutDisplay}" Style="{StaticResource ListTimestamp}" TextColor="{StaticResource TextPrimary}" FontAttributes="Bold" />
                </Grid>
                <Grid ColumnDefinitions="*,Auto">
                  <Label Text="Productive time" Style="{StaticResource StatLabel}" />
                  <Label Grid.Column="1" Text="{Binding ProductiveTimeDisplay}" Style="{StaticResource ListTimestamp}" TextColor="{StaticResource TextPrimary}" FontAttributes="Bold" />
                </Grid>
              </VerticalStackLayout>
              <Label Grid.Row="2" Text="View dashboard" FontSize="12" TextColor="{StaticResource Primary}" Margin="0,8,0,0">
                <Label.GestureRecognizers>
                  <TapGestureRecognizer Command="{Binding ViewInsightsCommand}" />
                </Label.GestureRecognizers>
              </Label>
            </Grid>
          </Border>

          <Border Grid.Column="1" Style="{StaticResource SetupResultCard}" Padding="12,10">
            <Grid RowDefinitions="Auto,*">
              <HorizontalStackLayout Spacing="6">
                <Image Source="icon3d_chart.png" WidthRequest="18" HeightRequest="18" Aspect="AspectFit" VerticalOptions="Center" />
                <Label Text="Focus vs Idle Time" Style="{StaticResource SectionTitle}" FontSize="14" VerticalOptions="Center" />
              </HorizontalStackLayout>
              <Grid Grid.Row="1" ColumnDefinitions="Auto,*" ColumnSpacing="12" Margin="0,8,0,0">
                <Grid WidthRequest="140" HeightRequest="140" VerticalOptions="Center">
                  <controls:SplitDonutChart PrimaryFraction="{Binding ActiveShareFraction}" WidthRequest="140" HeightRequest="140" />
                  <VerticalStackLayout HorizontalOptions="Center" VerticalOptions="Center" Spacing="0">
                    <Label Text="{Binding FocusCompactDisplay}" FontSize="16" FontAttributes="Bold" TextColor="{StaticResource TextPrimary}" HorizontalTextAlignment="Center" />
                    <Label Text="Total Time" FontSize="11" TextColor="{StaticResource TextMuted}" HorizontalTextAlignment="Center" />
                  </VerticalStackLayout>
                </Grid>
                <VerticalStackLayout Spacing="10" VerticalOptions="Center">
                  <HorizontalStackLayout Spacing="8">
                    <Border WidthRequest="10" HeightRequest="10" StrokeThickness="0" StrokeShape="RoundRectangle 5" BackgroundColor="#14B8A6" VerticalOptions="Center" />
                    <VerticalStackLayout Spacing="0">
                      <Label Text="{Binding ActiveCompactDisplay, StringFormat='Active Time  {0}'}" FontSize="12" TextColor="{StaticResource TextPrimary}" />
                      <Label Text="{Binding ActiveShareCaption}" Style="{StaticResource DeltaPositive}" />
                    </VerticalStackLayout>
                  </HorizontalStackLayout>
                  <HorizontalStackLayout Spacing="8">
                    <Border WidthRequest="10" HeightRequest="10" StrokeThickness="0" StrokeShape="RoundRectangle 5" BackgroundColor="#FDBA74" VerticalOptions="Center" />
                    <VerticalStackLayout Spacing="0">
                      <Label Text="{Binding IdleCompactDisplay, StringFormat='Idle Time  {0}'}" FontSize="12" TextColor="{StaticResource TextPrimary}" />
                      <Label Text="{Binding IdleShareCaption}" Style="{StaticResource DeltaNeutral}" />
                    </VerticalStackLayout>
                  </HorizontalStackLayout>
                </VerticalStackLayout>
              </Grid>
            </Grid>
          </Border>

          <Border Grid.Column="2" Style="{StaticResource SetupResultCard}" Padding="12,10">
            <Grid RowDefinitions="Auto,*">
              <HorizontalStackLayout Spacing="6">
                <Image Source="icon3d_coffee.png" WidthRequest="18" HeightRequest="18" Aspect="AspectFit" VerticalOptions="Center" />
                <Label Text="Break Sessions" Style="{StaticResource SectionTitle}" FontSize="14" VerticalOptions="Center" />
              </HorizontalStackLayout>
              <VerticalStackLayout Grid.Row="1" Spacing="8" Margin="0,10,0,0" VerticalOptions="Center">
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                  <Image Source="icon3d_coffee.png" WidthRequest="28" HeightRequest="28" Aspect="AspectFit" VerticalOptions="Start" />
                  <VerticalStackLayout Grid.Column="1" Spacing="2">
                    <Label Text="{Binding BreakSessionsCaption}" Style="{StaticResource ListItem}" />
                    <Label Text="{Binding BreakTimeDisplay, StringFormat='Total {0}'}" Style="{StaticResource DeltaNeutral}" />
                    <Label Text="No breaks logged in this session." FontSize="12" TextColor="{StaticResource TextMuted}"
                           IsVisible="{Binding HasBreaks, Converter={StaticResource InvertBoolConverter}}" />
                  </VerticalStackLayout>
                </Grid>
              </VerticalStackLayout>
            </Grid>
          </Border>
        </Grid>

        <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="8" HeightRequest="232">
          <Border Style="{StaticResource SetupResultCard}" Padding="12,10">
            <Grid RowDefinitions="Auto,*">
              <HorizontalStackLayout Spacing="6">
                <Image Source="icon3d_monitor.png" WidthRequest="18" HeightRequest="18" Aspect="AspectFit" VerticalOptions="Center" />
                <Label Text="Top Applications" Style="{StaticResource SectionTitle}" FontSize="14" VerticalOptions="Center" />
              </HorizontalStackLayout>
              <Grid Grid.Row="1" ColumnDefinitions="Auto,*" ColumnSpacing="8" Margin="0,8,0,0">
                <controls:MultiSegmentDonutChart Segments="{Binding AppDonutSegments}" WidthRequest="108" HeightRequest="108" VerticalOptions="Center" />
                <VerticalStackLayout Grid.Column="1" BindableLayout.ItemsSource="{Binding TopApps}" Spacing="6" VerticalOptions="Center">
                  <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="vm:TopAppItem">
                      <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="6">
                        <Border WidthRequest="8" HeightRequest="8" StrokeThickness="0" StrokeShape="RoundRectangle 4"
                                BackgroundColor="{Binding Swatch}" VerticalOptions="Center" />
                        <Label Grid.Column="1" Text="{Binding Name}" Style="{StaticResource ListItem}" LineBreakMode="TailTruncation" />
                        <Label Grid.Column="2" Text="{Binding Duration}" Style="{StaticResource ListTimestamp}" />
                        <Label Grid.Column="3" Text="{Binding Percent}" FontSize="12" TextColor="{StaticResource TextMuted}" WidthRequest="36" HorizontalTextAlignment="End" />
                      </Grid>
                    </DataTemplate>
                  </BindableLayout.ItemTemplate>
                </VerticalStackLayout>
              </Grid>
            </Grid>
          </Border>

          <Border Grid.Column="1" Style="{StaticResource SetupResultCard}" Padding="12,10">
            <Grid RowDefinitions="Auto,*">
              <HorizontalStackLayout Spacing="6">
                <Image Source="icon3d_bulb.png" WidthRequest="18" HeightRequest="18" Aspect="AspectFit" VerticalOptions="Center" />
                <Label Text="Work Pattern Insights" Style="{StaticResource SectionTitle}" FontSize="14" VerticalOptions="Center" />
              </HorizontalStackLayout>
              <VerticalStackLayout Grid.Row="1" Spacing="8" Margin="0,8,0,0">
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                  <Image Source="icon3d_clock.png" WidthRequest="16" HeightRequest="16" Aspect="AspectFit" VerticalOptions="Start" Margin="0,2,0,0" />
                  <Label Grid.Column="1" Text="{Binding MostProductiveCaption}" FontSize="12" FontAttributes="Bold" TextColor="{StaticResource TextPrimary}" LineBreakMode="WordWrap" />
                </Grid>
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                  <Image Source="icon3d_chart.png" WidthRequest="16" HeightRequest="16" Aspect="AspectFit" VerticalOptions="Start" Margin="0,2,0,0" />
                  <Label Grid.Column="1" Text="{Binding InsightFocus}" FontSize="12" TextColor="{StaticResource TextSecondary}" LineBreakMode="WordWrap" />
                </Grid>
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                  <Image Source="icon3d_coffee.png" WidthRequest="16" HeightRequest="16" Aspect="AspectFit" VerticalOptions="Start" Margin="0,2,0,0" />
                  <Label Grid.Column="1" Text="{Binding InsightIdle}" FontSize="12" TextColor="{StaticResource TextSecondary}" LineBreakMode="WordWrap" />
                </Grid>
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                  <Image Source="icon3d_star.png" WidthRequest="16" HeightRequest="16" Aspect="AspectFit" VerticalOptions="Start" Margin="0,2,0,0" />
                  <Label Grid.Column="1" Text="{Binding InsightBreaks}" FontSize="12" TextColor="{StaticResource TextSecondary}" LineBreakMode="WordWrap" />
                </Grid>
              </VerticalStackLayout>
            </Grid>
          </Border>

          <Border Grid.Column="2" Style="{StaticResource SetupResultCard}" Padding="12,10">
            <Grid RowDefinitions="Auto,*">
              <HorizontalStackLayout Spacing="6">
                <Image Source="icon3d_star.png" WidthRequest="18" HeightRequest="18" Aspect="AspectFit" VerticalOptions="Center" />
                <Label Text="Personal Highlights" Style="{StaticResource SectionTitle}" FontSize="14" VerticalOptions="Center" />
              </HorizontalStackLayout>
              <VerticalStackLayout Grid.Row="1" Spacing="6" Margin="0,8,0,0">
                <Border BackgroundColor="{StaticResource StatusGreenSoft}" StrokeThickness="0" StrokeShape="RoundRectangle 10" Padding="8,6">
                  <VerticalStackLayout Spacing="1">
                    <Label Text="{Binding HighlightProgressTitle}" FontSize="12" FontAttributes="Bold" TextColor="{StaticResource StatusGreen}" />
                    <Label Text="{Binding HighlightProgress}" FontSize="11" TextColor="{StaticResource TextSecondary}" LineBreakMode="WordWrap" />
                  </VerticalStackLayout>
                </Border>
                <Border BackgroundColor="{StaticResource AccentSoft}" StrokeThickness="0" StrokeShape="RoundRectangle 10" Padding="8,6">
                  <VerticalStackLayout Spacing="1">
                    <Label Text="Focus Champion" FontSize="12" FontAttributes="Bold" TextColor="{StaticResource BrandTitle}" />
                    <Label Text="{Binding HighlightFocus}" FontSize="11" TextColor="{StaticResource TextSecondary}" LineBreakMode="WordWrap" />
                  </VerticalStackLayout>
                </Border>
                <Border BackgroundColor="{StaticResource PrimarySoft}" StrokeThickness="0" StrokeShape="RoundRectangle 10" Padding="8,6"
                        IsVisible="{Binding HighlightWindow, Converter={StaticResource IsNotNullConverter}}">
                  <VerticalStackLayout Spacing="1">
                    <Label Text="Most Productive" FontSize="12" FontAttributes="Bold" TextColor="{StaticResource StatusBlue}" />
                    <Label Text="{Binding HighlightWindow}" FontSize="11" TextColor="{StaticResource TextSecondary}" LineBreakMode="WordWrap" />
                  </VerticalStackLayout>
                </Border>
              </VerticalStackLayout>
            </Grid>
          </Border>

          <Border Grid.Column="3" Style="{StaticResource SetupResultCard}" Padding="12,10">
            <Grid RowDefinitions="Auto,*">
              <HorizontalStackLayout Spacing="6">
                <Image Source="icon3d_heart.png" WidthRequest="18" HeightRequest="18" Aspect="AspectFit" VerticalOptions="Center" />
                <Label Text="Reflection &amp; Wellbeing" Style="{StaticResource SectionTitle}" FontSize="14" VerticalOptions="Center" />
              </HorizontalStackLayout>
              <Grid Grid.Row="1" ColumnDefinitions="Auto,*" ColumnSpacing="8" Margin="0,6,0,0">
                <Image Source="illustration_meditation.png" WidthRequest="108" HeightRequest="108" Aspect="AspectFit" VerticalOptions="Center" />
                <VerticalStackLayout Grid.Column="1" Spacing="8" VerticalOptions="Center">
                  <Label Text="Every productive day brings you closer to your goals. Take a moment to relax and recharge."
                         FontSize="12" TextColor="{StaticResource TextSecondary}" LineBreakMode="WordWrap" />
                  <Border Style="{StaticResource TrayPrimaryActionBorder}" StrokeShape="RoundRectangle 14" HeightRequest="34" HorizontalOptions="Start">
                    <Grid>
                      <Button Command="{Binding ViewInsightsCommand}" Style="{StaticResource TrayPrimaryActionOverlay}" HeightRequest="34" Text="" SemanticProperties.Description="Log My Reflection" />
                      <Label InputTransparent="True" Text="Log My Reflection" FontSize="12" FontAttributes="Bold" TextColor="White" HorizontalOptions="Center" />
                    </Grid>
                  </Border>
                </VerticalStackLayout>
              </Grid>
            </Grid>
          </Border>
        </Grid>

        <Border Style="{StaticResource SetupResultCard}" Padding="12,10">
          <Grid RowDefinitions="Auto,Auto,*">
            <HorizontalStackLayout Spacing="6">
              <Image Source="icon3d_desktop.png" WidthRequest="18" HeightRequest="18" Aspect="AspectFit" VerticalOptions="Center" />
              <Label Text="Activity Screenshots" Style="{StaticResource SectionTitle}" FontSize="14" VerticalOptions="Center" />
            </HorizontalStackLayout>
            <Label Grid.Row="1" Text="{Binding ScreenshotsCaption}" FontSize="12" TextColor="{StaticResource TextSecondary}" Margin="0,6,0,0" LineBreakMode="WordWrap" />
            <ScrollView Grid.Row="2" Orientation="Horizontal" IsVisible="{Binding HasScreenshots}" Margin="0,8,0,0">
              <HorizontalStackLayout BindableLayout.ItemsSource="{Binding Screenshots}" Spacing="8">
                <BindableLayout.ItemTemplate>
                  <DataTemplate x:DataType="vm:DailyScreenshotItem">
                    <VerticalStackLayout WidthRequest="168" Spacing="4">
                      <Border StrokeShape="RoundRectangle 10" HeightRequest="96" Stroke="{StaticResource Separator}">
                        <Border.Triggers>
                          <DataTrigger TargetType="Border" Binding="{Binding IsSkipped}" Value="True">
                            <Setter Property="BackgroundColor" Value="{StaticResource StatusRedSoft}" />
                            <Setter Property="Stroke" Value="{StaticResource StatusRed}" />
                          </DataTrigger>
                        </Border.Triggers>
                        <Grid>
                          <Image Source="{Binding Preview}"
                                 Aspect="AspectFill"
                                 HeightRequest="96"
                                 WidthRequest="168"
                                 IsVisible="{Binding IsSkipped, Converter={StaticResource InvertBoolConverter}}" />
                          <VerticalStackLayout IsVisible="{Binding IsSkipped}"
                                               Padding="10"
                                               Spacing="2"
                                               VerticalOptions="Center">
                            <Label Text="Screenshot skipped"
                                   FontSize="12"
                                   FontAttributes="Bold"
                                   TextColor="{StaticResource StatusRed}"
                                   HorizontalTextAlignment="Center"
                                   LineBreakMode="WordWrap" />
                          </VerticalStackLayout>
                        </Grid>
                      </Border>
                      <Label Text="{Binding TimeDisplay}" FontSize="11" TextColor="{StaticResource TextMuted}" />
                    </VerticalStackLayout>
                  </DataTemplate>
                </BindableLayout.ItemTemplate>
              </HorizontalStackLayout>
            </ScrollView>
          </Grid>
        </Border>
      </VerticalStackLayout>
    </ScrollView>

    <VerticalStackLayout Grid.Row="2" Spacing="2">
      <Label Text="{Binding Message}" FontSize="12" TextColor="{StaticResource StatusGreen}"
             IsVisible="{Binding Message, Converter={StaticResource IsNotNullConverter}}" />
      <Label Text="{Binding ErrorMessage}" FontSize="12" TextColor="{StaticResource StatusRed}"
             IsVisible="{Binding ErrorMessage, Converter={StaticResource IsNotNullConverter}}" />
    </VerticalStackLayout>

    <Grid Grid.Row="3" ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="8" Margin="0,8,0,0">
      <Border Style="{StaticResource TrayCompactGlassCard}" Padding="12,8">
        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
          <Image Source="icon3d_trophy.png" WidthRequest="32" HeightRequest="32" Aspect="AspectFit" VerticalOptions="Center" />
          <VerticalStackLayout Grid.Column="1" Spacing="1" VerticalOptions="Center">
            <Label Text="{Binding ExcellentDayCaption}" FontSize="13" FontAttributes="Bold" TextColor="{StaticResource TextPrimary}" />
            <Label Text="You stayed focused and made meaningful progress." FontSize="12" TextColor="{StaticResource TextSecondary}" />
          </VerticalStackLayout>
        </Grid>
      </Border>
      <Border Grid.Column="1" Style="{StaticResource TraySecondaryActionBorder}" StrokeShape="RoundRectangle 16" HeightRequest="44" MinimumWidthRequest="170">
        <Grid>
          <Button Command="{Binding DownloadSummaryCommand}" Style="{StaticResource TrayPrimaryActionOverlay}" HeightRequest="44" Text="" SemanticProperties.Description="Download PDF" />
          <HorizontalStackLayout InputTransparent="True" HorizontalOptions="Center" VerticalOptions="Center" Spacing="6">
            <Image Source="icon3d_download.png" WidthRequest="16" HeightRequest="16" Aspect="AspectFit" VerticalOptions="Center" />
            <Label Text="Download PDF" Style="{StaticResource ButtonLabelOutline}" FontSize="13" />
          </HorizontalStackLayout>
        </Grid>
      </Border>
      <Border Grid.Column="2" Style="{StaticResource TraySecondaryActionBorder}" StrokeShape="RoundRectangle 16" HeightRequest="44" MinimumWidthRequest="150">
        <Grid>
          <Button Command="{Binding ViewInsightsCommand}" Style="{StaticResource TrayPrimaryActionOverlay}" HeightRequest="44" Text="" SemanticProperties.Description="View My Insights" />
          <HorizontalStackLayout InputTransparent="True" HorizontalOptions="Center" VerticalOptions="Center" Spacing="6">
            <Image Source="icon3d_chart.png" WidthRequest="16" HeightRequest="16" Aspect="AspectFit" VerticalOptions="Center" />
            <Label Text="View My Insights" Style="{StaticResource ButtonLabelOutline}" FontSize="13" />
          </HorizontalStackLayout>
        </Grid>
      </Border>
      <Border Grid.Column="3" Style="{StaticResource TrayPrimaryActionBorder}" StrokeShape="RoundRectangle 16" HeightRequest="44" MinimumWidthRequest="110">
        <Grid>
          <Button Command="{Binding DoneCommand}" Style="{StaticResource TrayPrimaryActionOverlay}" HeightRequest="44" Text="" SemanticProperties.Description="Done" />
          <Label InputTransparent="True" Text="Done" Style="{StaticResource ButtonLabel}" FontSize="13" HorizontalOptions="Center" />
        </Grid>
      </Border>
    </Grid>

    <controls:FooterStatusBar Grid.Row="4" VersionText="Version 1.0.0" ConnectionLabel="Connected" IsConnected="True" />
  </Grid>
</ContentPage>
