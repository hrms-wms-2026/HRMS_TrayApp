<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:ONEVO.Agent.TrayApp.ViewModels"
             xmlns:controls="clr-namespace:ONEVO.Agent.TrayApp.Controls"
             x:Class="ONEVO.Agent.TrayApp.Views.WorkLocationPage"
             x:DataType="vm:WorkLocationViewModel"
             Title="Select Your Work Location">

  <Grid RowDefinitions="Auto,*,Auto" Padding="20,16">
    <Grid.Background>
      <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="{StaticResource BackgroundWashStart}" Offset="0" />
        <GradientStop Color="{StaticResource BackgroundWashEnd}" Offset="1" />
      </LinearGradientBrush>
    </Grid.Background>
    <controls:AppHeaderBar Grid.Row="0" ShowSubtitle="False" />

    <Grid x:Name="PaneGrid" Grid.Row="1" ColumnDefinitions="4*,6*" ColumnSpacing="24">

      <!-- Ambient glow blobs sit behind the glass panels so the translucency has something to catch -->
      <Ellipse Grid.ColumnSpan="2" WidthRequest="420" HeightRequest="420"
               HorizontalOptions="Start" VerticalOptions="Start" Margin="-110,-90,0,0" Opacity="0.85">
        <Ellipse.Fill>
          <RadialGradientBrush Center="0.5,0.5" Radius="0.5">
            <GradientStop Color="{StaticResource GlassGlowPrimary}" Offset="0" />
            <GradientStop Color="#00175CFF" Offset="1" />
          </RadialGradientBrush>
        </Ellipse.Fill>
      </Ellipse>
      <Ellipse Grid.Column="1" WidthRequest="360" HeightRequest="360"
               HorizontalOptions="End" VerticalOptions="End" Margin="0,0,-90,-90" Opacity="0.85">
        <Ellipse.Fill>
          <RadialGradientBrush Center="0.5,0.5" Radius="0.5">
            <GradientStop Color="{StaticResource GlassGlowAccent}" Offset="0" />
            <GradientStop Color="#006D28D9" Offset="1" />
          </RadialGradientBrush>
        </Ellipse.Fill>
      </Ellipse>

      <!-- Left illustration -->
      <Border x:Name="LeftPane" Grid.Column="0" Style="{StaticResource GlassPanel}"
              MinimumWidthRequest="0">
        <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Center" Spacing="12" Padding="24">
          <Border WidthRequest="120" HeightRequest="120" Style="{StaticResource GlassInputRow}"
                  StrokeShape="RoundRectangle 60" Padding="0" HorizontalOptions="Center">
            <Label Text="{StaticResource IconLocation}" FontFamily="Segoe MDL2 Assets"
                   FontSize="56" TextColor="{StaticResource Primary}"
                   HorizontalOptions="Center" VerticalOptions="Center" />
          </Border>
          <Label Text="Choose where you work today."
                 FontSize="12" TextColor="{StaticResource TextSecondary}"
                 HorizontalTextAlignment="Center" />
        </VerticalStackLayout>
      </Border>

      <ScrollView x:Name="RightPane" Grid.Column="1">
        <VerticalStackLayout Padding="8,0,0,0" Spacing="0">
          <HorizontalStackLayout Spacing="6">
            <Label Text="Select Your " Style="{StaticResource PageTitle}" />
            <Label Text="Work Location" Style="{StaticResource PageTitleAccent}" />
          </HorizontalStackLayout>
          <Label Text="Choose your current work location before continuing."
                 Style="{StaticResource PageSubtitle}"
                 HorizontalTextAlignment="Start"
                 Margin="0,6,0,12" />

          <!-- Live GPS -->
          <Border Style="{StaticResource GlassCard}" Padding="12,10" Margin="0,0,0,12">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10" RowDefinitions="Auto,Auto">
              <VerticalStackLayout Grid.Row="0" Grid.Column="0" Spacing="2">
                <Label Text="Live location"
                       FontAttributes="Bold" FontSize="13"
                       TextColor="{StaticResource TextPrimary}" />
                <Label Text="{Binding LiveLocationStatus}"
                       FontSize="11" TextColor="{StaticResource TextSecondary}"
                       LineBreakMode="WordWrap" />
              </VerticalStackLayout>
              <Button Grid.Row="0" Grid.Column="1"
                      Text="📍 Detect"
                      Command="{Binding DetectLiveLocationCommand}"
                      IsEnabled="{Binding IsDetectingLocation, Converter={StaticResource InvertBoolConverter}}"
                      BackgroundColor="{StaticResource PrimarySoft}"
                      TextColor="{StaticResource Primary}"
                      FontAttributes="Bold"
                      FontSize="12"
                      CornerRadius="18"
                      HeightRequest="40"
                      Padding="14,0"
                      VerticalOptions="Center" />
              <ActivityIndicator Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
                                 IsRunning="{Binding IsDetectingLocation}"
                                 IsVisible="{Binding IsDetectingLocation}"
                                 Color="{StaticResource Primary}"
                                 HeightRequest="24"
                                 HorizontalOptions="Start"
                                 Margin="0,6,0,0" />
            </Grid>
          </Border>

          <Border Style="{StaticResource GlassInputRow}" Margin="0,0,0,14">
            <HorizontalStackLayout Spacing="10">
              <Label Text="{StaticResource IconSearch}" FontFamily="Segoe MDL2 Assets"
                     FontSize="16" TextColor="{StaticResource TextMuted}" VerticalOptions="Center" />
              <Entry Placeholder="Search location..."
                     Text="{Binding SearchText}"
                     BackgroundColor="Transparent"
                     PlaceholderColor="{StaticResource TextMuted}"
                     FontSize="14"
                     HorizontalOptions="Fill" />
            </HorizontalStackLayout>
          </Border>

          <CollectionView ItemsSource="{Binding FilteredLocations}"
                          SelectedItem="{Binding SelectedLocation}"
                          SelectionMode="Single"
                          Margin="0,0,0,20">
            <CollectionView.ItemTemplate>
              <DataTemplate x:DataType="vm:WorkLocationOption">
                <Border Style="{StaticResource GlassCard}" Margin="0,0,0,8" Padding="14,14">
                  <Border.Triggers>
                    <DataTrigger TargetType="Border" Binding="{Binding IsSelected}" Value="True">
                      <Setter Property="Stroke" Value="{StaticResource Primary}" />
                      <Setter Property="StrokeThickness" Value="2" />
                      <Setter Property="BackgroundColor" Value="{StaticResource PrimarySoft}" />
                    </DataTrigger>
                  </Border.Triggers>
                  <Grid ColumnDefinitions="36,*,Auto" ColumnSpacing="12">
                    <Border Grid.Column="0" WidthRequest="36" HeightRequest="36"
                            StrokeShape="RoundRectangle 10" BackgroundColor="{StaticResource PrimarySoft}"
                            StrokeThickness="0">
                      <Label Text="{StaticResource IconLocation}" FontFamily="Segoe MDL2 Assets"
                             FontSize="16" TextColor="{StaticResource Primary}"
                             HorizontalOptions="Center" VerticalOptions="Center" />
                    </Border>
                    <VerticalStackLayout Grid.Column="1" VerticalOptions="Center">
                      <Label Text="{Binding DisplayName}"
                             FontAttributes="Bold" TextColor="{StaticResource TextPrimary}" FontSize="14" />
                      <Label Text="{Binding SubTitle}"
                             TextColor="{StaticResource TextSecondary}" FontSize="11" />
                    </VerticalStackLayout>
                    <Border Grid.Column="2"
                            WidthRequest="22" HeightRequest="22"
                            StrokeShape="RoundRectangle 11"
                            Stroke="{StaticResource Primary}" StrokeThickness="2"
                            BackgroundColor="Transparent"
                            VerticalOptions="Center">
                      <Border.Triggers>
                        <DataTrigger TargetType="Border" Binding="{Binding IsSelected}" Value="True">
                          <Setter Property="BackgroundColor" Value="{StaticResource Primary}" />
                        </DataTrigger>
                      </Border.Triggers>
                      <Label Text="{StaticResource IconCheck}" FontFamily="Segoe MDL2 Assets"
                             FontSize="12" TextColor="White"
                             HorizontalOptions="Center" VerticalOptions="Center"
                             IsVisible="{Binding IsSelected}" />
                    </Border>
                  </Grid>
                </Border>
              </DataTemplate>
            </CollectionView.ItemTemplate>
          </CollectionView>

          <Border Style="{StaticResource GradientButtonBorder}">
            <Button Text="📍  Confirm Location"
                    Command="{Binding SaveAndContinueCommand}"
                    Style="{StaticResource GradientButtonOverlay}" />
          </Border>
        </VerticalStackLayout>
      </ScrollView>
    </Grid>

    <controls:FooterStatusBar Grid.Row="2" ConnectionLabel="Connected" />
  </Grid>
</ContentPage>
