<?xml version="1.0" encoding="UTF-8" ?>
<Application xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:conv="clr-namespace:ONEVO.Agent.TrayApp.Converters"
             x:Class="ONEVO.Agent.TrayApp.App">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources/Styles/Colors.xaml" />
                <ResourceDictionary Source="Resources/Styles/Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <conv:InvertBoolConverter x:Key="InvertBoolConverter" />
            <conv:IsNotNullConverter x:Key="IsNotNullConverter" />
            <conv:BoolToCheckmarkConverter x:Key="BoolToCheckmarkConverter" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
