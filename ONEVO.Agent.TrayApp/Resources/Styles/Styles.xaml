<?xml version="1.0" encoding="UTF-8" ?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <x:Double x:Key="TrayActionHeight">48</x:Double>
    <x:Double x:Key="TrayHeroActionHeight">64</x:Double>
    <x:Double x:Key="TrayFaceFrameOuterSize">236</x:Double>
    <x:Double x:Key="TrayFaceFrameRingSize">220</x:Double>
    <x:Double x:Key="TrayFaceFrameInnerSize">204</x:Double>
    <Thickness x:Key="TrayPagePadding">20,10</Thickness>
    <Thickness x:Key="TrayDensePagePadding">20,8</Thickness>
    <Thickness x:Key="TrayCardPadding">12,10</Thickness>
    <Thickness x:Key="TrayDenseCardPadding">10,8</Thickness>

    <!-- Card container -->
    <Style x:Key="Card" TargetType="Border">
        <Setter Property="BackgroundColor" Value="{StaticResource CardBackground}" />
        <Setter Property="StrokeShape" Value="RoundRectangle 16" />
        <Setter Property="Stroke" Value="{StaticResource Separator}" />
        <Setter Property="StrokeThickness" Value="1" />
        <Setter Property="Padding" Value="16" />
    </Style>

    <!-- Frosted-glass card: translucent gradient fill + bright hairline border sells the glass -->
    <Style x:Key="GlassCard" TargetType="Border">
        <Setter Property="Background">
            <Setter.Value>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="{StaticResource GlassSurfaceTop}" Offset="0" />
                    <GradientStop Color="{StaticResource GlassSurfaceBottom}" Offset="1" />
                </LinearGradientBrush>
            </Setter.Value>
        </Setter>
        <Setter Property="StrokeShape" Value="RoundRectangle 18" />
        <Setter Property="StrokeThickness" Value="1.2" />
        <Setter Property="Stroke">
            <Setter.Value>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="{StaticResource GlassBorderStart}" Offset="0" />
                    <GradientStop Color="{StaticResource GlassBorderEnd}" Offset="1" />
                </LinearGradientBrush>
            </Setter.Value>
        </Setter>
        <Setter Property="Padding" Value="16" />
        <Setter Property="Shadow">
            <Setter.Value>
                <Shadow Brush="#22003366" Offset="0,8" Radius="22" Opacity="0.18" />
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="TrayCompactGlassCard" TargetType="Border" BasedOn="{StaticResource GlassCard}">
        <Setter Property="Padding" Value="{StaticResource TrayCardPadding}" />
        <Setter Property="StrokeShape" Value="RoundRectangle 14" />
    </Style>

    <Style x:Key="TrayDenseGlassCard" TargetType="Border" BasedOn="{StaticResource GlassCard}">
        <Setter Property="Padding" Value="{StaticResource TrayDenseCardPadding}" />
        <Setter Property="StrokeShape" Value="RoundRectangle 12" />
    </Style>

    <!-- Gradient button wrapper Border -->
    <Style x:Key="GradientButtonBorder" TargetType="Border">
        <Setter Property="StrokeShape" Value="RoundRectangle 28" />
        <Setter Property="StrokeThickness" Value="0" />
        <Setter Property="HeightRequest" Value="56" />
        <Setter Property="Background">
            <Setter.Value>
                <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                    <GradientStop Color="{StaticResource PrimaryGradientStart}" Offset="0" />
                    <GradientStop Color="{StaticResource PrimaryGradientMid}" Offset="0.5" />
                    <GradientStop Color="{StaticResource PrimaryGradientEnd}" Offset="1" />
                </LinearGradientBrush>
            </Setter.Value>
        </Setter>
        <Setter Property="Shadow">
            <Setter.Value>
                <Shadow Brush="#60175CFF" Offset="0,8" Radius="18" Opacity="0.4" />
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Transparent overlay button on top of gradient border -->
    <Style x:Key="GradientButtonOverlay" TargetType="Button">
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="TextColor" Value="White" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="HeightRequest" Value="56" />
        <Setter Property="HorizontalOptions" Value="Fill" />
    </Style>

    <Style x:Key="TrayPrimaryActionBorder" TargetType="Border" BasedOn="{StaticResource GradientButtonBorder}">
        <Setter Property="HeightRequest" Value="{StaticResource TrayActionHeight}" />
        <Setter Property="StrokeShape" Value="RoundRectangle 24" />
    </Style>

    <Style x:Key="TrayPrimaryActionOverlay" TargetType="Button" BasedOn="{StaticResource GradientButtonOverlay}">
        <Setter Property="HeightRequest" Value="{StaticResource TrayActionHeight}" />
        <Setter Property="FontSize" Value="14" />
    </Style>

    <Style x:Key="TraySecondaryActionBorder" TargetType="Border">
        <Setter Property="StrokeShape" Value="RoundRectangle 24" />
        <Setter Property="StrokeThickness" Value="1.5" />
        <Setter Property="Stroke" Value="{StaticResource SoftOutline}" />
        <Setter Property="BackgroundColor" Value="{StaticResource GlassSurfaceTop}" />
        <Setter Property="HeightRequest" Value="{StaticResource TrayActionHeight}" />
    </Style>

    <!-- Frosted-glass panel: for larger tinted surfaces (illustration pane, chips) -->
    <Style x:Key="GlassPanel" TargetType="Border">
        <Setter Property="Background">
            <Setter.Value>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="{StaticResource GlassPanelTop}" Offset="0" />
                    <GradientStop Color="{StaticResource GlassPanelBottom}" Offset="1" />
                </LinearGradientBrush>
            </Setter.Value>
        </Setter>
        <Setter Property="StrokeShape" Value="RoundRectangle 24" />
        <Setter Property="StrokeThickness" Value="1.2" />
        <Setter Property="Stroke">
            <Setter.Value>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="{StaticResource GlassBorderStart}" Offset="0" />
                    <GradientStop Color="{StaticResource GlassBorderEnd}" Offset="1" />
                </LinearGradientBrush>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Translucent input row that sits inside a GlassCard -->
    <Style x:Key="GlassInputRow" TargetType="Border">
        <Setter Property="BackgroundColor" Value="{StaticResource GlassRowSurface}" />
        <Setter Property="StrokeShape" Value="RoundRectangle 12" />
        <Setter Property="Stroke">
            <Setter.Value>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="{StaticResource GlassBorderStart}" Offset="0" />
                    <GradientStop Color="{StaticResource GlassBorderEnd}" Offset="1" />
                </LinearGradientBrush>
            </Setter.Value>
        </Setter>
        <Setter Property="StrokeThickness" Value="1" />
        <Setter Property="Padding" Value="12,4" />
    </Style>

    <!-- Outline secondary button -->
    <Style x:Key="OutlineButton" TargetType="Button">
        <Setter Property="BackgroundColor" Value="{StaticResource CardBackground}" />
        <Setter Property="TextColor" Value="{StaticResource Primary}" />
        <Setter Property="BorderColor" Value="{StaticResource Primary}" />
        <Setter Property="BorderWidth" Value="1.5" />
        <Setter Property="CornerRadius" Value="28" />
        <Setter Property="HeightRequest" Value="56" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="FontAttributes" Value="Bold" />
    </Style>

    <Style x:Key="OrangePillButton" TargetType="Button">
        <Setter Property="BackgroundColor" Value="{StaticResource ButtonOrange}" />
        <Setter Property="TextColor" Value="White" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="CornerRadius" Value="24" />
        <Setter Property="HeightRequest" Value="48" />
        <Setter Property="FontSize" Value="14" />
    </Style>

    <!-- Cream pill that wraps the live break timer + coffee glyph -->
    <Style x:Key="BreakTimerPill" TargetType="Border">
        <Setter Property="BackgroundColor" Value="{StaticResource BreakTimerPillFill}" />
        <Setter Property="StrokeShape" Value="RoundRectangle 16" />
        <Setter Property="Stroke" Value="{StaticResource BreakTimerPillStroke}" />
        <Setter Property="StrokeThickness" Value="1" />
        <Setter Property="Padding" Value="8,6,14,6" />
        <Setter Property="HorizontalOptions" Value="End" />
    </Style>

    <!-- Saturated orange→amber End Break CTA (on-break target) -->
    <Style x:Key="OrangeGradientButtonBorder" TargetType="Border">
        <Setter Property="StrokeShape" Value="RoundRectangle 28" />
        <Setter Property="StrokeThickness" Value="0" />
        <Setter Property="HeightRequest" Value="52" />
        <Setter Property="Background">
            <Setter.Value>
                <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                    <GradientStop Color="{StaticResource BreakAccent}" Offset="0" />
                    <GradientStop Color="{StaticResource BreakAccentEnd}" Offset="1" />
                </LinearGradientBrush>
            </Setter.Value>
        </Setter>
        <Setter Property="Shadow">
            <Setter.Value>
                <Shadow Brush="#80FF8A14" Offset="0,8" Radius="18" Opacity="0.45" />
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="RedPillButton" TargetType="Button">
        <Setter Property="BackgroundColor" Value="{StaticResource ButtonRed}" />
        <Setter Property="TextColor" Value="White" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="CornerRadius" Value="24" />
        <Setter Property="HeightRequest" Value="48" />
        <Setter Property="FontSize" Value="14" />
    </Style>

    <!-- Page heading — black portion -->
    <Style x:Key="PageTitle" TargetType="Label">
        <Setter Property="FontSize" Value="26" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="TextColor" Value="{StaticResource TextPrimary}" />
    </Style>

    <!-- Page heading — blue accent portion -->
    <Style x:Key="PageTitleAccent" TargetType="Label">
        <Setter Property="FontSize" Value="26" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="TextColor" Value="{StaticResource Primary}" />
    </Style>

    <!-- Page heading — purple brand portion (Connect welcome line) -->
    <Style x:Key="PageTitleBrand" TargetType="Label">
        <Setter Property="FontSize" Value="26" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="TextColor" Value="{StaticResource BrandTitle}" />
    </Style>

    <!-- Soft rounded square that holds a glyph or a raster icon tile -->
    <Style x:Key="IconTile" TargetType="Border">
        <Setter Property="WidthRequest" Value="36" />
        <Setter Property="HeightRequest" Value="36" />
        <Setter Property="StrokeShape" Value="RoundRectangle 10" />
        <Setter Property="StrokeThickness" Value="0" />
        <Setter Property="BackgroundColor" Value="{StaticResource PrimarySoft}" />
        <Setter Property="VerticalOptions" Value="Center" />
    </Style>

    <!-- Circular icon chip used on the clock-in dashboard (mock uses round tiles) -->
    <Style x:Key="IconTileCircle" TargetType="Border" BasedOn="{StaticResource IconTile}">
        <Setter Property="StrokeShape" Value="RoundRectangle 16" />
        <Setter Property="WidthRequest" Value="32" />
        <Setter Property="HeightRequest" Value="32" />
    </Style>

    <!-- Floating status chip overlaid on the clock-in hero illustration -->
    <Style x:Key="ClockInFloatCard" TargetType="Border" BasedOn="{StaticResource TrayCompactGlassCard}">
        <Setter Property="Padding" Value="10,8" />
        <Setter Property="StrokeShape" Value="RoundRectangle 16" />
        <Setter Property="MinimumWidthRequest" Value="148" />
        <Setter Property="MaximumWidthRequest" Value="200" />
    </Style>

    <!-- Soft outlined secondary action — frosted white pill -->
    <Style x:Key="SoftOutlineButton" TargetType="Button">
        <Setter Property="BackgroundColor" Value="{StaticResource GlassSurfaceTop}" />
        <Setter Property="TextColor" Value="{StaticResource Primary}" />
        <Setter Property="BorderColor" Value="{StaticResource SoftOutline}" />
        <Setter Property="BorderWidth" Value="1.4" />
        <Setter Property="CornerRadius" Value="28" />
        <Setter Property="HeightRequest" Value="56" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="FontAttributes" Value="Bold" />
    </Style>

    <!-- Page subtitle / description -->
    <Style x:Key="PageSubtitle" TargetType="Label">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="TextColor" Value="{StaticResource TextSecondary}" />
        <Setter Property="HorizontalTextAlignment" Value="Center" />
    </Style>

    <!-- Row field label (left column in info cards) -->
    <Style x:Key="FieldLabel" TargetType="Label">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="TextColor" Value="{StaticResource TextSecondary}" />
        <Setter Property="VerticalOptions" Value="Center" />
    </Style>

    <!-- Row field value (right column in info cards) -->
    <Style x:Key="FieldValue" TargetType="Label">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="TextColor" Value="{StaticResource TextPrimary}" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="VerticalOptions" Value="Center" />
    </Style>

    <Style x:Key="FooterLabel" TargetType="Label">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="TextColor" Value="{StaticResource TextMuted}" />
        <Setter Property="VerticalOptions" Value="Center" />
    </Style>

    <Style x:Key="SetupStepTitle" TargetType="Label">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="TextColor" Value="{StaticResource TextPrimary}" />
        <Setter Property="LineBreakMode" Value="TailTruncation" />
        <Setter Property="MaxLines" Value="1" />
    </Style>

    <Style x:Key="SetupStepStatus" TargetType="Label">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="TextColor" Value="{StaticResource TextSecondary}" />
        <Setter Property="LineBreakMode" Value="TailTruncation" />
        <Setter Property="MaxLines" Value="1" />
        <Setter Property="HeightRequest" Value="16" />
    </Style>

    <Style x:Key="SetupResultCard" TargetType="Border">
        <Setter Property="BackgroundColor" Value="{StaticResource CardBackground}" />
        <Setter Property="StrokeShape" Value="RoundRectangle 20" />
        <Setter Property="Stroke" Value="{StaticResource Separator}" />
        <Setter Property="StrokeThickness" Value="1" />
        <Setter Property="Padding" Value="22,20" />
        <Setter Property="Shadow">
            <Setter.Value>
                <Shadow Brush="#1A003366" Offset="0,10" Radius="28" Opacity="0.16" />
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
