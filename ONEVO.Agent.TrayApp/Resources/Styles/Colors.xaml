<?xml version="1.0" encoding="UTF-8" ?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">
    <!-- Brand (official OneXso gradient: cyan -> blue -> purple) -->
    <Color x:Key="Primary">#175CFF</Color>
    <Color x:Key="PrimaryDark">#1247C0</Color>
    <Color x:Key="PrimaryAccent">#6D28D9</Color>
    <Color x:Key="PrimarySoft">#EEF2FF</Color>
    <Color x:Key="PrimaryGradientStart">#22C7F0</Color>
    <Color x:Key="PrimaryGradientMid">#175CFF</Color>
    <Color x:Key="PrimaryGradientEnd">#6D28D9</Color>

    <!-- Text (design-system roles) -->
    <Color x:Key="TextPrimary">#1E1B4B</Color>
    <Color x:Key="TextSecondary">#6B7280</Color>
    <Color x:Key="TextMuted">#9CA3AF</Color>

    <!-- Surfaces — light lavender-white, never pure page white -->
    <Color x:Key="Background">#F8FAFC</Color>
    <Color x:Key="CardBackground">#FFFFFF</Color>
    <Color x:Key="RowBackground">#F8FAFF</Color>
    <Color x:Key="Separator">#E4E9F2</Color>
    <Color x:Key="IllustrationTint">#ECF2FF</Color>

    <!-- Glass surfaces (frosted-glass translucency over Background) -->
    <Color x:Key="GlassSurfaceTop">#E6FFFFFF</Color>
    <Color x:Key="GlassSurfaceBottom">#B3FFFFFF</Color>
    <Color x:Key="GlassPanelTop">#B8FFFFFF</Color>
    <Color x:Key="GlassPanelBottom">#80D6E4FF</Color>
    <Color x:Key="GlassRowSurface">#99FFFFFF</Color>
    <Color x:Key="GlassBorderStart">#CCFFFFFF</Color>
    <Color x:Key="GlassBorderEnd">#26FFFFFF</Color>
    <Color x:Key="GlassGlowPrimary">#8A22C7F0</Color>
    <Color x:Key="GlassGlowAccent">#8A6D28D9</Color>
    <!-- Confirm popups: dim the page, keep the card itself solid white. -->
    <Color x:Key="PopupScrim">#590F1B2D</Color>
    <Color x:Key="PopupCardBackground">#FFFFFFFF</Color>
    <Color x:Key="PopupGlassTint">#FFFFFFFF</Color>
    <Color x:Key="PopupGlassTop">#FFFFFFFF</Color>
    <Color x:Key="PopupGlassBottom">#FFFFFFFF</Color>
    <Color x:Key="PopupClockFill">#EEF2FF</Color>
    <Color x:Key="AccentSoft">#F1E9FE</Color>
    <Color x:Key="BackgroundWashStart">#F8FAFC</Color>
    <Color x:Key="BackgroundWashMid">#F3F0FF</Color>
    <Color x:Key="BackgroundWashEnd">#F5F3FF</Color>
    <Color x:Key="BrandTitle">#6C4DFF</Color>
    <Color x:Key="ConnectButtonStart">#3B82F6</Color>
    <Color x:Key="ConnectButtonMid">#6366F1</Color>
    <Color x:Key="ConnectButtonEnd">#8B5CF6</Color>
    <Color x:Key="SoftOutline">#C7D2FE</Color>
    <Color x:Key="InputStroke">#C5D0E3</Color>

    <!-- Status -->
    <Color x:Key="StatusGreen">#10B981</Color>
    <Color x:Key="StatusGreenSoft">#ECFDF3</Color>
    <Color x:Key="StatusGreenBorder">#BBF7D0</Color>
    <Color x:Key="StatusRed">#EF4444</Color>
    <Color x:Key="StatusOrange">#F97316</Color>
    <Color x:Key="StatusBlue">#2563EB</Color>
    <Color x:Key="ButtonOrange">#F59E0B</Color>
    <Color x:Key="ButtonOrangeEnd">#F97316</Color>
    <Color x:Key="BreakAccent">#FF8A14</Color>
    <Color x:Key="BreakAccentEnd">#FFB020</Color>
    <Color x:Key="BreakTimerPillFill">#FFF3E0</Color>
    <Color x:Key="BreakTimerPillStroke">#FFE2B8</Color>
    <Color x:Key="ButtonRed">#EF4444</Color>
    <Color x:Key="ButtonRedEnd">#DC2626</Color>

    <!-- Legacy compat -->
    <Color x:Key="White">White</Color>
</ResourceDictionary>
